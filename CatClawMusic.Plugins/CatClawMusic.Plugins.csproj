<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CatClawMusic.Plugins</RootNamespace>
    <AssemblyName>CatClawMusic.Plugins.OnlineMusic</AssemblyName>
    <!-- 插件以独立 DLL 交付，不携带依赖（Core 由宿主提供） -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CatClawMusic.Core\CatClawMusic.Core.csproj" />
  </ItemGroup>

</Project>
