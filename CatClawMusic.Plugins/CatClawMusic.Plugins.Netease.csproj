<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CatClawMusic.Plugins.Netease</RootNamespace>
    <AssemblyName>CatClawMusic.Plugins.Netease</AssemblyName>
    <!-- 插件以独立 DLL 交付，不携带依赖（Core 由宿主提供） -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CatClawMusic.Core\CatClawMusic.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 客户端只认 .ccp 插件包：构建后把程序集复制为 .ccp 作为发布产物 -->
    <None Include="$(TargetPath)" Pack="false" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <Target Name="PackageCcp" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(OutDir)CatClawMusic.Plugins.Netease.ccp"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
