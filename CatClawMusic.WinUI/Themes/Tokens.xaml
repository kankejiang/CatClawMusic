<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CatClawMusic.WinUI.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />

    <!--
      语义化视觉令牌 —— 唯一改色入口。
      WinUiThemeService.ApplyTheme() 会原地改写这些 SolidColorBrush 的 Color，页面只引用令牌。

      2026-11-20 换肤：从「樱粉 #F56FA0」切到与 Android 端一致的「墨 + 冷灰蓝」。
      Android 对应值（core/CatClawTheme.kt）：PINK_PRIMARY=#8FA3CC / PINK_LIGHT=#DDE4F2 / PINK_DARK=#9FB4D9
      四个入口色来自 Android SearchDiscoverParts.kt:822-825。
    -->
    <SolidColorBrush x:Key="AccentBrush" Color="#8FA3CC" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="#DDE4F2" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#9FB4D9" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#268FA3CC" />
    <SolidColorBrush x:Key="MintBrush" Color="#7ED8C3" />

    <SolidColorBrush x:Key="QuickBlueBrush" Color="#7C9BE8" />
    <SolidColorBrush x:Key="QuickTealBrush" Color="#5FBEAE" />
    <SolidColorBrush x:Key="QuickVioletBrush" Color="#9A8DD6" />
    <SolidColorBrush x:Key="QuickAmberBrush" Color="#D8AA6A" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#61FFFFFF" />

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundStrongBrush" Color="#14FFFFFF" />

    <SolidColorBrush x:Key="SidebarTintBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PlayerBarBrush" Color="#CC1A1F28" />
    <SolidColorBrush x:Key="PlayerBarBorderBrush" Color="#17FFFFFF" />

    <SolidColorBrush x:Key="DividerBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2EDDE4F2" />

    <Color x:Key="BgStop0">#10141A</Color>
    <Color x:Key="BgStop1">#151A23</Color>
    <Color x:Key="BgStop2">#0E1217</Color>

    <!-- ══════════════ 排版：字号四档 20 / 14 / 10.5 / 9 ══════════════ -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>


    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="GroupCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="130" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="RowTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="RowSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="8.5" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ══════════════ 卡片与控件 ══════════════ -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="13,12" />
    </Style>

    <Style x:Key="HeroCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="MiniPlayerBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PlayerBarBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlayerBarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style x:Key="StatTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="9,8" />
    </Style>

    <Style x:Key="GlassIconStyle" TargetType="Button">
        <Setter Property="Width" Value="29" />
        <Setter Property="Height" Value="29" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PillStyle" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="9" />
    </Style>

    <Style x:Key="PillSolidStyle" TargetType="Button" BasedOn="{StaticResource PillStyle}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#12161C" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 彩色入口：Android LandscapeQuickTile（68dp 高、圆角 17、渐变底由代码刷） -->
    <Style x:Key="QuickTileStyle" TargetType="Button">
        <Setter Property="Height" Value="68" />
        <Setter Property="Padding" Value="9,8" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#29FFFFFF" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <!-- 入口格：图标 + 文字（Android EntryTile），透明底 + 发丝线 -->
    <Style x:Key="EntryTileStyle" TargetType="Button">
        <Setter Property="Padding" Value="0,9" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- 货架分段（歌曲 / 专辑 / 艺人）：选中态是白色 14% 底 -->
    <Style x:Key="ShelfTabStyle" TargetType="Button">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- 文字链接（「查看全部 ›」） -->
    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="RailItemStyle" TargetType="Button">
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>