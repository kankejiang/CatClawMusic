<Window
    x:Class="CatClawMusic.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      桌面壳（2026-11-20 重做，照 Android 端横屏）：
        Grid ColumnDefinitions="133,*"
          左列 = 99px 玻璃竖栏（上下各留 16、圆角 16、居中排 5 项）
          右列 = 顶栏 + 内容 + 整条迷你播放器
      弃用 NavigationView：它的展开面板 244px 是竖屏尺寸，横屏下太占宽，
      而且自带的分组标题/选中态样式与本设计（图标 + 8.5px 标签的玻璃条）完全不同。
    -->
    <Grid x:Name="RootGrid">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource BgStop0}" Offset="0" />
                <GradientStop Color="{StaticResource BgStop1}" Offset="0.54" />
                <GradientStop Color="{StaticResource BgStop2}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 两团冷光晕（Android catClawBackground 的 radial glow）：必须垫在内容下、不接命中测试 -->
        <Border x:Name="GlowPrimary" IsHitTestVisible="False" />
        <Border x:Name="GlowSecondary" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏：整行拖动区，右侧 152 留给系统窗口按钮 -->
            <Grid x:Name="TitleBarRow" Grid.Row="0" Padding="18,0,152,0" Background="Transparent">
                <TextBlock Text="🐾 猫爪音乐" FontSize="11.5" CharacterSpacing="60"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="133,*">

                <!-- ═══ 99px 玻璃侧栏 ═══ -->
                <Border x:Name="Rail" Grid.Column="0"
                        Margin="16,4,0,16" Width="99"
                        CornerRadius="16"
                        Background="{StaticResource SidebarTintBrush}"
                        BorderBrush="{StaticResource SidebarBorderBrush}"
                        BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" Spacing="2" Padding="5,8">
                        <Button x:Name="NavPlay" Tag="playing" Style="{StaticResource RailItemStyle}"
                                Click="OnRailItemClick" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE768;" FontSize="17" HorizontalAlignment="Center" />
                                <TextBlock Text="播放" FontSize="8.5" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavDiscover" Tag="discover" Style="{StaticResource RailItemStyle}"
                                Click="OnRailItemClick" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE80F;" FontSize="17" HorizontalAlignment="Center" />
                                <TextBlock Text="发现" FontSize="8.5" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavPlaylists" Tag="playlists" Style="{StaticResource RailItemStyle}"
                                Click="OnRailItemClick" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE8FD;" FontSize="17" HorizontalAlignment="Center" />
                                <TextBlock Text="歌单" FontSize="8.5" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLibrary" Tag="library" Style="{StaticResource RailItemStyle}"
                                Click="OnRailItemClick" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE8F1;" FontSize="17" HorizontalAlignment="Center" />
                                <TextBlock Text="音乐库" FontSize="8.5" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Tag="settings" Style="{StaticResource RailItemStyle}"
                                Click="OnRailItemClick" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE713;" FontSize="17" HorizontalAlignment="Center" />
                                <TextBlock Text="设置" FontSize="8.5" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ═══ 内容 + 整条播放器 ═══ -->
                <!-- 内容行用 * 撑满：之前写成 Auto，页面只拿到内容自身高度，下方留一整片空 -->
                <Grid Grid.Column="1" RowDefinitions="*,Auto" Padding="0,0,14,0">
                    <ContentControl x:Name="ContentHost" Grid.Row="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />

                    <Border x:Name="MiniPlayer" Grid.Row="1" Height="47" Margin="0,8,0,13"
                            Style="{StaticResource MiniPlayerBarStyle}">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="29" Height="29" CornerRadius="8"
                                    Background="{StaticResource AccentSoftBrush}"
                                    Tapped="OnMiniPlayerTapped">
                                <TextBlock Text="♪" FontSize="11"
                                           Foreground="{StaticResource AccentInkBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"
                                        Background="Transparent" Tapped="OnMiniPlayerTapped">
                                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                           FontSize="9" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextTertiaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       Text="{x:Bind ViewModel.LyricLine, Mode=OneWay}"
                                       FontSize="9" Margin="9,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Tapped="OnMiniPlayerTapped" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}" Click="OnPreviousClick"
                                        ToolTipService.ToolTip="上一首">
                                    <FontIcon Glyph="&#xE892;" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Click="OnTogglePlayClick"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.PlayTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind ViewModel.PlayGlyph, Mode=OneWay}" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Click="OnNextClick"
                                        ToolTipService.ToolTip="下一首">
                                    <FontIcon Glyph="&#xE893;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>