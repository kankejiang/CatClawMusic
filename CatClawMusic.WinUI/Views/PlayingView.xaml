<UserControl
    x:Class="CatClawMusic.WinUI.Views.PlayingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CatClawMusic.WinUI.ViewModels">

    <!--
      播放页（照 Android 端 LandscapeNowPlaying）：
        左 200px 方形封面（圆角 20 + 投影）
        右 标题 / 艺人 / 工具行 / 滚动歌词 / 进度 / 控制行
      歌词仍用 ListView：它是标准控件，XAML 编译器不会像
      ItemsControl + 横向 ItemsPanelTemplate 那样内部崩掉。
    -->
    <Grid ColumnSpacing="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：封面 -->
        <Border Grid.Column="0" Width="200" Height="200" CornerRadius="20"
                VerticalAlignment="Top" Margin="0,4,0,0"
                Background="{StaticResource AccentSoftBrush}">
            <Grid>
                <TextBlock Text="♪" FontSize="52"
                           Foreground="{StaticResource AccentInkBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{x:Bind ViewModel.CoverSource, Mode=OneWay}" Stretch="UniformToFill" />
            </Grid>
        </Border>

        <!-- 右：信息 + 歌词 + 控制 -->
        <Grid Grid.Column="1" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 / 艺人 -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                           FontSize="25" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                           FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>

            <!-- 工具行：歌词 / 桌面歌词 / 收藏 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="9" Margin="0,10,0,0">
                <Button Style="{StaticResource GlassIconStyle}" Click="OnDesktopLyricsClick"
                        ToolTipService.ToolTip="桌面歌词">
                    <FontIcon Glyph="&#xE8A1;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource GlassIconStyle}" Click="OnToggleFavoriteClick"
                        ToolTipService.ToolTip="{x:Bind ViewModel.FavoriteTooltip, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.FavoriteGlyph, Mode=OneWay}" FontSize="13" />
                </Button>
                <Button Style="{StaticResource GlassIconStyle}" Click="OnBackClick"
                        ToolTipService.ToolTip="收起">
                    <FontIcon Glyph="&#xE70D;" FontSize="13" />
                </Button>
            </StackPanel>

            <!-- 滚动歌词：Header/Footer 各撑半屏，让当前行停在中间 -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <ListView x:Name="LyricsList"
                          ItemsSource="{x:Bind ViewModel.LyricLines}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnLyricClick">
                    <ListView.Header>
                        <Border x:Name="LyricsHeaderSpacer" Height="0" />
                    </ListView.Header>
                    <ListView.Footer>
                        <Border x:Name="LyricsFooterSpacer" Height="0" />
                    </ListView.Footer>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LyricLineRow">
                            <StackPanel Padding="0,6" Spacing="2">
                                <TextBlock Text="{x:Bind Text}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Opacity="{x:Bind LineOpacity, Mode=OneWay}"
                                           FontWeight="{x:Bind Weight, Mode=OneWay}"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Translation}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Opacity="0.6"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{x:Bind HasTranslation, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="{x:Bind ViewModel.LyricsPlaceholder, Mode=OneWay}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                           Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>

            <!-- 进度条 -->
            <StackPanel Grid.Row="3" Spacing="2" Margin="0,4,0,0">
                <Slider x:Name="ProgressSlider" Minimum="0" Maximum="1" StepFrequency="0.01"
                        PointerPressed="OnProgressPointerPressed"
                        PointerReleased="OnProgressPointerReleased" />
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}"
                               HorizontalAlignment="Left" FontSize="9"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.DurationText, Mode=OneWay}"
                               HorizontalAlignment="Right" FontSize="9"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </Grid>
            </StackPanel>

            <!-- 控制行 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="18" Margin="0,10,0,0">
                <Button Style="{StaticResource IconButtonStyle}" Click="OnCyclePlayModeClick"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ModeTooltip, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.ModeGlyph, Mode=OneWay}" FontSize="14" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnPreviousClick" ToolTipService.ToolTip="上一首">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>
                <Button Width="41" Height="41" CornerRadius="21" Padding="0" BorderThickness="0"
                        Background="#FFFFFF" Foreground="#12161C"
                        Click="OnTogglePlayClick"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PlayTooltip, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.PlayGlyph, Mode=OneWay}" FontSize="16" Foreground="#12161C" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnNextClick" ToolTipService.ToolTip="下一首">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnTogglePlayClick" ToolTipService.ToolTip="播放 / 暂停">
                    <FontIcon Glyph="&#xE767;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
