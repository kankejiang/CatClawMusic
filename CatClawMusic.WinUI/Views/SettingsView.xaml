<UserControl
    x:Class="CatClawMusic.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="36,8,36,36" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageTitleTextStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="外观" Style="{StaticResource SectionTitleTextStyle}" />
                    <RadioButtons x:Name="DarkModeOptions" SelectionChanged="OnDarkModeChanged">
                        <x:String>跟随系统</x:String>
                        <x:String>浅色</x:String>
                        <x:String>深色</x:String>
                    </RadioButtons>
                    <TextBlock Text="主题色固定为樱粉（与 MAUI 版现行主题一致）；深浅模式即时生效，并会记住选择。"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="数据与日志" Style="{StaticResource SectionTitleTextStyle}" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="数据目录" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock x:Name="DataPathText" Style="{StaticResource BodyTextStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="日志目录" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock x:Name="LogPathText" Style="{StaticResource BodyTextStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>

                    <Button Content="打开数据目录" Click="OnOpenDataFolderClick" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="关于" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Text="Windows 桌面端已迁移到 WinUI 3；Android 端为原生 Kotlin / Compose 实现。"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
