<UserControl
    x:Class="CatClawMusic.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      设置页（照 Android 端 LandscapeSettings）：三列分组卡
        左：外观（深浅模式） + 数据目录
        中：曲库 + 播放
        右：关于 + 诊断
      WinUI 3 运行期不能改 Application.RequestedTheme，只改根元素 RequestedTheme，
      所以这里的「深浅模式」实际由 WinUiThemeService 落到 RootGrid 上。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="设置" Style="{StaticResource PageTitleTextStyle}" />
            <Border Grid.Column="1" Width="1" Height="13" Margin="9,0"
                    Background="{StaticResource DividerBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" x:Name="VersionSubtitle"
                       Style="{StaticResource PageSubtitleTextStyle}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 列 1：外观 + 数据 -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="外观" Style="{StaticResource GroupCaptionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,6,0,0">
                            <Button x:Name="ThemeFollow" Content="跟随系统"
                                    Style="{StaticResource PillStyle}" Click="OnThemeFollowClick" />
                            <Button x:Name="ThemeLight" Content="浅色"
                                    Style="{StaticResource PillStyle}" Click="OnThemeLightClick" />
                            <Button x:Name="ThemeDark" Content="深色"
                                    Style="{StaticResource PillStyle}" Click="OnThemeDarkClick" />
                        </StackPanel>
                        <Border Height="1" Margin="0,12,0,10"
                                Background="{StaticResource DividerBrush}" />
                        <TextBlock Text="启动页" Style="{StaticResource GroupCaptionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,6,0,0">
                            <Button Content="音乐库" Style="{StaticResource PillStyle}" />
                            <Button Content="发现" Style="{StaticResource PillStyle}" />
                            <Button Content="播放" Style="{StaticResource PillStyle}" />
                        </StackPanel>
                        <TextBlock Text="深色下播放页固定暗色，避免亮封面把白字冲淡。"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="数据与日志" Style="{StaticResource GroupCaptionTextStyle}" />
                        <StackPanel Spacing="2" Margin="0,6,0,0">
                            <TextBlock Text="数据目录" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="DataPathText" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="2" Margin="0,6,0,0">
                            <TextBlock Text="日志目录" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="LogPathText" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,10,0,0">
                            <Button Content="打开数据目录" Style="{StaticResource PillStyle}" Click="OnOpenDataFolderClick" />
                            <Button Content="打开日志" Style="{StaticResource PillStyle}" Click="OnOpenLogFolderClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 列 2：曲库 + 播放 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel x:Name="PrefsList" Spacing="0" />
            </Border>

            <!-- 列 3：关于 + 诊断 -->
            <Grid Grid.Column="2" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="关于" Style="{StaticResource GroupCaptionTextStyle}" />
                        <TextBlock x:Name="VersionText" FontSize="12.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Windows 桌面端已迁移到 WinUI 3；Android 端为原生 Kotlin / Compose 实现。"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,10,0,0">
                            <Button Content="开源许可" Style="{StaticResource PillStyle}" />
                            <Button Content="检查更新" Style="{StaticResource PillStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel x:Name="DiagnosticsList" Spacing="0" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
