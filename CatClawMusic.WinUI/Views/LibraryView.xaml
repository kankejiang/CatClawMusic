<UserControl
    x:Class="CatClawMusic.WinUI.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CatClawMusic.WinUI.ViewModels">

    <Grid Padding="36,8,36,20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 工具条 -->
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="音乐库" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center" />

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="1"
                            Width="300"
                            QueryIcon="Find"
                            PlaceholderText="搜索歌曲 / 歌手 / 专辑"
                            TextChanged="OnSearchTextChanged" />

            <Button Grid.Column="2" Content="选择文件夹" Click="OnPickFolderClick" />
            <Button Grid.Column="3" Content="重新扫描" Click="OnRescanClick" />
        </Grid>

        <!-- 分类标签 + 筛选条件 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <SelectorBar x:Name="LibraryTabs" SelectionChanged="OnTabSelectionChanged">
                <SelectorBarItem Text="歌曲" Tag="songs" IsSelected="True" />
                <SelectorBarItem Text="歌手" Tag="artists" />
                <SelectorBarItem Text="专辑" Tag="albums" />
            </SelectorBar>

            <Border x:Name="FilterChip"
                    Visibility="Collapsed"
                    Background="{StaticResource AccentSoftBrush}"
                    CornerRadius="12"
                    Padding="10,4"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="FilterChipText" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                    <Button Content="✕"
                            FontSize="10"
                            Padding="4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnClearFilterClick" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 状态 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" />
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!-- 内容 -->
        <Grid Grid.Row="3">
            <ListView x:Name="SongsList"
                      ItemsSource="{x:Bind ViewModel.Songs}"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnSongClick"
                      RightTapped="OnSongRightTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SongRow">
                        <Grid ColumnSpacing="12" Padding="2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                                <TextBlock Text="{x:Bind Badge}"
                                           FontSize="15"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Title}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Subtitle}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind DurationText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="ArtistsList"
                      Visibility="Collapsed"
                      ItemsSource="{x:Bind ViewModel.Artists}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnArtistClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArtistRow">
                        <Grid Padding="2,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind CountText}" Style="{StaticResource CaptionTextStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="AlbumsList"
                      Visibility="Collapsed"
                      ItemsSource="{x:Bind ViewModel.Albums}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnAlbumClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlbumRow">
                        <Grid Padding="2,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        Spacing="8"
                        MaxWidth="560"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock Text="曲库还是空的" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="点右上角「选择文件夹」挑一个音乐目录，扫描结果会写进本地曲库（支持 mp3 / flac / m4a / wav / ape 等）。"
                           Style="{StaticResource BodyTextStyle}" />
                <TextBlock x:Name="FoldersText" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
