<UserControl
    x:Class="CatClawMusic.WinUI.Views.DiscoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CatClawMusic.WinUI.ViewModels">

    <!--
      Discover page (mirrors Android LandscapeDiscover):
        top    : title | greeting  ......  search / stats
        body   : left 38% hero card  /  right 5 colored tiles + shelf panel (songs/albums/artists)
        bottom : weekly top 5
      Shelves use ItemsControl + horizontal StackPanel instead of GridView: the custom
      GridView.ItemsPanel trips the XAML compiler in this SDK, and 5-10 cards need no virtualization.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="发现" Style="{StaticResource PageTitleTextStyle}" />
            <Border Grid.Column="1" Width="1" Height="13" Margin="9,0"
                    Background="{StaticResource DividerBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
                       Style="{StaticResource PageSubtitleTextStyle}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource GlassIconStyle}" Click="OnSearchClick" ToolTipService.ToolTip="搜索">
                    <FontIcon Glyph="&#xE721;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource GlassIconStyle}" Click="OnStatsClick" ToolTipService.ToolTip="听歌统计">
                    <FontIcon Glyph="&#xE9D2;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- body -->
        <Grid Grid.Row="1" ColumnSpacing="13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38*" />
                <ColumnDefinition Width="62*" />
            </Grid.ColumnDefinitions>

            <!-- left: hero -->
            <Border Grid.Column="0" CornerRadius="22" Background="{StaticResource AccentSoftBrush}">
                <Grid>
                    <Image x:Name="HeroCover" Stretch="UniformToFill" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.15,1" EndPoint="0.85,0">
                                <GradientStop Color="#F206080C" Offset="0" />
                                <GradientStop Color="#5206080C" Offset="0.46" />
                                <GradientStop Color="#0006080C" Offset="0.74" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13"
                            Padding="10,4" CornerRadius="12"
                            Background="#29FFFFFF" BorderBrush="#42FFFFFF" BorderThickness="1">
                        <TextBlock Text="根据口味生成" FontSize="8.5" Foreground="#FFFFFF" />
                    </Border>
                    <StackPanel x:Name="HeroBlock" VerticalAlignment="Bottom" Margin="15" Spacing="3">
                        <TextBlock Text="每日推荐" FontSize="8" CharacterSpacing="120" Foreground="#99FFFFFF" />
                        <TextBlock x:Name="HeroTitle" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="HeroArtist" FontSize="9" Foreground="#B3FFFFFF"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Content="播放全部" Style="{StaticResource PillSolidStyle}" Click="OnPlayHeroClick" />
                            <Button Content="换一批" Style="{StaticResource PillStyle}"
                                    Foreground="#FFFFFF" Click="OnRefreshHeroClick" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="EmptyHint" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="10" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="220" Foreground="#CCFFFFFF" />
                </Grid>
            </Border>

            <!-- right: tiles + shelf -->
            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- five colored tiles -->
                <Grid Grid.Row="0" ColumnSpacing="7" Height="68">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="TileAi" Grid.Column="0" Style="{StaticResource QuickTileStyle}" Click="OnAiClick">
                        <Grid>
                            <Border Width="22" Height="22" CornerRadius="7" HorizontalAlignment="Left"
                                    VerticalAlignment="Top" Background="#2BFFFFFF">
                                <FontIcon Glyph="&#xE734;" FontSize="12" Foreground="#FFFFFF" />
                            </Border>
                            <TextBlock Text="AI 助手" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <Button x:Name="TileShuffle" Grid.Column="1" Style="{StaticResource QuickTileStyle}" Click="OnShuffleClick">
                        <Grid>
                            <Border Width="22" Height="22" CornerRadius="7" HorizontalAlignment="Left"
                                    VerticalAlignment="Top" Background="#2BFFFFFF">
                                <FontIcon Glyph="&#xE8B1;" FontSize="12" Foreground="#FFFFFF" />
                            </Border>
                            <TextBlock Text="随机播放" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <Button x:Name="TileFm" Grid.Column="2" Style="{StaticResource QuickTileStyle}" Click="OnPrivateFmClick">
                        <Grid>
                            <Border Width="22" Height="22" CornerRadius="7" HorizontalAlignment="Left"
                                    VerticalAlignment="Top" Background="#2BFFFFFF">
                                <FontIcon Glyph="&#xE716;" FontSize="12" Foreground="#FFFFFF" />
                            </Border>
                            <TextBlock Text="私人 FM" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <Button x:Name="TileTop" Grid.Column="3" Style="{StaticResource QuickTileStyle}" Click="OnTopClick">
                        <Grid>
                            <Border Width="22" Height="22" CornerRadius="7" HorizontalAlignment="Left"
                                    VerticalAlignment="Top" Background="#2BFFFFFF">
                                <FontIcon Glyph="&#xE9D2;" FontSize="12" Foreground="#FFFFFF" />
                            </Border>
                            <TextBlock Text="最多播放" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <Button x:Name="TileFavorite" Grid.Column="4" Style="{StaticResource QuickTileStyle}" Click="OnFavoriteClick">
                        <Grid>
                            <Border Width="22" Height="22" CornerRadius="7" HorizontalAlignment="Left"
                                    VerticalAlignment="Top" Background="#2BFFFFFF">
                                <FontIcon Glyph="&#xEB51;" FontSize="12" Foreground="#FFFFFF" />
                            </Border>
                            <TextBlock Text="我的最爱" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- shelf panel -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="10,9,10,10">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="TabSongs" Content="歌曲" Tag="0"
                                        Style="{StaticResource ShelfTabStyle}" Click="OnShelfTabClick" />
                                <Button x:Name="TabAlbums" Content="专辑" Tag="1"
                                        Style="{StaticResource ShelfTabStyle}" Click="OnShelfTabClick" />
                                <Button x:Name="TabArtists" Content="艺人" Tag="2"
                                        Style="{StaticResource ShelfTabStyle}" Click="OnShelfTabClick" />
                            </StackPanel>
                            <Button Content="查看全部 ›" HorizontalAlignment="Right"
                                    Style="{StaticResource LinkButtonStyle}" Click="OnSeeAllClick" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="SongsShelf" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ScrollViewer>

                            <ScrollViewer x:Name="AlbumsShelf" Visibility="Collapsed" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ScrollViewer>

                            <ScrollViewer x:Name="ArtistsShelf" Visibility="Collapsed" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- bottom: weekly top 5 -->
        <!-- MinHeight：没有歌时右侧是空条，面板会塌成一条，圆角看起来像被裁掉 -->
        <Border Grid.Row="2" MinHeight="58" Margin="0,10,0,2" Style="{StaticResource CardBorderStyle}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="本周精选" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="播放次数 Top 5" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
                <StackPanel x:Name="TopSongsStrip" Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
