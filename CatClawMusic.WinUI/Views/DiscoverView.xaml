<UserControl
    x:Class="CatClawMusic.WinUI.Views.DiscoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="36,8,36,36" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="发现" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="在线音源、排行榜与歌手资料都从这里开始。"
                       Style="{StaticResource BodyTextStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="🐾 和 Yuki 聊聊" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="AI 助手入口，接入后可以直接让它找歌、建歌单、控制播放。"
                               Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="还没有在线音源" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="宿主本身不带音源。安装 .ccp 音源插件后，推荐、排行榜与聚合搜索会出现在这里。"
                               Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Text="插件管理与聚合搜索将在后续阶段接入。"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
