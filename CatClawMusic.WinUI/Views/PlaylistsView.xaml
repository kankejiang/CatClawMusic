<UserControl
    x:Class="CatClawMusic.WinUI.Views.PlaylistsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CatClawMusic.WinUI.ViewModels">

    <Grid Padding="36,8,36,20" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：歌单列表 -->
        <Grid Grid.Column="0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="歌单" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="＋ 新建" Click="OnCreateClick" />
            </Grid>

            <ListView x:Name="PlaylistsList"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Playlists}"
                      SelectedItem="{x:Bind ViewModel.SelectedPlaylist, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistRow">
                        <Grid Padding="2,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind CountText}" Style="{StaticResource CaptionTextStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 右：选中歌单内容 -->
        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}"
                           Style="{StaticResource PageTitleTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Button Content="播放全部" Click="OnPlayAllClick" />
                <Button x:Name="RenameButton" Content="重命名" Click="OnRenameClick" />
                <Button x:Name="DeleteButton" Content="删除" Click="OnDeleteClick" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ListView x:Name="SongsList"
                          ItemsSource="{x:Bind ViewModel.Songs}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="OnSongClick"
                          RightTapped="OnSongRightTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SongRow">
                            <Grid ColumnSpacing="12" Padding="2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                                    <TextBlock Text="{x:Bind Badge}"
                                               FontSize="15"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind DurationText}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="6" MaxWidth="520"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Text="这个歌单还没有歌" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="EmptyHint"
                               Text="到音乐库里右键一首歌 →「添加到歌单」，或者先新建一个歌单。"
                               Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
