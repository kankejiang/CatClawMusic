<UserControl
    x:Class="CatClawMusic.WinUI.Views.PlaylistsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CatClawMusic.WinUI.ViewModels">

    <!--
      歌单页（照 Android 端 LandscapePlaylists）：
        顶栏：我的歌单 │ 说明 ………………………………………… ＋新建
        左 38%：摘要大卡（歌单数 + 收藏 / 最近播放 两块彩色入口）
        右 62%：自建歌单列表 + 选中歌单的歌曲
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="我的歌单" Style="{StaticResource PageTitleTextStyle}" />
            <Border Grid.Column="1" Width="1" Height="13" Margin="9,0"
                    Background="{StaticResource DividerBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="收藏、最近播放与自建歌单，一处管理你的音乐集合。"
                       Style="{StaticResource PageSubtitleTextStyle}" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="3" Style="{StaticResource GlassIconStyle}" Click="OnCreateClick"
                    ToolTipService.ToolTip="新建歌单">
                <FontIcon Glyph="&#xE710;" FontSize="13" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38*" />
                <ColumnDefinition Width="62*" />
            </Grid.ColumnDefinitions>

            <!-- 左：摘要大卡 -->
            <Border Grid.Column="0" CornerRadius="22" Background="{StaticResource AccentSoftBrush}">
                <Grid>
                    <!-- 右上角巨型音符水印 -->
                    <FontIcon Glyph="&#xE8D6;" FontSize="96" Opacity="0.11"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,18,10,0"
                              Foreground="{StaticResource TextPrimaryBrush}" />

                    <StackPanel VerticalAlignment="Bottom" Margin="16" Spacing="4">
                        <TextBlock Text="我的歌单" FontSize="8.5" CharacterSpacing="110"
                                   Foreground="#99FFFFFF" />
                        <TextBlock x:Name="PlaylistCountText" Text="0" FontSize="34" FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                        <TextBlock x:Name="PlaylistSummaryText" Text="自建歌单 · 收藏 0 首" FontSize="9"
                                   Foreground="#B3FFFFFF" />

                        <Grid ColumnSpacing="8" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource QuickTileStyle}" Height="34"
                                    Click="OnFavoritesClick">
                                <FontIcon Glyph="&#xEB51;" FontSize="12" Foreground="#FFFFFF" />
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource QuickTileStyle}" Height="34"
                                    Click="OnRecentClick">
                                <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="#FFFFFF" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：歌单列表 + 选中歌单 -->
            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="自建歌单" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock x:Name="PlaylistTotalText" HorizontalAlignment="Right"
                                       Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Row="1" x:Name="PlaylistList" Spacing="0" Margin="0,6,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock x:Name="SelectedNameText" Text="未选择歌单"
                                       Style="{StaticResource SectionTitleTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="PlayAllButton" Content="播放全部"
                                        Style="{StaticResource PillSolidStyle}" Click="OnPlayAllClick" />
                                <Button x:Name="RenameButton" Content="重命名"
                                        Style="{StaticResource PillStyle}" Click="OnRenameClick" />
                                <Button x:Name="DeleteButton" Content="删除"
                                        Style="{StaticResource PillStyle}" Click="OnDeleteClick" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="SongsScroller" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SongsList" Spacing="0" />
                            </ScrollViewer>

                            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="EmptyTitle" Text="还没有歌单"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="EmptyHint"
                                           Text="点右上角「＋」创建一个歌单，再从音乐库里把歌加进来。"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           MaxWidth="300" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
