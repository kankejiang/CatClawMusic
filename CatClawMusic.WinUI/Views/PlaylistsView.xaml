<UserControl
    x:Class="CatClawMusic.WinUI.Views.PlaylistsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="36,8,36,36" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="歌单" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="自己整理的歌单与系统歌单（收藏、播放历史）都在这里。"
                       Style="{StaticResource BodyTextStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="还没有歌单" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="新建、重命名、拖拽排序与批量加歌随曲库功能一起接入。"
                               Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
