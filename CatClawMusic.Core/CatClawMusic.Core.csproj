<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <!-- 覆盖 SQLitePCLRaw 2.1.2 传递依赖，锁定 16KB 对齐版本（Android 16 兼容） -->
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <!-- JS 运行时（宿主统一持有，插件不再各自嵌入）：供 IJsRuntimeService 与插件脚本引擎共用，
         版本必须与插件编译引用保持一致（插件经 ProjectReference 传递统一） -->
    <PackageReference Include="Jint" Version="4.16.0" />
    <PackageReference Include="Acornima" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 猫爪家族共享库（与 CatClawVideo 共用）：JsRuntimeServiceBase 等纯 C# 共享实现。
         插件 SDK 接口（IJsRuntimeService 等）仍保留在本项目 Interfaces/ 内，不下沉。 -->
    <ProjectReference Include="..\..\CatClaw.Shared\src\CatClaw.Shared.Core\CatClaw.Shared.Core.csproj" />
  </ItemGroup>
</Project>
