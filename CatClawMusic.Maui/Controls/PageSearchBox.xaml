<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawMusic.Maui.Controls.PageSearchBox">

    <Border x:Name="SearchBorder"
            Padding="11,0,14,0"
            StrokeShape="RoundRectangle 14"
            StrokeThickness="1"
            Stroke="{DynamicResource GlassStrokeColor}"
            BackgroundColor="{DynamicResource CardBackgroundStrongColor}">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="0"
              VerticalOptions="Center">
            <Image Source="ic_search.svg"
                   WidthRequest="16" HeightRequest="16"
                   VerticalOptions="Center" />
            <Entry x:Name="SearchEntry"
                   Grid.Column="1"
                   FontSize="14"
                   TextColor="{DynamicResource TextPrimaryColor}"
                   PlaceholderColor="{DynamicResource TextHintColor}"
                   VerticalOptions="Center"
                   Margin="10,0,0,0" />
        </Grid>
    </Border>
</ContentView>
