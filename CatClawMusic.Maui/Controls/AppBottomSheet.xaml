<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawMusic.Maui.Controls.AppBottomSheet"
             InputTransparent="False"
             HorizontalOptions="Fill"
             VerticalOptions="Fill"
             IsVisible="False"
             Opacity="0">
    <Grid x:Name="RootGrid"
          InputTransparent="False"
          BackgroundColor="Transparent">
        <BoxView x:Name="MaskLayer"
                 Color="#66000000"
                 InputTransparent="False"
                 Opacity="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMaskTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="SheetCard"
                BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                Stroke="{DynamicResource GlassStrokeStrongColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22,22,0,0"
                Padding="16,10,16,16"
                HorizontalOptions="Fill"
                VerticalOptions="End"
                Margin="8,0,8,8"
                TranslationY="600"
                Opacity="0"
                InputTransparent="False">
            <Border.Shadow>
                <Shadow Brush="Black"
                        Radius="30"
                        Offset="0,-8"
                        Opacity="0.5" />
            </Border.Shadow>
            <Grid x:Name="SheetGrid" RowDefinitions="Auto,*">
                <!-- 抓握区：顶部 32 DIP 透明区，内嵌半透明圆角小条，支持下滑拖拽关闭（对齐长按菜单抽屉） -->
                <Grid Grid.Row="0"
                      HeightRequest="32"
                      BackgroundColor="Transparent"
                      VerticalOptions="Start">
                    <BoxView x:Name="GripBar"
                             WidthRequest="36" HeightRequest="4"
                             CornerRadius="2"
                             Color="#50000000"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnGripPan" />
                    </Grid.GestureRecognizers>
                </Grid>
                <ScrollView Grid.Row="1"
                            x:Name="ContentScroll"
                            VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="SheetContent" Spacing="0"
                                         x:FieldModifier="public" />
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</ContentView>
