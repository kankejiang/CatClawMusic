<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全面屏主题：状态栏和导航栏透明，内容延伸到系统栏下方 -->
    <style name="MainTheme" parent="Maui.SplashTheme">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="MainTheme.Base" parent="MainTheme" />

    <!-- 启动画面主题：在 Maui.SplashTheme 基础上替换为"旋转黑胶 + 猫爪"动态图标（AVD），
         并在底部加品牌字样。仅覆盖系统启动画面（Android 12+）属性，windowBackground 等沿用父主题 -->
    <style name="CatSplashTheme" parent="Maui.SplashTheme">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
    </style>
</resources>
