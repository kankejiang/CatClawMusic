<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawMusic.Maui.Pages.SplashLoadingPage"
             BackgroundColor="{DynamicResource WindowBackgroundColor}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid>
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="24">
            <!-- 可爱的中英文标题 -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="🐾 猫爪音乐"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       HorizontalOptions="Center" />
                <Label Text="CatClaw Music"
                       FontSize="16"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       HorizontalOptions="Center" />
                <Label Text="正在为你准备音乐喵～"
                       FontSize="13"
                       TextColor="{DynamicResource TextHintColor}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- 加载指示：关键服务初始化完成后由 App 移除本页 -->
            <ActivityIndicator IsRunning="True"
                               Color="{DynamicResource PrimaryColor}"
                               WidthRequest="34"
                               HeightRequest="34"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
