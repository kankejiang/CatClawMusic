<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawMusic.Maui.Pages.AgentBrowserPage"
             Title="AI 浏览器"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource PageBackgroundBrush}">

        <!-- 顶部栏：返回 + 标题 + 加载状态 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="12,10,12,8" ColumnSpacing="12">
            <Border Style="{StaticResource GlassIconContainerStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Border.GestureRecognizers>
                <Label Text="‹" FontSize="26" TextColor="{DynamicResource TextPrimaryColor}"
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-4,0,0" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="AI 浏览器" FontSize="17" FontFamily="OpenSansSemibold"
                       TextColor="{DynamicResource TextPrimaryColor}" />
                <Label x:Name="StatusHint" Text="Yuki 正在浏览网页..." FontSize="11"
                       TextColor="{DynamicResource TextHintColor}" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="2" x:Name="LoadingIndicator" IsRunning="True"
                               Color="{DynamicResource PrimaryColor}" WidthRequest="18" HeightRequest="18" />
        </Grid>

        <!-- WebView：Agent 控制的浏览器（页面加载后自动提取正文回传） -->
        <WebView x:Name="BrowserWebView"
                 Grid.Row="1"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 Navigated="OnWebViewNavigated" />
    </Grid>
</ContentPage>
