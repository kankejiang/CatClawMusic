<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:helpers="clr-namespace:CatClawMusic.Maui.Helpers"
             x:Class="CatClawMusic.Maui.Pages.DesktopPlaylistView"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabPlaylists]}"
             BackgroundColor="Transparent">

    <Grid Background="Transparent">

        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- Hero Card（横屏下收紧边距） -->
            <Border Grid.Row="0"
                    Margin="16,12,16,6"
                    Style="{StaticResource GlassCardStrongStyle}"
                    Background="{DynamicResource HeroBrush}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabPlaylists]}"
                               Style="{StaticResource PageTitleStyle}"
                               TextColor="White" />
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[PlaylistSubtitle]}"
                               Style="{StaticResource PageSubtitleStyle}"
                               TextColor="#F2F4FF" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            Style="{StaticResource GlassIconContainerStyle}"
                            BackgroundColor="#26FFFFFF"
                            Stroke="{DynamicResource GlassStrokeColor}"
                            VerticalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreatePlaylistClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="{helpers:ThemedIcon Name=ic_add, Original=True}"
                               WidthRequest="22" HeightRequest="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 快速入口卡片：我喜欢的 + 最近播放 ═══ -->
            <Grid Grid.Row="1" Margin="16,4,16,4" ColumnDefinitions="*,*" ColumnSpacing="12">

                <!-- 我喜欢的 -->
                <Border Grid.Column="0" Padding="14"
                        StrokeShape="RoundRectangle 18"
                        Stroke="{DynamicResource GlassStrokeColor}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource CardOverlayColor}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFavoriteCardTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" WidthRequest="46" HeightRequest="46"
                                StrokeShape="RoundRectangle 14" StrokeThickness="0">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="1,1">
                                    <GradientStop Color="#FF5C8A" Offset="0" />
                                    <GradientStop Color="#FF7AAE" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image Source="{helpers:ThemedIcon Name=ic_favorite, Original=True}" WidthRequest="22" HeightRequest="22"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                            <Label Text="我喜欢的" FontSize="14" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}" />
                            <Label FontSize="11.5" TextColor="{DynamicResource TextHintColor}"
                                   Text="{Binding FavoriteSongCount, StringFormat='{0} 首 · 收藏歌单'}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 最近播放 -->
                <Border Grid.Column="1" Padding="14"
                        StrokeShape="RoundRectangle 18"
                        Stroke="{DynamicResource GlassStrokeColor}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource CardOverlayColor}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRecentCardTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" WidthRequest="46" HeightRequest="46"
                                StrokeShape="RoundRectangle 14" StrokeThickness="0">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="1,1">
                                    <GradientStop Color="#7A6CF0" Offset="0" />
                                    <GradientStop Color="#A78BFA" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image Source="{helpers:ThemedIcon Name=ic_history, Original=True}" WidthRequest="22" HeightRequest="22"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                            <Label Text="最近播放" FontSize="14" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}" />
                            <Label FontSize="11.5" TextColor="{DynamicResource TextHintColor}"
                                   Text="{Binding RecentSongCount, StringFormat='{0} 首 · 播放记录'}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status -->
            <Label Grid.Row="2"
                   Text="{Binding StatusText}"
                   FontSize="12"
                   TextColor="{DynamicResource TextHintColor}"
                   HorizontalOptions="Center"
                   Margin="0,4,0,6"
                   IsVisible="{Binding IsLoading}" />

            <!-- Playlist List（横屏双列 + AllSongs 紧凑风格） -->
            <CollectionView x:Name="PlaylistsList"
                            Grid.Row="3"
                            ItemsSource="{Binding Playlists}"
                            SelectionMode="Single"
                            SelectionChanged="OnPlaylistSelected"
                            Margin="8,0,8,8">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="12"
                                     VerticalItemSpacing="4" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,7" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <!-- 封面 -->
                            <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                    StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                    BackgroundColor="{DynamicResource InputBackgroundColor}">
                                <Grid>
                                    <Image Source="{Binding CoverPath}" Aspect="AspectFill"
                                           WidthRequest="42" HeightRequest="42"
                                           IsVisible="{Binding CoverPath, Converter={StaticResource StringToBoolConverter}}" />
                                    <Label Text="{Binding Name, Converter={StaticResource PlaylistIconConverter}}"
                                           FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"
                                           IsVisible="{Binding CoverPath, Converter={StaticResource InvertedStringToBoolConverter}}" />
                                </Grid>
                            </Border>

                            <!-- 歌单名 + 数量 -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label Text="{Binding SongCount, StringFormat='{0} 首歌曲'}"
                                       FontSize="11.5" TextColor="{DynamicResource TextHintColor}" />
                            </VerticalStackLayout>

                            <!-- 更多按钮 -->
                            <Label Grid.Column="2" Text="⋮" FontSize="16" VerticalOptions="Center"
                                   TextColor="{DynamicResource TextHintColor}" Padding="4,0"
                                   IsVisible="{Binding IsSystem, Converter={StaticResource InvertedBoolConverter}}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPlaylistMoreTapped" CommandParameter="{Binding}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- 新建歌单输入弹窗 -->
        <controls:AppPopup x:Name="CreatePlaylistPopup"
                           Title="新建歌单"
                           CloseOnMaskTapped="True" />
    </Grid>
</ContentPage>
