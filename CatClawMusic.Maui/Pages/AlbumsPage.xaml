<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CatClawMusic.Maui.ViewModels"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             xmlns:helpers="clr-namespace:CatClawMusic.Maui.Helpers"
             xmlns:data="clr-namespace:CatClawMusic.Data;assembly=CatClawMusic.Data"
             x:Class="CatClawMusic.Maui.Pages.AlbumsPage"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabAlbums]}"
             BackgroundColor="{DynamicResource WindowBackgroundColor}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
          Background="{DynamicResource PageBackgroundBrush}">

        <!-- ═══ 顶栏 ═══ -->
        <Grid Grid.Row="0" Padding="16,12,16,8" ColumnDefinitions="Auto,*,Auto">
            <!-- 返回按钮 -->
            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                    Stroke="{DynamicResource GlassStrokeColor}"
                    StrokeThickness="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Image Source="{helpers:ThemedIcon Name=ic_arrow_left}"
                       WidthRequest="18" HeightRequest="18"
                       Aspect="AspectFit"
                       VerticalOptions="Center" HorizontalOptions="Center" />
            </Border>

            <!-- 标题 + 统计 -->
            <VerticalStackLayout Grid.Column="1" Margin="14,0,0,0" VerticalOptions="Center">
                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabAlbums]}"
                       FontSize="19" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimaryColor}" />
                <Label Text="{Binding TotalAlbums, StringFormat='{0} 张专辑'}"
                       FontSize="12"
                       TextColor="{DynamicResource TextHintColor}" />
            </VerticalStackLayout>

            <!-- 视图切换 -->
            <controls:ViewToggleButton Grid.Column="2"
                                       IsGridView="{Binding IsGridView, Mode=TwoWay}" />
        </Grid>

        <!-- ═══ 搜索栏 ═══ -->
        <controls:PageSearchBox Grid.Row="1"
                                Margin="16,4,16,10"
                                CornerRadius="14"
                                FontSize="14"
                                Placeholder="搜索专辑或艺术家"
                                SearchQuery="{Binding SearchQuery, Mode=TwoWay}" />

        <!-- ═══ 来源筛选 + 排序 ═══ -->
        <Grid Grid.Row="2" Padding="16,4,16,8" ColumnDefinitions="*,*"
              ColumnSpacing="10">
            <!-- 来源筛选 -->
            <controls:ChipList Grid.Column="0"
                               Orientation="Horizontal"
                               ItemsSource="{Binding SourceFilters}"
                               ChipTapped="OnFilterChipTapped"
                               ChipPadding="13,7"
                               ChipCornerRadius="20"
                               ChipFontSize="12.5" />

            <!-- 排序 -->
            <controls:ChipList Grid.Column="1"
                               Orientation="Horizontal"
                               HorizontalOptions="End"
                               ItemsSource="{Binding SortOptions}"
                               ChipTapped="OnSortChipTapped"
                               ChipPadding="13,7"
                               ChipCornerRadius="20"
                               ChipFontSize="12.5" />
        </Grid>

        <!-- ═══ 主体布局：列表/网格 + 右侧字母 rail ═══ -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="0,0,0,8" ColumnSpacing="0">

            <!-- 网格视图 -->
            <CollectionView ItemsUpdatingScrollMode="KeepScrollOffset" Grid.Column="0"
                            x:Name="GridCollectionView"
                            ItemsSource="{Binding FilteredAlbums}"
                            SelectionMode="None"
                            IsVisible="{Binding IsGridView}"
                            Margin="8,4,0,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:AlbumWithCount">
                        <Border StrokeThickness="0"
                                BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAlbumTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Border StrokeShape="RoundRectangle 18"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding Id, Converter={StaticResource PlaceholderColorConverter}}">
                                    <Grid>
                                        <Image Source="{Binding CoverArtPath}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}}" />
                                        <Label Text="{Binding Title, Converter={StaticResource InitialConverter}}"
                                               FontSize="30"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="#DDFFFFFF"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}, ConverterParameter=invert}" />
                                    </Grid>
                                </Border>
                                <Label Text="{Binding Title}"
                                       FontSize="12.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       HorizontalOptions="Center"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Text="{Binding ArtistName}"
                                       FontSize="10.5"
                                       TextColor="{DynamicResource TextHintColor}"
                                       HorizontalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="没有匹配的专辑" FontSize="13"
                           TextColor="{DynamicResource TextHintColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,40" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- 列表视图（与 AllSongsPage 样式一致） -->
            <CollectionView ItemsUpdatingScrollMode="KeepScrollOffset" Grid.Column="0"
                            x:Name="ListCollectionView"
                            ItemsSource="{Binding FilteredAlbums}"
                            SelectionMode="None"
                            IsVisible="{Binding IsGridView, Converter={StaticResource InvertedBoolConverter}}"
                            Margin="0,4,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:AlbumWithCount">
                        <Grid Padding="14,9" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <!-- 封面 -->
                            <Border Grid.Column="0" WidthRequest="46" HeightRequest="46"
                                    StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                    BackgroundColor="{Binding Id, Converter={StaticResource PlaceholderColorConverter}}">
                                <Grid>
                                    <Image Source="{Binding CoverArtPath}"
                                           Aspect="AspectFill"
                                           IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}}" />
                                    <Label Text="{Binding Title, Converter={StaticResource InitialConverter}}"
                                           FontSize="18"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="#DDFFFFFF"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}, ConverterParameter=invert}" />
                                </Grid>
                            </Border>

                            <!-- 标题 + 艺术家·歌曲数 -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Title}" FontSize="14.5" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label FontSize="12" LineBreakMode="TailTruncation" MaxLines="1"
                                       TextColor="{DynamicResource TextHintColor}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} · {1} 首">
                                            <Binding Path="ArtistName" />
                                            <Binding Path="SongCount" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>

                            <!-- 年份 -->
                            <Label Grid.Column="2" FontSize="12" VerticalOptions="Center"
                                   TextColor="{DynamicResource TextHintColor}"
                                   Text="{Binding Year}" />

                            <!-- 更多按钮 -->
                            <Label Grid.Column="3" Text="⋮" FontSize="18" VerticalOptions="Center"
                                   TextColor="{DynamicResource TextHintColor}"
                                   Padding="6,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAlbumMoreTapped" CommandParameter="{Binding}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="没有匹配的专辑" FontSize="13"
                           TextColor="{DynamicResource TextHintColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,40" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- 字母 rail（A-Z 索引） -->
            <ScrollView Grid.Column="1"
                        Margin="0,8,6,0"
                        VerticalOptions="Start">
                <VerticalStackLayout Spacing="1" x:Name="LetterRail"
                                     BindableLayout.ItemsSource="{Binding LetterRailItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlbumsViewModel+LetterRailItem">
                            <Border WidthRequest="18"
                                    HeightRequest="18"
                                    StrokeShape="RoundRectangle 5"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding BackgroundColor}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLetterTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}"
                                       FontSize="9.5"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{Binding TextColor}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ═══ 加载指示器 ═══ -->
        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{DynamicResource PrimaryColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" />

        <!-- ═══ 更多操作弹窗 ═══ -->
        <controls:AppPopup x:Name="AlbumMorePopup" Title="专辑操作" CloseOnMaskTapped="True" />
    </Grid>
</ContentPage>
