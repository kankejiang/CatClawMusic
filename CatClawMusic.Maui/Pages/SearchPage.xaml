<?xml version="1.0" encoding="utf-8" ?>
<base:DiscoverPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:base="clr-namespace:CatClawMusic.Maui.Pages.Base"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             xmlns:helpers="clr-namespace:CatClawMusic.Maui.Helpers"
             xmlns:models="clr-namespace:CatClawMusic.Core.Models;assembly=CatClawMusic.Core"
             xmlns:vm="clr-namespace:CatClawMusic.Maui.ViewModels"
             x:Class="CatClawMusic.Maui.Pages.SearchPage"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabDiscover]}"
             BackgroundColor="Transparent">

    <Grid Background="Transparent">

        <CollectionView x:Name="DiscoverCollection"
                        IsVisible="{Binding IsChatMode, Converter={StaticResource InvertedBoolConverter}}"
                        ItemsSource="{Binding DiscoverPageItems}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <VerticalStackLayout Padding="0,0,0,24" Spacing="0">
                    <Grid Margin="18,16,18,10" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="发现" Style="{StaticResource PageTitleStyle}" />
                            <Label Text="{Binding GreetingText}" Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout x:Name="PluginEntriesBar" Grid.Column="1" Spacing="10" VerticalOptions="Center">
                            <Border Style="{StaticResource GlassIconContainerStyle}">
                                <ImageButton Source="{helpers:ThemedIcon Light=ic_search_light, Dark=ic_search}" WidthRequest="22" HeightRequest="22" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" Clicked="OnSearchToggleClicked" />
                            </Border>
                            <Border Style="{StaticResource GlassIconContainerStyle}">
                                <Grid>
                                    <ImageButton Source="{helpers:ThemedIcon Light=ic_refresh_light, Dark=ic_refresh}" WidthRequest="22" HeightRequest="22" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" Clicked="OnRefreshClicked"
                                                 IsVisible="{Binding IsRefreshing, Converter={StaticResource InvertedBoolConverter}}" />
                                    <ActivityIndicator IsRunning="{Binding IsRefreshing}" IsVisible="{Binding IsRefreshing}"
                                                       Color="{DynamicResource PrimaryColor}" WidthRequest="18" HeightRequest="18"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <!-- 在线音乐入口已移除：由 IViewContributorPlugin 插件提供入口（见下方 ViewContributors 列表） -->
                            <Border Style="{StaticResource GlassIconContainerStyle}">
                                <ImageButton Source="{helpers:ThemedIcon Light=ic_settings_light, Dark=ic_settings}" WidthRequest="22" HeightRequest="22" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" Clicked="OnSettingsClicked" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <Border x:Name="SearchBoxContainer" Margin="18,0,18,10" Style="{StaticResource GlassInputStyle}" IsVisible="{Binding IsSearchOpen}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Image Source="ic_search" WidthRequest="18" HeightRequest="18" Opacity="0.9" VerticalOptions="Center" />
                            <Entry Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchQuery, Mode=TwoWay}" Placeholder="搜索歌曲、歌手、专辑，或在线音乐..." ReturnType="Search" TextChanged="OnSearchTextChanged" Completed="OnSearchCompleted" />
                            <ImageButton Grid.Column="2" Source="ic_close" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent" IsVisible="{Binding ShowSearchResults}" Clicked="OnClearSearchClicked" />
                        </Grid>
                    </Border>


                    <Border Margin="18,0,18,10" Padding="0" StrokeShape="RoundRectangle 18" StrokeThickness="1" Stroke="{DynamicResource GlassStrokeColor}" BackgroundColor="{DynamicResource CardBackgroundStrongColor}" IsVisible="{Binding ShowSearchDropdown}">
                        <ScrollView MaximumHeightRequest="380">
                            <VerticalStackLayout Spacing="0">
                                <VerticalStackLayout IsVisible="{Binding SearchArtistResults.Count, Converter={StaticResource CountToBoolConverter}}">
                                    <Label Text="歌手" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextHintColor}" CharacterSpacing="2" Padding="16,12,16,4" />
                                    <CollectionView ItemsSource="{Binding SearchArtistResults}" SelectionMode="Single" SelectionChanged="OnSearchArtistSelected" ItemsUpdatingScrollMode="KeepItemsInView" HeightRequest="{Binding SearchArtistResults.Count, Converter={StaticResource SearchSectionHeightConverter}}">
                                        <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="14,8" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                                        <Image Source="{Binding CoverSource}" Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                        <Label Text="{Binding Name}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                                        <Label Text="{Binding Subtitle}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                                <VerticalStackLayout IsVisible="{Binding SearchAlbumResults.Count, Converter={StaticResource CountToBoolConverter}}">
                                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="16,4" />
                                    <Label Text="专辑" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextHintColor}" CharacterSpacing="2" Padding="16,8,16,4" />
                                    <CollectionView ItemsSource="{Binding SearchAlbumResults}" SelectionMode="Single" SelectionChanged="OnSearchAlbumSelected" ItemsUpdatingScrollMode="KeepItemsInView" HeightRequest="{Binding SearchAlbumResults.Count, Converter={StaticResource SearchSectionHeightConverter}}">
                                        <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="14,8" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                                        <Image Source="{Binding CoverSource}" Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                        <Label Text="{Binding Title}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                                        <Label FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1">
                                                            <Label.Text><MultiBinding StringFormat="{}{0} · {1}"><Binding Path="ArtistName" TargetNullValue="未知艺术家" /><Binding Path="Subtitle" /></MultiBinding></Label.Text>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                                <VerticalStackLayout IsVisible="{Binding SearchResults.Count, Converter={StaticResource CountToBoolConverter}}">
                                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="16,4" />
                                    <Label Text="歌曲" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextHintColor}" CharacterSpacing="2" Padding="16,8,16,4" />
                                    <CollectionView ItemsSource="{Binding SearchResults}" SelectionMode="Single" SelectionChanged="OnSearchResultSelected" ItemsUpdatingScrollMode="KeepItemsInView" HeightRequest="{Binding SearchResults.Count, Converter={StaticResource SearchSectionHeightConverter}}">
                                        <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="14,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                                        <Image Source="{Binding CoverArtPath, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                        <Label Text="{Binding Title}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                                        <Label FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1">
                                                            <Label.Text><MultiBinding StringFormat="{}{0} · {1}"><Binding Path="Artist" TargetNullValue="未知艺术家" /><Binding Path="Album" TargetNullValue="未知专辑" /></MultiBinding></Label.Text>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="2" Text="{Binding Duration, Converter={StaticResource DurationConverter}}" FontSize="11" TextColor="{DynamicResource TextHintColor}" VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                                <!-- 在线音乐：音源插件聚合搜索（多平台合并展示） -->
                                <VerticalStackLayout IsVisible="{Binding HasOnlineSearchResults}">
                                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="16,4" />
                                    <Label Text="在线音乐" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextHintColor}" CharacterSpacing="2" Padding="16,8,16,4" />
                                    <CollectionView ItemsSource="{Binding OnlineSearchResults}" SelectionMode="Single" SelectionChanged="OnOnlineSearchResultSelected" ItemsUpdatingScrollMode="KeepItemsInView" HeightRequest="{Binding OnlineSearchResults.Count, Converter={StaticResource SearchSectionHeightConverter}}">
                                        <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:OnlineSong">
                                                <Grid Padding="14,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                                        <Image Source="{Binding CoverUrl, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                        <Label Text="{Binding Title}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                                        <Label FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1">
                                                            <Label.Text><MultiBinding StringFormat="{}{0} · {1}"><Binding Path="Artist" TargetNullValue="未知艺术家" /><Binding Path="Album" TargetNullValue="未知专辑" /></MultiBinding></Label.Text>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="2" Text="{Binding PlatformName}" FontSize="10" TextColor="{DynamicResource PrimaryColor}" VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                                <Label IsVisible="{Binding IsSearchingOnline}" Text="正在搜索在线音乐…" FontSize="12" TextColor="{DynamicResource TextHintColor}" Padding="16,8" />
                                <Border Margin="12,8,12,12" Padding="14,12" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAskYukiTapped" />
                                    </Border.GestureRecognizers>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#667eea" Offset="0" />
                                            <GradientStop Color="#764ba2" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Text="🐾" FontSize="20" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="没找到想要的？问问 Yuki 吧" FontSize="14" FontFamily="OpenSansSemibold" TextColor="White" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#CCFFFFFF" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Border>

                    <Grid x:Name="CategoryTabBar" Margin="18,0,18,14" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                        <Border Grid.Column="0" x:Name="TabRec" Style="{StaticResource GlassCardStyle}" Padding="12,10" Stroke="{DynamicResource GlassStrokeColor}">
                            <Label x:Name="TabRecLabel" Text="推荐" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="0" /></Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="1" x:Name="TabRank" Style="{StaticResource GlassCardStyle}" Padding="12,10" Stroke="{DynamicResource GlassStrokeColor}">
                            <Label x:Name="TabRankLabel" Text="排行" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="1" /></Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="2" x:Name="TabArtist" Style="{StaticResource GlassCardStyle}" Padding="12,10" Stroke="{DynamicResource GlassStrokeColor}">
                            <Label x:Name="TabArtistLabel" Text="歌手" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="2" /></Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="3" x:Name="TabAlbum" Style="{StaticResource GlassCardStyle}" Padding="12,10" Stroke="{DynamicResource GlassStrokeColor}">
                            <Label x:Name="TabAlbumLabel" Text="专辑" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="3" /></Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="4" x:Name="TabStats" Style="{StaticResource GlassCardStyle}" Padding="12,10" Stroke="{DynamicResource GlassStrokeColor}">
                            <Label x:Name="TabStatsLabel" Text="统计" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="4" /></Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <VerticalStackLayout x:Name="PanelRecommend" IsVisible="{Binding CurrentCategory, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}" Spacing="0">
                        <Grid Margin="20,0,20,12" ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout VerticalOptions="Center" Spacing="8">
                                <Label Text="✨" FontSize="16" VerticalOptions="Center" />
                                <Label Text="智能推荐 AI" FontSize="14" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding IsAiRecommendationEnabled}" VerticalOptions="Center" OnColor="{DynamicResource PrimaryColor}" />
                        </Grid>

                        <!-- Hero 卡片横向并排（横屏同款：一行方形卡横滑，不自动轮播）。
                             数据源由 code-behind 赋值：AI 助手卡 + HeroCards -->
                        <CollectionView x:Name="HeroGrid" Margin="14,0,14,10" HeightRequest="130"
                                        SelectionMode="None" ItemsUpdatingScrollMode="KeepItemsInView">
                            <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <!-- 方形英雄卡（紧凑：130 方形，一屏约 2.5 张，横滑浏览） -->
                                    <Border WidthRequest="130" HeightRequest="130" Padding="11" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                            HorizontalOptions="Fill" VerticalOptions="Fill">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnHeroCardTapped" />
                                        </Border.GestureRecognizers>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{Binding GradientStart}" Offset="0" />
                                                <GradientStop Color="{Binding GradientEnd}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid RowDefinitions="Auto,*,Auto">
                                            <Border Padding="7,2" StrokeThickness="0" StrokeShape="RoundRectangle 999" BackgroundColor="#30FFFFFF" HorizontalOptions="Start">
                                                <Label Text="{Binding Tag}" FontSize="8" FontAttributes="Bold" TextColor="White" CharacterSpacing="1.5" />
                                            </Border>
                                            <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="3">
                                                <Label Text="{Binding Title}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="White" MaxLines="2" />
                                                <Label Text="{Binding Description}" FontSize="9" TextColor="#CCFFFFFF" MaxLines="2" />
                                            </VerticalStackLayout>
                                            <Border Grid.Row="2" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" BackgroundColor="#50FFFFFF" HorizontalOptions="End">
                                                <ImageButton Source="ic_play" WidthRequest="16" HeightRequest="16" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" Clicked="OnHeroPlayTapped" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- AI 歌单（开启智能推荐且有数据/正在生成时显示；由 AI 每天生成一次） -->
                        <VerticalStackLayout Spacing="0" IsVisible="{Binding IsAiPlaylistsSectionVisible}">
                            <Grid Margin="20,0,20,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="4" HeightRequest="16" StrokeThickness="0" StrokeShape="RoundRectangle 2" VerticalOptions="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#667eea" Offset="0" />
                                            <GradientStop Color="#f093fb" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="AI 歌单" Style="{StaticResource SectionTitleStyle}" />
                                    <Label Text="每天由 AI 根据你的口味定制" FontSize="10.5" TextColor="{DynamicResource TextHintColor}"
                                           IsVisible="{Binding IsAiPlaylistsLoading, Converter={StaticResource InvertedBoolConverter}}" />
                                    <Label Text="AI 正在分析你的口味生成歌单…" FontSize="10.5" TextColor="{DynamicResource PrimaryColor}"
                                           IsVisible="{Binding IsAiPlaylistsLoading}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Padding="10,3" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                                        BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}" VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAiPlaylistRegenerateTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="重新生成" FontSize="9.5" FontAttributes="Bold" TextColor="White" />
                                </Border>
                            </Grid>

                            <!-- 生成中：加载指示 + 实时思考过程 -->
                            <Grid HeightRequest="150" IsVisible="{Binding IsAiPlaylistsLoading}">
                                <ActivityIndicator IsRunning="{Binding IsAiPlaylistsLoading}" IsVisible="{Binding IsAiPlaylistsLoading}"
                                                   Color="{DynamicResource PrimaryColor}" WidthRequest="28" HeightRequest="28"
                                                   HorizontalOptions="Center" VerticalOptions="Start" Margin="0,20,0,0" />
                                <Label Text="{Binding AiPlaylistsThinking}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}"
                                       LineBreakMode="WordWrap" MaxLines="5" HorizontalOptions="Center" VerticalOptions="End"
                                       Margin="24,0,24,12" />
                            </Grid>

                            <CollectionView x:Name="AiPlaylistRow" Margin="14,0,14,12" HeightRequest="156"
                                            ItemsSource="{Binding AiPlaylists}" SelectionMode="None"
                                            IsVisible="{Binding IsAiPlaylistsLoading, Converter={StaticResource InvertedBoolConverter}}">
                                <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" /></CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 与每日推荐卡片同尺寸：宽 104 封面方形 + 紧凑文字 -->
                                        <Border WidthRequest="104" StrokeShape="RoundRectangle 14" StrokeThickness="1"
                                                Stroke="{DynamicResource GlassStrokeColor}" BackgroundColor="{DynamicResource CardBackgroundStrongColor}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnAiPlaylistTapped" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="0">
                                                <Border WidthRequest="104" HeightRequest="104" StrokeShape="RoundRectangle 14 14 0 0" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                                    <Image Source="{Binding CoverPath, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="104" HeightRequest="104" />
                                                </Border>
                                                <VerticalStackLayout Padding="8,6,8,8" Spacing="2">
                                                    <Label Text="{Binding Name}" FontSize="11" FontFamily="OpenSansSemibold"
                                                           TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                                    <Label Text="{Binding Reason}" FontSize="9" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" />
                                                    <Label Text="{Binding Subtitle}" FontSize="9" TextColor="{DynamicResource PrimaryColor}" MaxLines="1" />
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <!-- 推荐专辑（两行横滑：每屏 2 行 × 多列，横向滚动） -->
                        <Grid Margin="16,0,16,6" ColumnDefinitions="*,Auto">
                            <Label Text="推荐专辑" Style="{StaticResource SectionTitleStyle}" />
                            <Button Grid.Column="1" Text="查看全部 ›" FontSize="12" HeightRequest="34" CornerRadius="16" BackgroundColor="Transparent" TextColor="{DynamicResource TextSecondaryColor}" Padding="8,0" Clicked="OnViewAllAlbumsClicked" />
                        </Grid>
                        <CollectionView x:Name="RecommendAlbumGrid" Margin="14,0,14,12" HeightRequest="336"
                                        ItemsSource="{Binding RecommendAlbums}"
                                        SelectionMode="Single" SelectionChanged="OnAlbumSelected" ItemsUpdatingScrollMode="KeepItemsInView">
                            <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Horizontal" Span="2" VerticalItemSpacing="8" HorizontalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout WidthRequest="124" Spacing="4">
                                        <Border StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                            <Image Source="{Binding CoverSource, TargetNullValue='ic_music_note'}" Aspect="AspectFill">
                                                <Image.Behaviors><controls:SquareBehavior /></Image.Behaviors>
                                            </Image>
                                        </Border>
                                        <Label Text="{Binding Title}" FontSize="12" FontFamily="OpenSansSemibold" MaxLines="1" />
                                        <Label Text="{Binding ArtistName}" FontSize="10" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid Margin="16,0,16,6" ColumnDefinitions="*,Auto">
                            <Label Text="每日推荐" Style="{StaticResource SectionTitleStyle}" />
                            <Button Grid.Column="1" Text="换一批 ↻" FontSize="12" HeightRequest="34" CornerRadius="16" BackgroundColor="Transparent" TextColor="{DynamicResource TextSecondaryColor}" Padding="8,0" Clicked="OnShuffleDailyClicked" />
                        </Grid>
                        <Grid Margin="14,0,14,12">
                            <CollectionView x:Name="DailyList" HeightRequest="156" ItemsSource="{Binding DailyRecommendSongs}" SelectionMode="Single" SelectionChanged="OnDailySongSelected" ItemsUpdatingScrollMode="KeepItemsInView">
                                <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" /></CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border WidthRequest="104" StrokeShape="RoundRectangle 14" StrokeThickness="1" Stroke="{DynamicResource GlassStrokeColor}" BackgroundColor="{DynamicResource CardBackgroundStrongColor}">
                                            <VerticalStackLayout Spacing="0">
                                                <Border WidthRequest="104" HeightRequest="104" StrokeShape="RoundRectangle 14 14 0 0" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                                    <Image Source="{Binding CoverArtPath, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="104" HeightRequest="104" />
                                                </Border>
                                                <VerticalStackLayout Padding="8,6,8,8" Spacing="2">
                                                    <Label Text="{Binding Title}" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                                    <Label Text="{Binding Artist}" FontSize="9" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" />
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <ImageButton x:Name="DailyPrev" WidthRequest="28" HeightRequest="28"
                                         BackgroundColor="#1A000000" CornerRadius="14" Padding="5" Aspect="AspectFit"
                                         HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,4,0" Clicked="OnDailyPrevClicked" />
                            <ImageButton x:Name="DailyNext" WidthRequest="28" HeightRequest="28"
                                         BackgroundColor="#1A000000" CornerRadius="14" Padding="5" Aspect="AspectFit"
                                         HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,4,0" Clicked="OnDailyNextClicked" IsVisible="False" />
                        </Grid>

                        <Grid Margin="16,0,16,6" ColumnDefinitions="*,Auto">
                            <Label Text="推荐艺人" Style="{StaticResource SectionTitleStyle}" />
                            <Button Grid.Column="1" Text="查看全部 ›" FontSize="12" HeightRequest="34" CornerRadius="16" BackgroundColor="Transparent" TextColor="{DynamicResource TextSecondaryColor}" Padding="8,0" Clicked="OnViewAllArtistsClicked" />
                        </Grid>
                        <Grid Margin="14,0,14,12">
                            <CollectionView x:Name="ArtistsList" HeightRequest="112" ItemsSource="{Binding Artists}" SelectionMode="Single" SelectionChanged="OnArtistSelected" ItemsUpdatingScrollMode="KeepItemsInView">
                                <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" /></CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout WidthRequest="74" Spacing="4">
                                            <Border WidthRequest="66" HeightRequest="66" StrokeShape="RoundRectangle 33" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}" HorizontalOptions="Center">
                                                <Image Source="{Binding CoverSource}" Aspect="AspectFill" WidthRequest="66" HeightRequest="66" />
                                            </Border>
                                            <Label Text="{Binding Name}" FontSize="11.5" FontFamily="OpenSansSemibold" HorizontalOptions="Center" MaxLines="1" />
                                            <Label Text="{Binding Subtitle}" FontSize="9.5" TextColor="{DynamicResource TextHintColor}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <ImageButton x:Name="ArtistPrev" WidthRequest="28" HeightRequest="28"
                                         BackgroundColor="#1A000000" CornerRadius="14" Padding="5" Aspect="AspectFit"
                                         HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,4,0" Clicked="OnArtistPrevClicked" />
                            <ImageButton x:Name="ArtistNext" WidthRequest="28" HeightRequest="28"
                                         BackgroundColor="#1A000000" CornerRadius="14" Padding="5" Aspect="AspectFit"
                                         HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,4,0" Clicked="OnArtistNextClicked" IsVisible="False" />
                        </Grid>
                    </VerticalStackLayout>

                    <ScrollView x:Name="PanelRank" IsVisible="{Binding CurrentCategory, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}" Orientation="Vertical">
                        <ScrollView.Behaviors><controls:ScrollPerformanceBehavior /></ScrollView.Behaviors>
                        <VerticalStackLayout Spacing="0" Margin="0,0,0,16">
                            <Grid Margin="20,0,20,8" ColumnDefinitions="*,Auto">
                                <Label Text="最多播放" Style="{StaticResource SectionTitleStyle}" />
                                <Button Grid.Column="1" Text="查看全部 ›" FontSize="12" HeightRequest="34" CornerRadius="16" BackgroundColor="Transparent" TextColor="{DynamicResource TextSecondaryColor}" Padding="8,0" Clicked="OnViewAllTopPlayedClicked" />
                            </Grid>
                            <CollectionView x:Name="TopPlayedList" Margin="18,0,18,16" ItemsSource="{Binding TopPlayedSongs}" SelectionMode="Single" SelectionChanged="OnTopPlayedSongSelected" ItemsUpdatingScrollMode="KeepItemsInView">
                                <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="14,9" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                            <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{DynamicResource InputBackgroundColor}">
                                                <Image Source="{Binding CoverArtPath, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="46" HeightRequest="46" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Title}" FontSize="14.5" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                                                <Label FontSize="12" LineBreakMode="TailTruncation" MaxLines="1" TextColor="{DynamicResource TextHintColor}">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} · {1}">
                                                            <Binding Path="Artist" TargetNullValue="未知艺术家" />
                                                            <Binding Path="Album" TargetNullValue="未知专辑" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" FontSize="12" VerticalOptions="Center" TextColor="{DynamicResource TextHintColor}" Text="{Binding Duration, Converter={StaticResource DurationConverter}}" />
                                            <Label Grid.Column="3" Text="⋮" FontSize="18" VerticalOptions="Center" TextColor="{DynamicResource TextHintColor}" Padding="6,0">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnMoreTapped" CommandParameter="{Binding}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <Grid Margin="20,0,20,8" ColumnDefinitions="*,Auto">
                                <Label Text="我的最爱 ★" Style="{StaticResource SectionTitleStyle}" />
                                <Button Grid.Column="1" Text="查看全部 ›" FontSize="12" HeightRequest="34" CornerRadius="16" BackgroundColor="Transparent" TextColor="{DynamicResource TextSecondaryColor}" Padding="8,0" Clicked="OnViewAllFavoritesClicked" />
                            </Grid>
                            <CollectionView x:Name="FavoriteList" Margin="18,0,18,16" ItemsSource="{Binding FavoriteSongs}" SelectionMode="Single" SelectionChanged="OnFavoriteSongSelected" ItemsUpdatingScrollMode="KeepItemsInView">
                                <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="14,9" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                            <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{DynamicResource InputBackgroundColor}">
                                                <Image Source="{Binding CoverArtPath, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="46" HeightRequest="46" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Title}" FontSize="14.5" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                                                <Label FontSize="12" LineBreakMode="TailTruncation" MaxLines="1" TextColor="{DynamicResource TextHintColor}">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} · {1}">
                                                            <Binding Path="Artist" TargetNullValue="未知艺术家" />
                                                            <Binding Path="Album" TargetNullValue="未知专辑" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" FontSize="12" VerticalOptions="Center" TextColor="{DynamicResource TextHintColor}" Text="{Binding Duration, Converter={StaticResource DurationConverter}}" />
                                            <Label Grid.Column="3" Text="⋮" FontSize="18" VerticalOptions="Center" TextColor="{DynamicResource TextHintColor}" Padding="6,0">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnMoreTapped" CommandParameter="{Binding}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ScrollView>

                    <VerticalStackLayout x:Name="PanelArtist" IsVisible="{Binding CurrentCategory, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}" Spacing="0">
                        <Grid Margin="20,0,20,8" ColumnDefinitions="*,Auto">
                            <Label Text="推荐歌手" Style="{StaticResource SectionTitleStyle}" />
                            <Button Grid.Column="1" Text="查看全部 ›" FontSize="12" HeightRequest="34" CornerRadius="16" BackgroundColor="Transparent" TextColor="{DynamicResource TextSecondaryColor}" Padding="8,0" Clicked="OnViewAllArtistsClicked" />
                        </Grid>
                        <CollectionView x:Name="ArtistGrid" Margin="18,0,18,16" ItemsSource="{Binding Artists}" SelectionMode="Single" SelectionChanged="OnArtistSelected" ItemsUpdatingScrollMode="KeepItemsInView">
                            <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                            <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="12" HorizontalItemSpacing="12" /></CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="6">
                                        <Border WidthRequest="84" HeightRequest="84" StrokeShape="RoundRectangle 42" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}" HorizontalOptions="Center">
                                            <Image Source="{Binding CoverSource}" Aspect="AspectFill" WidthRequest="84" HeightRequest="84" />
                                        </Border>
                                        <Label Text="{Binding Name}" FontSize="13" FontFamily="OpenSansSemibold" HorizontalOptions="Center" MaxLines="1" />
                                        <Label Text="{Binding Subtitle}" FontSize="11" TextColor="{DynamicResource TextHintColor}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="PanelAlbum" IsVisible="{Binding CurrentCategory, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3}" Spacing="0">
                        <Grid Margin="20,0,20,4">
                            <Label Text="推荐专辑" Style="{StaticResource SectionTitleStyle}" />
                        </Grid>
                        <Label Text="从你的曲库里随机挑出的专辑 · 帮你重新发现" FontSize="11.5" TextColor="{DynamicResource TextHintColor}" Margin="20,0,20,10" />
                        <Grid Margin="20,0,20,8" ColumnDefinitions="*,Auto">
                            <Button Grid.Column="1" Text="查看全部 ›" FontSize="12" HeightRequest="34" CornerRadius="16" BackgroundColor="Transparent" TextColor="{DynamicResource TextSecondaryColor}" Padding="8,0" Clicked="OnViewAllAlbumsClicked" />
                        </Grid>
                        <CollectionView x:Name="AlbumGrid" Margin="18,0,18,16" ItemsSource="{Binding Albums}" SelectionMode="Single" SelectionChanged="OnAlbumSelected" ItemsUpdatingScrollMode="KeepItemsInView">
                            <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                            <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="12" HorizontalItemSpacing="12" /></CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="6">
                                        <Border StrokeShape="RoundRectangle 24" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                            <Image Source="{Binding CoverSource, TargetNullValue='ic_music_note'}" Aspect="AspectFill" HeightRequest="160" />
                                        </Border>
                                        <Label Text="{Binding Title}" FontSize="13.5" FontFamily="OpenSansSemibold" MaxLines="1" />
                                        <Label Text="{Binding ArtistName}" FontSize="11.5" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- ═══ 统计面板（听歌统计）═══ -->
                    <VerticalStackLayout x:Name="PanelStats" IsVisible="{Binding CurrentCategory, Converter={StaticResource IntToBoolConverter}, ConverterParameter=4}" Spacing="0">
                    </VerticalStackLayout>

                    <ActivityIndicator Margin="0,10" IsVisible="{Binding IsLoading}" IsRunning="{Binding IsLoading}" Color="{DynamicResource PrimaryColor}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <BoxView HeightRequest="0" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Chat Overlay: 不透明背景覆盖发现页；顶栏(返回/头像)/消息/迷你播放器/输入框各自独立一行，
             互不重叠。IsClippedToBounds 裁剪旋转列表的越界绘制/命中，防其干扰相邻行控件。 -->
        <Grid x:Name="ChatOverlay"
              IsVisible="{Binding IsChatMode}"
              BackgroundColor="{DynamicResource WindowBackgroundColor}"
              RowDefinitions="Auto,*,Auto,Auto"
              IsClippedToBounds="True">

            <!-- Chat Header（独立顶栏行 Row 0）：返回按钮 / Yuki 头像 / 标题，与聊天记录不在同一行 -->
            <Grid x:Name="ChatHeader"
                  Grid.Row="0"
                  Margin="16,10,16,6"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10">
                <controls:BackButton x:Name="ChatBackButton"
                                     VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding AgentName}"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[YukiDesc]}"
                           Style="{StaticResource PageSubtitleStyle}" />
                </VerticalStackLayout>
                <Border Grid.Column="2" Padding="4"
                        StrokeThickness="0" StrokeShape="RoundRectangle 20"
                        BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                        VerticalOptions="Center">
                    <Image Source="avatar_yuki.png"
                           WidthRequest="34" HeightRequest="34" />
                </Border>
            </Grid>

            <CollectionView x:Name="ChatMessagesList"
                            Grid.Row="1" Margin="12,0,12,0"
                            ItemsSource="{Binding ChatMessages}"
                            SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepItemsInView"
                            Scrolled="OnChatMessagesScrolled"
                            Rotation="180">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="2,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                              Rotation="180">
                            <!-- Yuki 头像（左）：assistant 消息显示，顶部对齐（QQ/微信样式） -->
                            <Border Grid.Column="0"
                                    WidthRequest="36" HeightRequest="36"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                    IsVisible="{Binding Role, Converter={StaticResource IsAssistantConverter}}"
                                    VerticalOptions="Start">
                                <Image Source="avatar_yuki.png" Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                            </Border>
                            <BoxView Grid.Column="0" WidthRequest="36" IsVisible="{Binding Role, Converter={StaticResource IsUserConverter}}" />

                            <!-- 消息气泡（含思考过程）：紧贴头像，顶部对齐 -->
                            <Border Grid.Column="1"
                                    Padding="12,10"
                                    StrokeThickness="0"
                                    MaximumWidthRequest="280"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{Binding Role, Converter={StaticResource ChatBubbleColorConverter}}"
                                    HorizontalOptions="{Binding Role, Converter={StaticResource ChatBubbleAlignmentConverter}}"
                                    VerticalOptions="Start">
                                <VerticalStackLayout Spacing="6">
                                    <!-- 思考/工具调用过程区块（仅助手消息且有思考内容时可见，点击折叠/展开） -->
                                    <Border IsVisible="{Binding HasThinking}"
                                            Padding="10,8"
                                            StrokeThickness="1"
                                            Stroke="{DynamicResource GlassStrokeColor}"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ButtonOverlayColor}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleThinkingCommand}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                <!-- 思考中旋转指示器 / 完成对勾 -->
                                                <ActivityIndicator Grid.Column="0"
                                                                   IsRunning="{Binding IsThinking}"
                                                                   IsVisible="{Binding IsThinking}"
                                                                   Color="{DynamicResource PrimaryColor}"
                                                                   WidthRequest="12" HeightRequest="12" />
                                                <Label Grid.Column="0" Text="✓"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextPrimaryColor}"
                                                       IsVisible="{Binding IsThinking, Converter={StaticResource InvertedBoolConverter}}"
                                                       VerticalOptions="Center"
                                                       WidthRequest="12"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding ThinkingSummary}"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextPrimaryColor}"
                                                       VerticalOptions="Center"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="2" Text="▲"
                                                       FontSize="9"
                                                       TextColor="{DynamicResource TextSecondaryColor}"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding IsThinkingExpanded}" />
                                                <Label Grid.Column="2" Text="▼"
                                                       FontSize="9"
                                                       TextColor="{DynamicResource TextSecondaryColor}"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding IsThinkingExpanded, Converter={StaticResource InvertedBoolConverter}}" />
                                            </Grid>
                                            <!-- 推理思考内容（展开且有推理文本时显示） -->
                                            <Label IsVisible="{Binding ShowReasoning}"
                                                   Text="{Binding ReasoningContent}"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource TextSecondaryColor}"
                                                   LineBreakMode="WordWrap"
                                                   Margin="0,4,0,2" />
                                            <!-- 展开详情：思考步骤列表 -->
                                            <CollectionView IsVisible="{Binding IsThinkingExpanded}"
                                                            ItemsSource="{Binding ThinkingSteps}"
                                                            MaximumHeightRequest="160"
                                                            Margin="0,2,0,0">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Label Text="{Binding}"
                                                               FontSize="10"
                                                               TextColor="{DynamicResource TextSecondaryColor}"
                                                               Padding="2,2" />
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- 消息正文（思考中时不显示，避免空白） -->
                                    <Label Text="{Binding Content}"
                                           FontSize="14"
                                           TextColor="{Binding Role, Converter={StaticResource ChatBubbleTextColorConverter}}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding Content, Converter={StaticResource StringToBoolConverter}}" />

                                    <!-- 歌曲搜索结果卡片（点击播放；非滚动渲染，避免嵌在旋转聊天列表里滚动反向） -->
                                    <VerticalStackLayout IsVisible="{Binding HasSongs}"
                                                         BindableLayout.ItemsSource="{Binding Songs}"
                                                         Spacing="0"
                                                         Margin="0,6,0,0">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="6,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnChatSongTapped" />
                                                    </Grid.GestureRecognizers>
                                                    <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                                        <Image Source="{Binding CoverArtPath, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="40" HeightRequest="40" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                        <Label Text="{Binding Title}" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding Artist}" FontSize="10" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>
                                                    <Border Grid.Column="2" WidthRequest="30" HeightRequest="30" StrokeShape="RoundRectangle 15" BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}" VerticalOptions="Center">
                                                        <Image Source="ic_play" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 用户头像（右）：user 消息显示，顶部对齐（QQ/微信样式） -->
                            <Border Grid.Column="2"
                                    WidthRequest="36" HeightRequest="36"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                    BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}"
                                    IsVisible="{Binding Role, Converter={StaticResource IsUserConverter}}"
                                    VerticalOptions="Start">
                                <Label Text="👤"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <BoxView Grid.Column="2" WidthRequest="36" IsVisible="{Binding Role, Converter={StaticResource IsAssistantConverter}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 聊天模式迷你播放器：有歌曲播放时显示在输入框上方（独立行 Row 2） -->
            <Grid Grid.Row="2" x:Name="ChatMiniPlayer"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  ColumnSpacing="10"
                  Padding="12,6"
                  HeightRequest="52"
                  Background="{DynamicResource HeroBrush}"
                  IsVisible="False">

                <Border Grid.Column="0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        WidthRequest="40" HeightRequest="40"
                        BackgroundColor="{DynamicResource ChipInactiveColor}">
                    <Image Source="{Binding CoverImage}"
                           Aspect="AspectFill" />
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="1"
                                     VerticalOptions="Center">
                    <Label Text="{Binding Title}"
                           FontSize="13"
                           FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Artist}"
                           FontSize="11"
                           TextColor="{DynamicResource TextSecondaryColor}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <Button Grid.Column="0" Grid.ColumnSpan="2"
                        BackgroundColor="Transparent"
                        Text=""
                        BorderWidth="0"
                        CornerRadius="0"
                        Padding="0"
                        Clicked="OnChatMiniPlayerTapped"
                        HorizontalOptions="Fill" VerticalOptions="Fill" />

                <Button Grid.Column="2"
                        WidthRequest="28" HeightRequest="28"
                        CornerRadius="14" Padding="0"
                        BackgroundColor="Transparent"
                        ImageSource="{Binding PlayPreviousIconSourceWhite}"
                        Command="{Binding PlayPreviousCommand}"
                        VerticalOptions="Center" HorizontalOptions="Center" />

                <Button Grid.Column="3"
                        WidthRequest="36" HeightRequest="36"
                        CornerRadius="18" Padding="0"
                        BackgroundColor="Transparent"
                        ImageSource="{Binding PlayPauseIconSourceWhite}"
                        Command="{Binding TogglePlayPauseCommand}"
                        VerticalOptions="Center" HorizontalOptions="Center" />

                <Button Grid.Column="4"
                        WidthRequest="28" HeightRequest="28"
                        CornerRadius="14" Padding="0"
                        BackgroundColor="Transparent"
                        ImageSource="{Binding PlayNextIconSourceWhite}"
                        Command="{Binding PlayNextCommand}"
                        VerticalOptions="Center" HorizontalOptions="Center" />
            </Grid>

            <Border Grid.Row="3" Margin="12,10,12,14"
                    Style="{StaticResource GlassInputStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <!-- 推理力度：点击弹出上拉菜单（底部面板选择） -->
                    <Border x:Name="EffortButton" Padding="10,4" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                            BackgroundColor="{DynamicResource ChipInactiveColor}" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReasoningEffortButtonTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="EffortButtonLabel" Text="推理：自动" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Border>
                    <Entry Grid.Column="1" x:Name="ChatInputBox"
                           Text="{Binding ChatInput, Mode=TwoWay}"
                           Placeholder="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ChatPlaceholder]}"
                           ReturnType="Send"
                           Completed="OnChatInputCompleted" />
                    <Border Grid.Column="2"
                            Style="{StaticResource GlassIconContainerStyle}"
                            BackgroundColor="{DynamicResource ChipActiveColor}">
                        <Grid>
                            <!-- 空闲时显示发送按钮；AI 思考/回复中变为中断按钮 -->
                            <ImageButton Source="ic_send"
                                         IsVisible="{Binding IsSendVisible}"
                                         WidthRequest="40" HeightRequest="40"
                                         BackgroundColor="Transparent"
                                         Padding="9"
                                         Clicked="OnSendClicked" />
                            <ImageButton Source="ic_close"
                                         IsVisible="{Binding IsStopVisible}"
                                         WidthRequest="40" HeightRequest="40"
                                         BackgroundColor="Transparent"
                                         Padding="9"
                                         Clicked="OnStopClicked" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 设置侧滑面板覆盖层（从左到右滑出，85%宽度，点击空白收起） -->
        <Grid x:Name="SettingsPanelOverlay"
              IsVisible="False"
              ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSettingsBackdropTapped" />
            </Grid.GestureRecognizers>

            <!-- 半透明背景遮罩 -->
            <BoxView x:Name="SettingsBackdrop"
                     Color="Black"
                     Opacity="0"
                     InputTransparent="False" />

            <!-- 设置面板容器（85%宽度，从左侧滑入）：半透明毛玻璃面板（玻璃底 + 描边 + 圆角 + 投影） -->
            <Grid x:Name="SettingsPanel"
                  WidthRequest="300"
                  HorizontalOptions="Start"
                  TranslationX="-9999"
                  BackgroundColor="Transparent">

                <!-- 毛玻璃模糊层：模糊主题背景图并压暗；半透明，透出下方被遮罩压暗的发现页，形成通透的磨砂质感 -->
                <controls:FrostedBackground
                    Source="{DynamicResource ThemeBackgroundImage}"
                    IsActive="{DynamicResource ThemeBackgroundEnabled}"
                    IsVisible="{DynamicResource ThemeBackgroundEnabled}"
                    TintColor="{DynamicResource TabBarGlassTint}"
                    TintOpacity="0.45"
                    DimAmount="0.25"
                    Opacity="0.8"
                    Aspect="AspectFill"
                    UseNativeBlur="True"
                    InputTransparent="True" />

                <!-- 玻璃面板描边层：实心玻璃底 + 描边 + 圆角 + 投影（无内容，纯视觉，避免与模糊层同置于带阴影 Border 内导致不渲染） -->
                <Border BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                        Stroke="{DynamicResource GlassStrokeStrongColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 0,26,26,0"
                        InputTransparent="True">
                    <Border.Shadow>
                        <Shadow Brush="Black" Radius="30" Offset="10,0" Opacity="0.5" />
                    </Border.Shadow>
                </Border>

                <!-- 设置内容容器（按需求移除顶部“设置”标题栏与关闭 X；点击遮罩仍可收起面板） -->
                <ScrollView>
                    <ContentView x:Name="SettingsPanelContent" />
                </ScrollView>
            </Grid>
        </Grid>

        <!-- Agent 浏览器预览：AI 调用浏览器时在顶部弹出小窗口（不离开聊天页） -->
        <controls:AgentBrowserPreview x:Name="AgentBrowserPreview"
                                      VerticalOptions="Start"
                                      Margin="12,8,12,0"
                                      ZIndex="50" />

        <!-- 推理力度上拉菜单（悬浮在输入框上方，点击遮罩关闭） -->
        <Grid x:Name="EffortSheetOverlay"
              IsVisible="False"
              ZIndex="120">
            <BoxView Color="Black" Opacity="0.25">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEffortSheetBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <!-- 推理力度菜单：悬浮在输入框上方（底部留出输入框高度的 Margin），点击遮罩关闭 -->
            <Border x:Name="EffortSheet" VerticalOptions="End" Margin="12,0,12,72"
                    BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                    Stroke="{DynamicResource GlassStrokeStrongColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="0" Padding="0,10,0,6">
                    <Label Text="推理力度" FontSize="14" FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}" HorizontalOptions="Center" Margin="0,0,0,8" />

                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="12,0" />

                    <Grid x:Name="EffortOptDisabled" Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Grid.GestureRecognizers><TapGestureRecognizer CommandParameter="disabled" Tapped="OnReasoningEffortOptionTapped" /></Grid.GestureRecognizers>
                        <Label x:Name="EffortOptDisabledLabel" Text="关闭" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" x:Name="EffortOptDisabledCheck" Text="✓" FontSize="13" TextColor="{DynamicResource PrimaryColor}" IsVisible="False" />
                    </Grid>
                    <Grid x:Name="EffortOptLow" Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Grid.GestureRecognizers><TapGestureRecognizer CommandParameter="low" Tapped="OnReasoningEffortOptionTapped" /></Grid.GestureRecognizers>
                        <Label x:Name="EffortOptLowLabel" Text="低" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" x:Name="EffortOptLowCheck" Text="✓" FontSize="13" TextColor="{DynamicResource PrimaryColor}" IsVisible="False" />
                    </Grid>
                    <Grid x:Name="EffortOptHigh" Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Grid.GestureRecognizers><TapGestureRecognizer CommandParameter="high" Tapped="OnReasoningEffortOptionTapped" /></Grid.GestureRecognizers>
                        <Label x:Name="EffortOptHighLabel" Text="高" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" x:Name="EffortOptHighCheck" Text="✓" FontSize="13" TextColor="{DynamicResource PrimaryColor}" IsVisible="False" />
                    </Grid>
                    <Grid x:Name="EffortOptMax" Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Grid.GestureRecognizers><TapGestureRecognizer CommandParameter="max" Tapped="OnReasoningEffortOptionTapped" /></Grid.GestureRecognizers>
                        <Label x:Name="EffortOptMaxLabel" Text="最强" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" x:Name="EffortOptMaxCheck" Text="✓" FontSize="13" TextColor="{DynamicResource PrimaryColor}" IsVisible="False" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</base:DiscoverPageBase>
