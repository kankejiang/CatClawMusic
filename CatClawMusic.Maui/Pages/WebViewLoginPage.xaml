<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawMusic.Maui.Pages.WebViewLoginPage"
             Title="账号登录"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource PageBackgroundBrush}">

        <!-- 顶部栏：返回 + 标题 + 完成按钮 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="16,12,16,8" ColumnSpacing="12">
            <Border Style="{StaticResource GlassIconContainerStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label Text="‹" FontSize="26" TextColor="{DynamicResource TextPrimaryColor}"
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-4,0,0" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label x:Name="TitleLabel" Text="账号登录" FontSize="17" FontFamily="OpenSansSemibold"
                       TextColor="{DynamicResource TextPrimaryColor}" />
                <Label x:Name="StatusHint" Text="请在下方页面完成登录，登录成功后自动返回"
                       FontSize="11" TextColor="{DynamicResource TextHintColor}" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Padding="12,7" StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{DynamicResource PrimaryColor}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDoneTapped" />
                </Border.GestureRecognizers>
                <Label Text="完成" FontSize="12" FontFamily="OpenSansSemibold"
                       TextColor="White" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- WebView：加载插件提供的登录页 -->
        <WebView x:Name="LoginWebView"
                 Grid.Row="1"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 Navigated="OnWebViewNavigated" />
    </Grid>
</ContentPage>
