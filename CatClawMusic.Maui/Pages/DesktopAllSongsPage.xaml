<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CatClawMusic.Maui.ViewModels"
             xmlns:models="clr-namespace:CatClawMusic.Core.Models;assembly=CatClawMusic.Core"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:helpers="clr-namespace:CatClawMusic.Maui.Helpers"
             x:Class="CatClawMusic.Maui.Pages.DesktopAllSongsPage"
             x:DataType="vm:AllSongsViewModel"
             BackgroundColor="{DynamicResource WindowBackgroundColor}"
             Shell.NavBarIsVisible="False">

    <!-- 横屏左右布局：左侧控件面板（返回/标题/搜索/视图切换/播放/排序） + 右侧歌曲网格/列表 -->
    <Grid ColumnDefinitions="280,*"
          Background="{DynamicResource PageBackgroundBrush}">

        <!-- ═══ 左侧控件面板 ═══ -->
        <Border Grid.Column="0"
                StrokeThickness="0"
                Stroke="{DynamicResource DividerColor}"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                Margin="0,0,1,0">
            <ScrollView Padding="16,12" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="14">

                    <!-- 返回按钮 + 标题 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Grid.Column="0" WidthRequest="32" HeightRequest="32"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                                Stroke="{DynamicResource GlassStrokeColor}"
                                StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </Border.GestureRecognizers>
                            <Image Source="{helpers:ThemedIcon Light=ic_arrow_left_light, Dark=ic_arrow_left}"
                                   WidthRequest="16" HeightRequest="16"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" HorizontalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding PageTitle}" FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label Text="{Binding SongCountText}" FontSize="11"
                                   TextColor="{DynamicResource TextHintColor}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 搜索框 -->
                    <controls:PageSearchBox Placeholder="搜索歌曲、艺术家、专辑"
                                            FontSize="13"
                                            CornerRadius="10"
                                            SearchQuery="{Binding SearchQuery, Mode=TwoWay}" />

                    <!-- 本地/网络/全部筛选 -->
                    <controls:SourceFilterControl SelectedMode="{Binding FilterMode, Mode=TwoWay}"
                                                  IsVisible="{Binding IsSourceFilterVisible}" />

                    <!-- 视图切换（网格/列表） -->
                    <controls:ViewToggleButton IsGridView="{Binding IsGridView, Mode=TwoWay}"
                                               HorizontalOptions="Start" />

                    <!-- 播放全部 + 随机播放（同一行） -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <!-- 播放全部 -->
                        <Border Grid.Column="0" Padding="12,8"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="{DynamicResource GlassStrokeStrongColor}"
                                BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlayAllCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="▶ 播放" FontSize="12" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <!-- 随机播放 -->
                        <Border Grid.Column="1" Padding="12,8"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="{DynamicResource GlassStrokeColor}"
                                BackgroundColor="{DynamicResource CardBackgroundStrongColor}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShufflePlayCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="🔀 随机" FontSize="12" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- 排序标签 -->
                    <Label Text="排序" FontSize="11" FontAttributes="Bold"
                           TextColor="{DynamicResource TextHintColor}"
                           CharacterSpacing="2" Margin="0,4,0,0" />

                    <!-- 排序选项（两列网格排列） -->
                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding SortOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SortOption">
                                <Border WidthRequest="124"
                                        Margin="0,0,6,6"
                                        Padding="11,7"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="1"
                                        Stroke="{Binding BorderColor}"
                                        BackgroundColor="{Binding BackgroundColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSortChipTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}"
                                           FontSize="12"
                                           TextColor="{Binding TextColor}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- ═══ 右侧歌曲列表/网格 + A-Z 索引 ═══ -->
        <Grid Grid.Column="1" x:Name="SongContentGrid" ColumnDefinitions="*,Auto" Padding="12,10,12,10" ColumnSpacing="8">

            <!-- 列表视图（默认）：完整显示歌名/歌手/专辑/时长 -->
            <CollectionView ItemsUpdatingScrollMode="KeepScrollOffset" Grid.Column="0" x:Name="SongListView"
                            ItemsSource="{Binding Songs}"
                            SelectionMode="None"
                            IsVisible="{Binding IsGridView, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Song">
                        <!-- 行：底层 Button 提供原生按压高亮 + 点击播放 + 长按菜单（Button.Content 在 Android 不承载复杂布局，
                             内容放到上层 InputTransparent 的 Grid 中仅展示，触摸仍落到 Button） -->
                        <Grid>
                            <Button BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    CornerRadius="0"
                                    Clicked="OnSongClicked"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill">
                                <Button.Behaviors>
                                    <controls:SongContextMenuBehavior />
                                </Button.Behaviors>
                            </Button>

                            <!-- 内容层：仅展示，不拦截触摸 -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8"
                                  Padding="10,6,34,6"
                                  InputTransparent="True">
                            <!-- 封面 -->
                            <Border Grid.Column="0" WidthRequest="46" HeightRequest="46"
                                    StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                    BackgroundColor="{DynamicResource InputBackgroundColor}">
                                <Image Source="{Binding CoverArtPath}" Aspect="AspectFill"
                                       WidthRequest="46" HeightRequest="46" />
                            </Border>

                            <!-- 标题 + 艺术家·专辑 -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding Title}" FontSize="13.5" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label FontSize="11" LineBreakMode="TailTruncation" MaxLines="1"
                                       TextColor="{DynamicResource TextHintColor}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} · {1}">
                                            <Binding Path="Artist" />
                                            <Binding Path="Album" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>

                            <!-- 时长 -->
                            <Label Grid.Column="2" FontSize="11" VerticalOptions="Center"
                                   TextColor="{DynamicResource TextHintColor}"
                                   Text="{Binding Duration, Converter={StaticResource DurationConverter}}" />

                            <!-- 更多按钮提示 -->
                            <Label Grid.Column="3" Text="⋮" FontSize="16" VerticalOptions="Center"
                                   TextColor="{DynamicResource TextHintColor}"
                                   Padding="4,0" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- 空状态 -->
                <CollectionView.EmptyView>
                    <Label Text="没有匹配的歌曲" FontSize="13"
                           TextColor="{DynamicResource TextHintColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,40" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- 网格视图：CollectionView 虚拟化「行」，每行水平排 N 张固定宽卡片。
                 列数 N 按可用宽度实时计算并分块（GridItemsLayout.Span 在 WinUI 失效；
                 一次性 FlexLayout 全量渲染千余张会 0xc000027b 闪崩）。 -->
            <CollectionView Grid.Column="0" ItemsUpdatingScrollMode="KeepScrollOffset"
                            x:Name="GridSongView"
                            SizeChanged="OnGridResized"
                            ItemsSource="{Binding GridRows}"
                            SelectionMode="None"
                            IsVisible="{Binding IsGridView}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="controls:GridChunkRow">
                        <FlexLayout Direction="Row" Wrap="NoWrap" JustifyContent="Start" Margin="0,0,0,12">
                            <BindableLayout.ItemsSource>
                                <Binding Path="Items" />
                            </BindableLayout.ItemsSource>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Song">
                                    <Border WidthRequest="168" Margin="0,0,12,0"
                                            StrokeShape="RoundRectangle 14" StrokeThickness="0"
                                            BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                                            Padding="5" HeightRequest="232">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnGridSongTapped" CommandParameter="{Binding}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="6">
                                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                                    WidthRequest="158" HeightRequest="158"
                                                    BackgroundColor="{Binding Id, Converter={StaticResource PlaceholderColorConverter}}">
                                                <Grid>
                                                    <Image Source="{Binding CoverArtPath}" Aspect="AspectFill"
                                                           WidthRequest="158" HeightRequest="158"
                                                           IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}}" />
                                                    <Label Text="{Binding Title, Converter={StaticResource InitialConverter}}"
                                                           FontSize="30" FontFamily="OpenSansSemibold"
                                                           TextColor="#DDFFFFFF"
                                                           HorizontalOptions="Center" VerticalOptions="Center"
                                                           IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}, ConverterParameter=invert}" />
                                                </Grid>
                                            </Border>
                                            <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimaryColor}"
                                                   LineBreakMode="TailTruncation" MaxLines="1" />
                                            <Label Text="{Binding Artist}" FontSize="10.5"
                                                   TextColor="{DynamicResource TextHintColor}"
                                                   LineBreakMode="TailTruncation" MaxLines="1" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="没有匹配的歌曲" FontSize="13"
                           TextColor="{DynamicResource TextHintColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,40" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- A-Z 索引条 -->
            <CollectionView ItemsUpdatingScrollMode="KeepScrollOffset" Grid.Column="1" ItemsSource="{Binding GroupHeaders}"
                            IsVisible="{Binding ShowIndexRail}"
                            HorizontalOptions="End" VerticalOptions="Center"
                            WidthRequest="18"
                            ItemsLayout="VerticalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupHeader">
                        <Label Text="{Binding Label}" FontSize="9" FontAttributes="Bold"
                               TextColor="{DynamicResource TextHintColor}"
                               HorizontalOptions="Center" VerticalOptions="Center" Padding="0,1">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIndexTapped" CommandParameter="{Binding Index}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- ═══ 加载指示器 ═══ -->
        <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Color="{DynamicResource PrimaryColor}" />
    </Grid>
</ContentPage>
