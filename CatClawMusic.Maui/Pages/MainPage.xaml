<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:vitrum="clr-namespace:Vitrum"
             x:Class="CatClawMusic.Maui.Pages.MainPage"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[AppName]}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WindowBackgroundColor}"
             SafeAreaEdges="None">

    <Grid Background="{DynamicResource PageBackgroundBrush}"
          SafeAreaEdges="None">

        <!-- ═══ 横屏桌面舞台：横屏时 MainPage 借入 DesktopMainPage 的完整桌面布局
             （左 220/168 侧栏 + 内容区 + 底部播放栏），与 Windows 桌面端同一界面。 ═══ -->
        <Grid x:Name="DesktopStage"
              IsVisible="False"
              SafeAreaEdges="None" />

        <!-- ═══ 竖屏移动舞台：ViewPager 区域 + 迷你播放器 + 底部 TabBar ═══ -->
        <Grid x:Name="MobileStage"
              RowDefinitions="*,Auto,Auto"
              SafeAreaEdges="None">

        <!-- ViewPager 区域：所有 tab 页面水平排列，滑动时同时移动。
             延伸到屏幕底部（RowSpan=3），使滚动内容可滚到播放栏/导航栏背后，
             供悬浮栏的 BlurConsumerView 真毛玻璃透出其下层内容。
             BlurHostView 包裹背景内容，BlurConsumerView 必须是其 Grid 兄弟（不能在其内容子树内）。 -->
        <vitrum:BlurHostView Grid.Row="0" Grid.RowSpan="3"
                             BlurRadius="90">
            <Grid x:Name="ViewPagerGrid"
                  BackgroundColor="Transparent"
                  IsClippedToBounds="True"
                  SafeAreaEdges="None">
                <Grid.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                </Grid.GestureRecognizers>
            </Grid>
        </vitrum:BlurHostView>

        <!-- 迷你播放器：圆角悬浮胶囊（左右留白 18，与 TabBar 间距 2） -->
        <Grid Grid.Row="1" x:Name="MiniPlayer"
              Margin="18,0,18,2"
              MaximumHeightRequest="88"
              IsVisible="False"
              SafeAreaEdges="None">

<Border StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{DynamicResource BottomBarStrokeColor}"
                    Background="Transparent">

                <!-- 真毛玻璃背景：BlurConsumerView 实时模糊下层 BlurHostView 内容（透列表内容，非封面） -->
                <vitrum:BlurConsumerView>
                    <vitrum:BlurConsumerView.TintColor>
                        <AppThemeBinding Light="#99FFFFFF" Dark="#8C1C1C25" />
                    </vitrum:BlurConsumerView.TintColor>
                    <Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                          ColumnSpacing="16"
                          Padding="14,10,14,10"
                          HeightRequest="88"
                          Background="Transparent">

                <!-- 封面 -->
                <Border Grid.Column="0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        WidthRequest="48" HeightRequest="48"
                        BackgroundColor="{DynamicResource ChipInactiveColor}">
                    <Image Source="{Binding CoverImage}"
                           Aspect="AspectFill" />
                </Border>

                <!-- 歌曲标题/艺术家 -->
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="{Binding Title}"
                           FontSize="15"
                           FontFamily="OpenSansSemibold"
                           TextColor="White"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Artist}"
                           FontSize="12"
                           TextColor="#CCFFFFFF"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <!-- 透明按钮覆盖封面+歌曲信息区域，避免 Grid 级 TapGestureRecognizer 在嵌套布局中失效 -->
                <Button Grid.Column="0" Grid.ColumnSpan="2"
                        BackgroundColor="Transparent"
                        Text=""
                        BorderWidth="0"
                        CornerRadius="0"
                        Padding="0"
                        Clicked="OnMiniPlayerTapped"
                        HorizontalOptions="Fill" VerticalOptions="Fill" />

                <!-- 上一曲（Image 而非 ImageButton：ImageButton 无 TintColor，主题着色需 Image.TintColor） -->
                <Image Grid.Column="2"
                        WidthRequest="32" HeightRequest="32"
                        Source="{Binding PlayPreviousIconSource}"
                        VerticalOptions="Center" HorizontalOptions="Center">
                    <Image.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Image.Behaviors>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PlayPreviousCommand}" />
                    </Image.GestureRecognizers>
                </Image>

                <!-- 播放/暂停：透明背景 + 主题反色图标（浅色深图标 / 深色白图标） -->
                <Image Grid.Column="3"
                        WidthRequest="42" HeightRequest="42"
                        Source="{Binding PlayPauseIconSource}"
                        VerticalOptions="Center" HorizontalOptions="Center">
                    <Image.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Image.Behaviors>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TogglePlayPauseCommand}" />
                    </Image.GestureRecognizers>
                </Image>

                <!-- 下一曲 -->
                <Image Grid.Column="4"
                        WidthRequest="32" HeightRequest="32"
                        Source="{Binding PlayNextIconSource}"
                        VerticalOptions="Center" HorizontalOptions="Center">
                    <Image.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Image.Behaviors>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PlayNextCommand}" />
                    </Image.GestureRecognizers>
                </Image>
                </Grid>

                <!-- 播放进度条：贴胶囊底部（3px，主题色） -->
                <ProgressBar Progress="{Binding MiniPlayerProgress}"
                             HeightRequest="3"
                             ProgressColor="{DynamicResource PrimaryColor}"
                             BackgroundColor="Transparent"
                             VerticalOptions="End"
                             HorizontalOptions="Fill"
                             Margin="0,0,0,-2" />
                    </Grid>
                </vitrum:BlurConsumerView>
            </Border>
        </Grid>

        <!-- 自定义底部 TabBar（4个Tab：播放/发现/歌单/音乐库），圆角悬浮胶囊（左右留白 18，底部悬浮 4） -->
        <Grid Grid.Row="2" x:Name="TabBar"
              Margin="18,0,18,4"
              SafeAreaEdges="None">

            <!-- 圆角胶囊容器：BlurConsumerView 真毛玻璃（透出下层列表内容），圆角由外层 Border 裁剪 -->
<Border StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{DynamicResource BottomBarStrokeColor}"
                    Background="Transparent">
                <vitrum:BlurConsumerView>
                    <vitrum:BlurConsumerView.TintColor>
                        <AppThemeBinding Light="#99FFFFFF" Dark="#8C1C1C25" />
                    </vitrum:BlurConsumerView.TintColor>
            <Grid ColumnDefinitions="*,*,*,*"
                  Padding="4,0,4,0"
                  Background="Transparent">

                <Grid Grid.Column="0" x:Name="TabItem0"
                      HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Grid.Behaviors>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" />
                    </Grid.GestureRecognizers>
                    <!-- 选中高亮胶囊背景（code-behind 控制） -->
                    <Border x:Name="TabBg0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent"
                            Margin="4,3,4,3" />
                    <VerticalStackLayout x:Name="TabContent0" Spacing="4" Margin="0,6,0,6" HorizontalOptions="Center" VerticalOptions="Center">
                        <ImageButton WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"
                                     x:Name="TabIcon0"
                                     Source="ic_play"
                                     BackgroundColor="Transparent"
                                     BorderWidth="0"
                                     Padding="0"
                                     InputTransparent="True" />
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabPlaying]}" FontSize="10" HorizontalTextAlignment="Center" x:Name="TabLabel0" />
                    </VerticalStackLayout>
                </Grid>

                <Grid Grid.Column="1" x:Name="TabItem1"
                      HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Grid.Behaviors>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" />
                    </Grid.GestureRecognizers>
                    <!-- 选中高亮胶囊背景（code-behind 控制） -->
                    <Border x:Name="TabBg1"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent"
                            Margin="4,3,4,3" />
                    <VerticalStackLayout x:Name="TabContent1" Spacing="4" Margin="0,6,0,6" HorizontalOptions="Center" VerticalOptions="Center">
                        <ImageButton WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"
                                     x:Name="TabIcon1"
                                     Source="ic_home"
                                     BackgroundColor="Transparent"
                                     BorderWidth="0"
                                     Padding="0"
                                     InputTransparent="True" />
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabDiscover]}" FontSize="10" HorizontalTextAlignment="Center" x:Name="TabLabel1" />
                    </VerticalStackLayout>
                </Grid>

                <Grid Grid.Column="2" x:Name="TabItem2"
                      HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Grid.Behaviors>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" />
                    </Grid.GestureRecognizers>
                    <!-- 选中高亮胶囊背景（code-behind 控制） -->
                    <Border x:Name="TabBg2"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent"
                            Margin="4,3,4,3" />
                    <VerticalStackLayout x:Name="TabContent2" Spacing="4" Margin="0,6,0,6" HorizontalOptions="Center" VerticalOptions="Center">
                        <ImageButton WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"
                                     x:Name="TabIcon2"
                                     Source="ic_playlist"
                                     BackgroundColor="Transparent"
                                     BorderWidth="0"
                                     Padding="0"
                                     InputTransparent="True" />
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabPlaylists]}" FontSize="10" HorizontalTextAlignment="Center" x:Name="TabLabel2" />
                    </VerticalStackLayout>
                </Grid>

                <Grid Grid.Column="3" x:Name="TabItem3"
                      HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Grid.Behaviors>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" />
                    </Grid.GestureRecognizers>
                    <!-- 选中高亮胶囊背景（code-behind 控制） -->
                    <Border x:Name="TabBg3"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent"
                            Margin="4,3,4,3" />
                    <VerticalStackLayout x:Name="TabContent3" Spacing="4" Margin="0,6,0,6" HorizontalOptions="Center" VerticalOptions="Center">
                        <ImageButton WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"
                                     x:Name="TabIcon3"
                                     Source="ic_library"
                                     BackgroundColor="Transparent"
                                     BorderWidth="0"
                                     Padding="0"
                                     InputTransparent="True" />
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabLibrary]}" FontSize="10" HorizontalTextAlignment="Center" x:Name="TabLabel3" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
                </vitrum:BlurConsumerView>
            </Border>
        </Grid>

        </Grid>

    </Grid>
</ContentPage>

