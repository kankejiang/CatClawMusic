<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             x:Class="CatClawMusic.Maui.Pages.MainPage"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[AppName]}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WindowBackgroundColor}"
             SafeAreaEdges="None">

    <Grid RowDefinitions="*,Auto,Auto"
          Background="{DynamicResource PageBackgroundBrush}"
          SafeAreaEdges="None">

        <!-- ViewPager 区域：所有 tab 页面水平排列，滑动时同时移动 -->
        <Grid x:Name="ViewPagerGrid" Grid.Row="0"
              BackgroundColor="Transparent"
              IsClippedToBounds="True"
              SafeAreaEdges="None">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- 迷你播放器：圆角悬浮胶囊（左右留白 18，与 TabBar 间距 2） -->
        <Grid Grid.Row="1" x:Name="MiniPlayer"
              Margin="18,0,18,2"
              MaximumHeightRequest="88"
              IsVisible="False"
              SafeAreaEdges="None">

<Border StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{DynamicResource BottomBarStrokeColor}"
                    Background="Transparent">

                <Grid>
                    <!-- 毛玻璃背景：封面图模糊做底，透出下层内容感 -->
                    <controls:FrostedBackground x:Name="MiniPlayerFrosted"
                                                Source="{Binding CoverImage}"
                                                IsActive="True"
                                                IsVisible="True"
                                                TintOpacity="0.5"
                                                DimAmount="0.3"
                                                TintColor="{DynamicResource TabBarGlassTint}"
                                                Opacity="0.85"
                                                UseNativeBlur="True"
                                                Aspect="AspectFill"
                                                InputTransparent="True" />
                    <!-- 半透明底色保底（毛玻璃下面的基础色，确保分层清晰） -->
                    <BoxView Color="{DynamicResource CardBackgroundColor}" InputTransparent="True" Opacity="0.6" />

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                          ColumnSpacing="16"
                          Padding="14,10,14,10"
                          HeightRequest="88"
                          Background="Transparent">

                <!-- 封面 -->
                <Border Grid.Column="0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        WidthRequest="48" HeightRequest="48"
                        BackgroundColor="{DynamicResource ChipInactiveColor}">
                    <Image Source="{Binding CoverImage}"
                           Aspect="AspectFill" />
                </Border>

                <!-- 歌曲标题/艺术家 -->
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="{Binding Title}"
                           FontSize="15"
                           FontFamily="OpenSansSemibold"
                           TextColor="White"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Artist}"
                           FontSize="12"
                           TextColor="#CCFFFFFF"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <!-- 透明按钮覆盖封面+歌曲信息区域，避免 Grid 级 TapGestureRecognizer 在嵌套布局中失效 -->
                <Button Grid.Column="0" Grid.ColumnSpan="2"
                        BackgroundColor="Transparent"
                        Text=""
                        BorderWidth="0"
                        CornerRadius="0"
                        Padding="0"
                        Clicked="OnMiniPlayerTapped"
                        HorizontalOptions="Fill" VerticalOptions="Fill" />

                <!-- 上一曲（Image 而非 ImageButton：ImageButton 无 TintColor，主题着色需 Image.TintColor） -->
                <Image Grid.Column="2"
                        WidthRequest="32" HeightRequest="32"
                        Source="{Binding PlayPreviousIconSource}"
                        VerticalOptions="Center" HorizontalOptions="Center">
                    <Image.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Image.Behaviors>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PlayPreviousCommand}" />
                    </Image.GestureRecognizers>
                </Image>

                <!-- 播放/暂停：透明背景 + 主题反色图标（浅色深图标 / 深色白图标） -->
                <Image Grid.Column="3"
                        WidthRequest="42" HeightRequest="42"
                        Source="{Binding PlayPauseIconSource}"
                        VerticalOptions="Center" HorizontalOptions="Center">
                    <Image.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Image.Behaviors>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TogglePlayPauseCommand}" />
                    </Image.GestureRecognizers>
                </Image>

                <!-- 下一曲 -->
                <Image Grid.Column="4"
                        WidthRequest="32" HeightRequest="32"
                        Source="{Binding PlayNextIconSource}"
                        VerticalOptions="Center" HorizontalOptions="Center">
                    <Image.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Image.Behaviors>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PlayNextCommand}" />
                    </Image.GestureRecognizers>
                </Image>
                </Grid>

                <!-- 播放进度条：贴胶囊底部（3px，主题色） -->
                <ProgressBar Progress="{Binding MiniPlayerProgress}"
                             HeightRequest="3"
                             ProgressColor="{DynamicResource PrimaryColor}"
                             BackgroundColor="Transparent"
                             VerticalOptions="End"
                             HorizontalOptions="Fill"
                             Margin="0,0,0,-2" />
                </Grid>
            </Border>
        </Grid>

        <!-- 自定义底部 TabBar（4个Tab：播放/发现/歌单/音乐库），圆角悬浮胶囊（左右留白 18，底部悬浮 4） -->
        <Grid Grid.Row="2" x:Name="TabBar"
              Margin="18,0,18,4"
              SafeAreaEdges="None">

            <!-- 圆角胶囊容器：毛玻璃由内层 Border 圆角裁剪 -->
<Border StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{DynamicResource BottomBarStrokeColor}"
                    Background="Transparent">
                <Grid>
            <!-- 毛玻璃背景：封面图模糊做底，透出下层内容感 -->
            <controls:FrostedBackground x:Name="TabBarFrosted"
                                        Source="{Binding CoverImage}"
                                        IsActive="True"
                                        IsVisible="True"
                                        TintOpacity="0.5"
                                        DimAmount="0.3"
                                        TintColor="{DynamicResource TabBarGlassTint}"
                                        Opacity="0.85"
                                        UseNativeBlur="True"
                                        Aspect="AspectFill"
                                        InputTransparent="True" />
            <!-- 半透明底色保底（毛玻璃下面的基础色，确保分层清晰） -->
            <BoxView Color="{DynamicResource CardBackgroundColor}" InputTransparent="True" Opacity="0.6" />

            <Grid ColumnDefinitions="*,*,*,*"
                  Padding="4,0,4,0"
                  Background="Transparent">

                <Grid Grid.Column="0" x:Name="TabItem0"
                      HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Grid.Behaviors>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" />
                    </Grid.GestureRecognizers>
                    <!-- 选中高亮胶囊背景（code-behind 控制） -->
                    <Border x:Name="TabBg0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent"
                            Margin="4,3,4,3" />
                    <VerticalStackLayout x:Name="TabContent0" Spacing="4" Margin="0,6,0,6" HorizontalOptions="Center" VerticalOptions="Center">
                        <ImageButton WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"
                                     x:Name="TabIcon0"
                                     Source="ic_play"
                                     BackgroundColor="Transparent"
                                     BorderWidth="0"
                                     Padding="0"
                                     InputTransparent="True" />
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabPlaying]}" FontSize="10" HorizontalTextAlignment="Center" x:Name="TabLabel0" />
                    </VerticalStackLayout>
                </Grid>

                <Grid Grid.Column="1" x:Name="TabItem1"
                      HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Grid.Behaviors>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" />
                    </Grid.GestureRecognizers>
                    <!-- 选中高亮胶囊背景（code-behind 控制） -->
                    <Border x:Name="TabBg1"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent"
                            Margin="4,3,4,3" />
                    <VerticalStackLayout x:Name="TabContent1" Spacing="4" Margin="0,6,0,6" HorizontalOptions="Center" VerticalOptions="Center">
                        <ImageButton WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"
                                     x:Name="TabIcon1"
                                     Source="ic_home"
                                     BackgroundColor="Transparent"
                                     BorderWidth="0"
                                     Padding="0"
                                     InputTransparent="True" />
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabDiscover]}" FontSize="10" HorizontalTextAlignment="Center" x:Name="TabLabel1" />
                    </VerticalStackLayout>
                </Grid>

                <Grid Grid.Column="2" x:Name="TabItem2"
                      HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Grid.Behaviors>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" />
                    </Grid.GestureRecognizers>
                    <!-- 选中高亮胶囊背景（code-behind 控制） -->
                    <Border x:Name="TabBg2"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent"
                            Margin="4,3,4,3" />
                    <VerticalStackLayout x:Name="TabContent2" Spacing="4" Margin="0,6,0,6" HorizontalOptions="Center" VerticalOptions="Center">
                        <ImageButton WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"
                                     x:Name="TabIcon2"
                                     Source="ic_playlist"
                                     BackgroundColor="Transparent"
                                     BorderWidth="0"
                                     Padding="0"
                                     InputTransparent="True" />
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabPlaylists]}" FontSize="10" HorizontalTextAlignment="Center" x:Name="TabLabel2" />
                    </VerticalStackLayout>
                </Grid>

                <Grid Grid.Column="3" x:Name="TabItem3"
                      HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Grid.Behaviors>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" />
                    </Grid.GestureRecognizers>
                    <!-- 选中高亮胶囊背景（code-behind 控制） -->
                    <Border x:Name="TabBg3"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent"
                            Margin="4,3,4,3" />
                    <VerticalStackLayout x:Name="TabContent3" Spacing="4" Margin="0,6,0,6" HorizontalOptions="Center" VerticalOptions="Center">
                        <ImageButton WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"
                                     x:Name="TabIcon3"
                                     Source="ic_library"
                                     BackgroundColor="Transparent"
                                     BorderWidth="0"
                                     Padding="0"
                                     InputTransparent="True" />
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabLibrary]}" FontSize="10" HorizontalTextAlignment="Center" x:Name="TabLabel3" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 启动加载页：纯文字品牌 Splash Screen -->
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="3"
              Background="{DynamicResource PageBackgroundBrush}"
              IsVisible="False"
              InputTransparent="False"
              ZIndex="999">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[AppName]}"
                       FontSize="42"
                       FontFamily="OpenSansSemibold"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       HorizontalOptions="Center" />
                <Label Text="CatClaw Music"
                       FontSize="16"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       HorizontalOptions="Center" />
                <ActivityIndicator IsRunning="True"
                                   Color="{DynamicResource PrimaryColor}"
                                   WidthRequest="36" HeightRequest="36"
                                   Margin="0,32,0,0" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>

