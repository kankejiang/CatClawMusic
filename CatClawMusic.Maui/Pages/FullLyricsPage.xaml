<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             x:Class="CatClawMusic.Maui.Pages.FullLyricsPage"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[PageTitleFullLyrics]}"
             BackgroundColor="Transparent"
             Shell.NavBarIsVisible="False">

    <Grid x:Name="RootGrid">

        <!-- 雾面动态背景层（铺满整个页面） -->
        <controls:FrostedBackground x:Name="FrostedBg"
                                    IsActive="{Binding IsPlaying}"
                                    IsScrolling="{Binding IsUserScrolling}"
                                    IsVisible="{DynamicResource FrostedBackgroundEnabled}"
                                    TintColor="{Binding CoverTintColor}"
                                    TintOpacity="0.60"
                                    DimAmount="0.12"
                                    CoverSource="{Binding CoverFlowSource}"
                                    InputTransparent="True" />

        <!-- 无全屏暗色遮罩：文字可读性由 FrostedBackground 封面流上方的 Halcyon 镜面 scrim 保证（对比 NowPlayingPage） -->

        <!-- ═══ 竖屏内容：顶部 HeroCard + 全宽歌词 ═══ -->
        <Grid x:Name="PortraitContent" RowDefinitions="Auto,*">

            <controls:HeroCard Grid.Row="0"
                               ShowBackButton="False">
                <controls:HeroCard.CardContent>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="12">
                        <Border Grid.Column="0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="40" HeightRequest="40"
                                VerticalOptions="Center">
                            <ImageButton Source="{Binding CoverImage}"
                                         Aspect="AspectFill"
                                         BackgroundColor="Transparent"
                                         CornerRadius="10"
                                         HorizontalOptions="Fill" VerticalOptions="Fill"
                                         Clicked="OnBackClicked" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="{Binding Title}"
                                   FontSize="16"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="White"
                                   MaxLines="1" />
                            <Label Text="{Binding Artist}"
                                   FontSize="12"
                                   TextColor="#F3F5FF"
                                   MaxLines="1" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2"
                                BackgroundColor="#24FFFFFF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,4"
                                VerticalOptions="Center">
                            <Label Text="LRC"
                                   FontSize="10"
                                   TextColor="White" />
                        </Border>
                        <Button Grid.Column="3"
                                Text="&#x2699;"
                                FontSize="18"
                                BackgroundColor="#24FFFFFF"
                                TextColor="White"
                                CornerRadius="18"
                                WidthRequest="36" HeightRequest="36"
                                Padding="0"
                                VerticalOptions="Center"
                                Clicked="OnLyricsSettingsClicked" />
                    </Grid>
                </controls:HeroCard.CardContent>
            </controls:HeroCard>

            <!-- 歌词区：自绘静态堆叠 + 整体平移滚动（复刻 Windows/播放页方案，当前行恒钉 1/3 处） -->
            <Grid Grid.Row="1"
                  x:Name="LyricClip"
                  IsClippedToBounds="True">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLyricsAreaTapped" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout x:Name="LyricStack"
                                     Padding="30,10,30,10"
                                     Spacing="14"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Start" />
            </Grid>

            <Border Grid.Row="1"
                    x:Name="NoLyricsBadge"
                    Margin="20,0"
                    VerticalOptions="End"
                    Style="{StaticResource GlassBadgeStyle}"
                    IsVisible="{Binding HasLyrics, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{Binding NoLyricsText}"
                       FontSize="14"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       HorizontalTextAlignment="Center" />
            </Border>
        </Grid>

        <!-- ═══ 横屏内容：左封面 + 右歌词（删除顶部卡片） ═══ -->
        <Grid x:Name="LandscapeContent"
              IsVisible="False"
              ColumnDefinitions="1*,1.15*"
              ColumnSpacing="32"
              Padding="12,0,48,0">

            <!-- 左：封面（正方形，顶部贴状态栏下方，左边距=状态栏高度+5px，底部贴底部安全区上方） -->
            <Grid Grid.Column="0"
                  HorizontalOptions="Fill" VerticalOptions="Fill">
                <!-- 封面辉光（模糊投影）- 底层 -->
                <Border x:Name="LandscapeCoverGlow"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        BackgroundColor="Transparent"
                        Opacity="0.35"
                        Scale="1.08"
                        TranslationY="10"
                        HorizontalOptions="Start" VerticalOptions="Start" />
                <!-- 封面本体 - 上层 -->
                <Border x:Name="LandscapeCover"
                        StrokeThickness="0.5"
                        Stroke="#30FFFFFF"
                        StrokeShape="RoundRectangle 28"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start" VerticalOptions="Start">
                    <Image x:Name="LandscapeCoverImage"
                           Source="{Binding CoverImage}"
                           Aspect="AspectFill" />
                </Border>
            </Grid>

            <!-- 右：歌词（占满剩余高度，无顶部卡片） -->
            <Grid Grid.Column="1"
                  RowDefinitions="*,Auto"
                  RowSpacing="0"
                  VerticalOptions="Fill">

                <!-- 歌词区域（占满剩余空间） -->
                <!-- 歌词区：自绘静态堆叠 + 整体平移滚动（横屏版） -->
                <Grid Grid.Row="0"
                      x:Name="LandscapeLyricClip"
                      IsClippedToBounds="True">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLyricsAreaTapped" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout x:Name="LandscapeLyricStack"
                                         Padding="12,10,12,10"
                                         Spacing="14"
                                         HorizontalOptions="Fill"
                                         VerticalOptions="Start" />
                </Grid>

                <!-- 无歌词提示 -->
                <Border Grid.Row="0"
                        x:Name="LandscapeNoLyricsBadge"
                        Margin="20,0"
                        VerticalOptions="End"
                        Style="{StaticResource GlassBadgeStyle}"
                        IsVisible="{Binding HasLyrics, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="{Binding NoLyricsText}"
                           FontSize="14"
                           TextColor="{DynamicResource TextSecondaryColor}"
                           HorizontalTextAlignment="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- 歌词设置弹窗（预定义，默认隐藏） -->
        <controls:AppPopup x:Name="LyricsSettingsPopup"
                           Title="歌词设置"
                           CloseOnMaskTapped="True" />
    </Grid>
</ContentPage>
