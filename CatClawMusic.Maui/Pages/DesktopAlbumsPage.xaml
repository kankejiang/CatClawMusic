<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:converters="clr-namespace:CatClawMusic.Maui.Converters"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             x:Class="CatClawMusic.Maui.Pages.DesktopAlbumsPage"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabAlbums]}"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <ContentPage.Resources>
        <converters:InitialConverter x:Key="InitialConverter" />
        <converters:CoverArtConverter x:Key="CoverArtConverter" />
        <converters:PlaceholderColorConverter x:Key="PlaceholderColorConverter" />
        <converters:PlaybackCountConverter x:Key="PlaybackCountConverter" />
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <!-- 横屏左右布局：左侧控件面板（返回/标题/搜索/筛选/排序/视图切换） + 右侧专辑网格 -->
    <Grid ColumnDefinitions="280,*"
          Background="{DynamicResource PageBackgroundBrush}">

        <!-- Frosted glass background -->
        <controls:FrostedBackground Grid.ColumnSpan="2"
            Source="{DynamicResource ThemeBackgroundImage}"
            IsActive="{DynamicResource ThemeBackgroundEnabled}"
            IsVisible="{DynamicResource ThemeBackgroundEnabled}"
            TintColor="{DynamicResource TabBarGlassTint}"
            TintOpacity="0.45"
            DimAmount="0.25"
            Opacity="0.8"
            Aspect="AspectFill"
            UseNativeBlur="True"
            InputTransparent="True" />

        <!-- ═══ 左侧控件面板 ═══ -->
        <Border Grid.Column="0"
                StrokeThickness="0"
                Stroke="{DynamicResource DividerColor}"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                Margin="0,0,1,0">
            <ScrollView Padding="16,12" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="14">

                    <!-- 返回按钮 + 标题 + 统计 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Grid.Column="0" WidthRequest="32" HeightRequest="32"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                                Stroke="{DynamicResource GlassStrokeColor}"
                                StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </Border.GestureRecognizers>
                            <Image Source="ic_arrow_left.svg"
                                   WidthRequest="16" HeightRequest="16"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" HorizontalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabAlbums]}"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label FontSize="11" TextColor="{DynamicResource TextHintColor}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding TotalAlbums}" FontAttributes="Bold" TextColor="{DynamicResource AccentColor}" />
                                        <Span Text=" 张 · " />
                                        <Span Text="{Binding TotalSongs}" FontAttributes="Bold" TextColor="{DynamicResource AccentColor}" />
                                        <Span Text=" 首" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 搜索框 -->
                    <Border Padding="10,0,12,0"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{DynamicResource GlassStrokeColor}"
                            BackgroundColor="{DynamicResource CardBackgroundStrongColor}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                            <Image Source="ic_search.svg" WidthRequest="14" HeightRequest="14" />
                            <Entry Grid.Column="1"
                                   Placeholder="搜索专辑或艺术家"
                                   Text="{Binding SearchQuery}"
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   PlaceholderColor="{DynamicResource TextHintColor}"
                                   VerticalOptions="Center"
                                   Margin="6,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- 视图切换（网格/列表） -->
                    <Border StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{DynamicResource GlassStrokeColor}"
                            BackgroundColor="{DynamicResource CardBackgroundStrongColor}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="0">
                            <Border Grid.Column="0" HeightRequest="30"
                                    BackgroundColor="{Binding GridButtonColor}"
                                    StrokeShape="RoundRectangle 10,0,0,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnViewToggleTapped" />
                                </Border.GestureRecognizers>
                                <Image Source="ic_grid.svg" WidthRequest="14" HeightRequest="14"
                                       Aspect="AspectFit"
                                       VerticalOptions="Center" HorizontalOptions="Center" />
                            </Border>
                            <Border Grid.Column="1" HeightRequest="30"
                                    BackgroundColor="{Binding ListButtonColor}"
                                    StrokeShape="RoundRectangle 0,10,10,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnViewToggleTapped" />
                                </Border.GestureRecognizers>
                                <Image Source="ic_list.svg" WidthRequest="14" HeightRequest="14"
                                       Aspect="AspectFit"
                                       VerticalOptions="Center" HorizontalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 筛选标签 -->
                    <Label Text="筛选" FontSize="11" FontAttributes="Bold"
                           TextColor="{DynamicResource TextHintColor}"
                           CharacterSpacing="2" Margin="0,4,0,0" />

                    <!-- 筛选 chips（垂直排列） -->
                    <VerticalStackLayout Spacing="6" x:Name="FilterChips"
                                         BindableLayout.ItemsSource="{Binding SourceFilters}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="11,8"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="1"
                                        BackgroundColor="{Binding BackgroundColor}"
                                        Stroke="{Binding BorderColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFilterChipTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}"
                                           FontSize="12"
                                           TextColor="{Binding TextColor}"
                                           HorizontalOptions="Start" VerticalOptions="Center" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- 排序标签 -->
                    <Label Text="排序" FontSize="11" FontAttributes="Bold"
                           TextColor="{DynamicResource TextHintColor}"
                           CharacterSpacing="2" Margin="0,4,0,0" />

                    <!-- 排序按钮（垂直排列） -->
                    <VerticalStackLayout Spacing="6" x:Name="SortButtons"
                                         BindableLayout.ItemsSource="{Binding SortOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="11,8"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="1"
                                        Stroke="{Binding BorderColor}"
                                        BackgroundColor="{Binding BackgroundColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSortChipTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}"
                                           FontSize="12"
                                           TextColor="{Binding TextColor}"
                                           HorizontalOptions="Start" VerticalOptions="Center" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- 年代快捷导航（左侧底部常驻，便于跳转） -->
                    <VerticalStackLayout Spacing="6" Margin="0,6,0,0"
                                         IsVisible="{Binding IsGridView}">
                        <Label Text="年代" FontSize="11" FontAttributes="Bold"
                               TextColor="{DynamicResource TextHintColor}"
                               CharacterSpacing="2" />
                        <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start"
                                    BindableLayout.ItemsSource="{Binding EraRailItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,4,4"
                                            Padding="8,5"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="0"
                                            BackgroundColor="{Binding BackgroundColor}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEraTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}"
                                               FontSize="10"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{Binding TextColor}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- ═══ 右侧专辑网格/列表 ═══ -->
        <Grid Grid.Column="1" ColumnDefinitions="*" Padding="12,10,12,10">

            <!-- 网格视图 -->
            <CollectionView Grid.Column="0"
                            x:Name="GridCollectionView"
                            ItemsSource="{Binding EraGroups}"
                            IsGrouped="True"
                            SelectionMode="None"
                            IsVisible="{Binding IsGridView}"
                            Margin="0,2,0,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="8" HorizontalItemSpacing="8" VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Spacing="6" Padding="0,6,0,4">
                            <Label Text="{Binding Era}"
                                   FontSize="11.5"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{DynamicResource TextSecondaryColor}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding Count, StringFormat='{0} 张'}"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextHintColor}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAlbumTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Border StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding Id, Converter={StaticResource PlaceholderColorConverter}}">
                                    <Grid>
                                        <Image Source="{Binding CoverArtPath}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}}" />
                                        <Label Text="{Binding Title, Converter={StaticResource InitialConverter}}"
                                               FontSize="26"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="#99FFFFFF"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}, ConverterParameter=invert}" />
                                    </Grid>
                                </Border>
                                <Label Text="{Binding Title}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />
                                <Label Text="{Binding ArtistName}"
                                       FontSize="10"
                                       TextColor="{DynamicResource TextHintColor}"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SongCount, StringFormat='{0} 首'}"
                                       FontSize="9.5"
                                       TextColor="{DynamicResource TextHintColor}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 列表视图 -->
            <CollectionView Grid.Column="0"
                            x:Name="ListCollectionView"
                            ItemsSource="{Binding FilteredAlbums}"
                            SelectionMode="None"
                            IsVisible="{Binding IsGridView, Converter={StaticResource InvertedBoolConverter}}"
                            Margin="0,2,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,5"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                BackgroundColor="Transparent"
                                Margin="0,0,0,2">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAlbumTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">
                                <Border Grid.Column="0"
                                        WidthRequest="42" HeightRequest="42"
                                        StrokeShape="RoundRectangle 9"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding Id, Converter={StaticResource PlaceholderColorConverter}}">
                                    <Grid>
                                        <Image Source="{Binding CoverArtPath}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}}" />
                                        <Label Text="{Binding Title, Converter={StaticResource InitialConverter}}"
                                               FontSize="16"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="#DDFFFFFF"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}, ConverterParameter=invert}" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="1">
                                    <Label Text="{Binding Title}"
                                           FontSize="13"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{DynamicResource TextPrimaryColor}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding ArtistName, StringFormat='{0} · '}"
                                           FontSize="10.5"
                                           TextColor="{DynamicResource TextHintColor}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="2"
                                                       VerticalOptions="Center"
                                                       Spacing="3">
                                    <Ellipse WidthRequest="6" HeightRequest="6"
                                             Fill="#55D6FF" />
                                    <Label Text="{Binding SongCount, StringFormat='{0} 首'}"
                                           FontSize="10.5"
                                           TextColor="{DynamicResource TextHintColor}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- 加载指示器 -->
        <ActivityIndicator Grid.Column="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{DynamicResource PrimaryColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
