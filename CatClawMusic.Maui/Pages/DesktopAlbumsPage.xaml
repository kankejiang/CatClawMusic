<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CatClawMusic.Maui.ViewModels"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:helpers="clr-namespace:CatClawMusic.Maui.Helpers"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             xmlns:data="clr-namespace:CatClawMusic.Data;assembly=CatClawMusic.Data"
             x:Class="CatClawMusic.Maui.Pages.DesktopAlbumsPage"
             x:DataType="vm:AlbumsViewModel"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabAlbums]}"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <!-- 横屏左右布局：左侧控件面板 + 右侧专辑网格/列表 -->
    <Grid ColumnDefinitions="280,*"
          Background="{DynamicResource PageBackgroundBrush}">

        <!-- ═══ 左侧控件面板 ═══ -->
        <Border Grid.Column="0"
                StrokeThickness="0"
                Stroke="{DynamicResource DividerColor}"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                Margin="0,0,1,0">
            <ScrollView Padding="16,12" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="14">

                    <!-- 返回按钮 + 标题 + 统计 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Grid.Column="0" WidthRequest="32" HeightRequest="32"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                                Stroke="{DynamicResource GlassStrokeColor}"
                                StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </Border.GestureRecognizers>
                            <Image Source="{helpers:ThemedIcon Light=ic_arrow_left_light, Dark=ic_arrow_left}"
                                   WidthRequest="16" HeightRequest="16"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" HorizontalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabAlbums]}"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label FontSize="11" TextColor="{DynamicResource TextHintColor}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="共 " />
                                        <Span Text="{Binding TotalAlbums}" FontAttributes="Bold" TextColor="{DynamicResource AccentColor}" />
                                        <Span Text=" 张" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 搜索框 -->
                    <controls:PageSearchBox Placeholder="搜索专辑或艺术家"
                                            FontSize="13"
                                            CornerRadius="10"
                                            SearchQuery="{Binding SearchQuery, Mode=TwoWay}" />

                    <!-- 视图切换（网格/列表） -->
                    <controls:ViewToggleButton IsGridView="{Binding IsGridView, Mode=TwoWay}"
                                               HorizontalOptions="Start" />

                    <!-- 筛选标签 -->
                    <Label Text="筛选" FontSize="11" FontAttributes="Bold"
                           TextColor="{DynamicResource TextHintColor}"
                           CharacterSpacing="2" Margin="0,4,0,0" />

                    <!-- 筛选 chips（两列网格排列） -->
                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding SourceFilters}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlbumsViewModel+FilterChip">
                                <Border WidthRequest="124"
                                        Margin="0,0,6,6"
                                        Padding="11,7"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="1"
                                        Stroke="{Binding BorderColor}"
                                        BackgroundColor="{Binding BackgroundColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFilterChipTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}"
                                           FontSize="12"
                                           TextColor="{Binding TextColor}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- 排序标签 -->
                    <Label Text="排序" FontSize="11" FontAttributes="Bold"
                           TextColor="{DynamicResource TextHintColor}"
                           CharacterSpacing="2" />

                    <!-- 排序 chips（两列网格排列） -->
                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding SortOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlbumsViewModel+SortOption">
                                <Border WidthRequest="124"
                                        Margin="0,0,6,6"
                                        Padding="11,7"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="1"
                                        Stroke="{Binding BorderColor}"
                                        BackgroundColor="{Binding BackgroundColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSortChipTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}"
                                           FontSize="12"
                                           TextColor="{Binding TextColor}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- A-Z 字母索引（左侧底部常驻，便于跳转） -->
                    <VerticalStackLayout Spacing="6" Margin="0,6,0,0">
                        <Label Text="字母索引" FontSize="11" FontAttributes="Bold"
                               TextColor="{DynamicResource TextHintColor}"
                               CharacterSpacing="2" />
                        <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start"
                                    BindableLayout.ItemsSource="{Binding LetterRailItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlbumsViewModel+LetterRailItem">
                                    <Border Margin="0,0,4,4"
                                            Padding="8,5"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="0"
                                            BackgroundColor="{Binding BackgroundColor}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnLetterTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}"
                                               FontSize="10"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{Binding TextColor}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- ═══ 右侧专辑网格/列表 + 字母 rail ═══ -->
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Padding="12,10,12,10" ColumnSpacing="8">

            <!-- 网格视图：4 列布局 -->
            <CollectionView Grid.Column="0"
                            x:Name="GridCollectionView"
                            ItemsSource="{Binding FilteredAlbums}"
                            SelectionMode="None"
                            IsVisible="{Binding IsGridView}"
                            Margin="0,2,0,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:AlbumWithCount">
                        <Border StrokeThickness="0"
                                BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAlbumTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Border StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding Id, Converter={StaticResource PlaceholderColorConverter}}">
                                    <Grid>
                                        <Image Source="{Binding CoverArtPath}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}}" />
                                        <Label Text="{Binding Title, Converter={StaticResource InitialConverter}}"
                                               FontSize="30"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="#DDFFFFFF"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}, ConverterParameter=invert}" />
                                    </Grid>
                                </Border>
                                <Label Text="{Binding Title}"
                                       FontSize="12.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label FontSize="10.5"
                                       TextColor="{DynamicResource TextHintColor}"
                                       LineBreakMode="TailTruncation" MaxLines="1">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} · {1} 首">
                                            <Binding Path="ArtistName" />
                                            <Binding Path="SongCount" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="没有匹配的专辑" FontSize="13"
                           TextColor="{DynamicResource TextHintColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,40" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- 列表视图 -->
            <CollectionView Grid.Column="0"
                            x:Name="ListCollectionView"
                            ItemsSource="{Binding FilteredAlbums}"
                            SelectionMode="None"
                            IsVisible="{Binding IsGridView, Converter={StaticResource InvertedBoolConverter}}"
                            Margin="0,2,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:AlbumWithCount">
                                <Border Padding="8,5"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        Margin="0,0,0,2">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAlbumTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">
                                <Border Grid.Column="0"
                                        WidthRequest="42" HeightRequest="42"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding Id, Converter={StaticResource PlaceholderColorConverter}}">
                                    <Grid>
                                        <Image Source="{Binding CoverArtPath}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}}" />
                                        <Label Text="{Binding Title, Converter={StaticResource InitialConverter}}"
                                               FontSize="18"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="#DDFFFFFF"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding CoverArtPath, Converter={StaticResource CoverArtConverter}, ConverterParameter=invert}" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="1">
                                    <Label Text="{Binding Title}"
                                           FontSize="13"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{DynamicResource TextPrimaryColor}"
                                           LineBreakMode="TailTruncation" />
                                    <Label FontSize="10.5"
                                           TextColor="{DynamicResource TextHintColor}"
                                           LineBreakMode="TailTruncation">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} · {1} 首">
                                                <Binding Path="ArtistName" />
                                                <Binding Path="SongCount" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding Year}"
                                       FontSize="10.5"
                                       TextColor="{DynamicResource TextHintColor}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="⋮" FontSize="16" VerticalOptions="Center"
                                       TextColor="{DynamicResource TextHintColor}"
                                       Padding="4,0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAlbumMoreTapped" CommandParameter="{Binding}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="没有匹配的专辑" FontSize="13"
                           TextColor="{DynamicResource TextHintColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,40" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- 字母 rail -->
            <ScrollView Grid.Column="1" VerticalOptions="Start" Margin="0,2,0,0">
                <VerticalStackLayout Spacing="1" x:Name="LetterRail"
                                     BindableLayout.ItemsSource="{Binding LetterRailItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlbumsViewModel+LetterRailItem">
                            <Border WidthRequest="18"
                                    HeightRequest="18"
                                    StrokeShape="RoundRectangle 5"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding BackgroundColor}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLetterTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}"
                                       FontSize="9"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{Binding TextColor}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- 加载指示器 -->
        <ActivityIndicator Grid.Column="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{DynamicResource PrimaryColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" />

        <!-- 专辑更多操作弹窗 -->
        <controls:AppPopup x:Name="AlbumMorePopup" Title="专辑操作" CloseOnMaskTapped="True" />
    </Grid>
</ContentPage>
