<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             x:Class="CatClawMusic.Maui.Pages.DesktopSettingsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20,14,20,18" Spacing="10">

            <!-- Hero Header -->
            <Border Style="{StaticResource GlassCardStrongStyle}"
                    Background="{DynamicResource HeroBrush}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings]}"
                               Style="{StaticResource PageTitleStyle}"
                               TextColor="White" />
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[SettingsSubtitle]}"
                               Style="{StaticResource PageSubtitleStyle}"
                               TextColor="#F2F4FF" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            Style="{StaticResource GlassIconContainerStyle}"
                            BackgroundColor="#24FFFFFF"
                            Stroke="{DynamicResource GlassStrokeColor}"
                            VerticalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDarkModeToggleClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="{Binding DarkModeIcon}"
                               WidthRequest="36" HeightRequest="36"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ Section: 内容与服务（双列） ═══ -->
            <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ContentAndServices]}"
                   Style="{StaticResource SectionTitleStyle}"
                   Margin="4,4,0,0" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <!-- 左列 -->
                <VerticalStackLayout Spacing="10">
                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid Padding="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Source="{AppThemeBinding Light=ic_edit_light, Dark=ic_edit}" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" Opacity="0.8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Appearance]}" FontSize="14" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[AppearanceDesc]}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="{AppThemeBinding Light=ic_arrow_forward_light, Dark=ic_arrow_forward}"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="0.5" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAppearanceSettingsClicked" /></Border.GestureRecognizers>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" IsVisible="{OnPlatform Default=false, Android=true}">
                        <Grid Padding="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Source="{AppThemeBinding Light=ic_lyrics_light, Dark=ic_lyrics}" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" Opacity="0.8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[PageTitleDesktopLyric]}" FontSize="14" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[DesktopLyricDesc]}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="{AppThemeBinding Light=ic_arrow_forward_light, Dark=ic_arrow_forward}"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="0.5" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDesktopLyricClicked" /></Border.GestureRecognizers>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid Padding="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Source="{AppThemeBinding Light=ic_folder_light, Dark=ic_folder}" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" Opacity="0.8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[LocalMusic]}" FontSize="14" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding LocalMusicStatus}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="{AppThemeBinding Light=ic_arrow_forward_light, Dark=ic_arrow_forward}"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="0.5" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnLocalMusicClicked" /></Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>

                <!-- 右列 -->
                <VerticalStackLayout Grid.Column="1" Spacing="10">
                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid Padding="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Source="{AppThemeBinding Light=ic_search_light, Dark=ic_search}" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" Opacity="0.8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[RemoteMusic]}" FontSize="14" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding RemoteMusicStatus}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="{AppThemeBinding Light=ic_arrow_forward_light, Dark=ic_arrow_forward}"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="0.5" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRemoteMusicClicked" /></Border.GestureRecognizers>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid Padding="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Source="{AppThemeBinding Light=ic_equalizer_light, Dark=ic_equalizer}" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" Opacity="0.8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Plugins]}" FontSize="14" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding PluginStatus}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="{AppThemeBinding Light=ic_arrow_forward_light, Dark=ic_arrow_forward}"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="0.5" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPluginManagementClicked" /></Border.GestureRecognizers>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid Padding="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Source="{AppThemeBinding Light=ic_play_light, Dark=ic_play}" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" Opacity="0.8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ExploreSettings]}" FontSize="14" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding AiStatus}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="{AppThemeBinding Light=ic_arrow_forward_light, Dark=ic_arrow_forward}"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="0.5" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAiSettingsClicked" /></Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- ═══ Section: 系统与维护（双列） ═══ -->
            <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[SystemAndMaintenance]}"
                   Style="{StaticResource SectionTitleStyle}"
                   Margin="4,6,0,0" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <!-- 左列 -->
                <VerticalStackLayout Spacing="10">
                    <Border Style="{StaticResource GlassCardStyle}" IsVisible="{OnPlatform Default=false, Android=true}">
                        <Grid Padding="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Source="{AppThemeBinding Light=ic_lock_locked_light, Dark=ic_lock_locked}" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" Opacity="0.8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Permissions]}" FontSize="14" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding PermissionStatus}" FontSize="11" TextColor="{Binding PermissionStatusColor}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="{AppThemeBinding Light=ic_arrow_forward_light, Dark=ic_arrow_forward}"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="0.5" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPermissionManagementClicked" /></Border.GestureRecognizers>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid Padding="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Source="{AppThemeBinding Light=ic_settings_light, Dark=ic_settings}" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" Opacity="0.8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[GeneralSettings]}" FontSize="14" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[GeneralSettingsDesc]}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="{AppThemeBinding Light=ic_arrow_forward_light, Dark=ic_arrow_forward}"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="0.5" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnGeneralSettingsClicked" /></Border.GestureRecognizers>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid Padding="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Source="{AppThemeBinding Light=ic_info_light, Dark=ic_info}" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" Opacity="0.8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="诊断日志" FontSize="14" FontFamily="OpenSansSemibold" />
                                <Label Text="开关开启后实时记录运行日志" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" x:Name="DiagnosticLogSwitch"
                                    Toggled="OnDiagnosticLogToggled" VerticalOptions="Center" Scale="0.85" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDiagnosticLogClicked" /></Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>

                <!-- 右列 -->
                <VerticalStackLayout Grid.Column="1" Spacing="10">
                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid Padding="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <Image Source="{AppThemeBinding Light=ic_folder_light, Dark=ic_folder}" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" Opacity="0.8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[BackupRestore]}" FontSize="14" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[BackupRestoreDesc]}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="2" WidthRequest="8" HeightRequest="8"
                                     Color="{DynamicResource ErrorColor}"
                                     IsVisible="{Binding IsUpdateAvailable}"
                                     VerticalOptions="Center" />
                            <Image Grid.Column="3" Source="{AppThemeBinding Light=ic_arrow_forward_light, Dark=ic_arrow_forward}"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="0.5" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackupRestoreClicked" /></Border.GestureRecognizers>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid Padding="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <Image Source="{AppThemeBinding Light=ic_check_light, Dark=ic_check}" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" Opacity="0.8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[About]}" FontSize="14" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[AboutDesc]}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="2" WidthRequest="8" HeightRequest="8"
                                     Color="{DynamicResource ErrorColor}"
                                     IsVisible="{Binding IsUpdateAvailable}"
                                     VerticalOptions="Center" />
                            <Image Grid.Column="3" Source="{AppThemeBinding Light=ic_arrow_forward_light, Dark=ic_arrow_forward}"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="0.5" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAboutClicked" /></Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
