<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             x:Class="CatClawMusic.Maui.Pages.NowPlayingPage"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[PageTitleNowPlaying]}"
             BackgroundColor="Transparent"
             Shell.NavBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid>
        <!-- 雾面动态背景层（铺满整个页面，覆盖状态栏和导航栏区域） -->
        <controls:FrostedBackground x:Name="FrostedBg"
                                    Source="{Binding CoverImage}"
                                    CacheKey="{Binding CurrentCoverPath}"
                                    IsActive="{Binding IsPlaying}"
                                    IsScrolling="{Binding IsUserScrolling}"
                                    IsVisible="{DynamicResource FrostedBackgroundEnabled}"
                                    TintColor="{DynamicResource PrimaryColor}"
                                    TintOpacity="0.25"
                                    DimAmount="0.15"
                                    InputTransparent="True"
                                    Aspect="AspectFill" />

        <!-- 暗色遮罩层：在雾面背景上叠加一层半透明暗色，确保文字可读 -->
        <BoxView Color="#70000000" InputTransparent="True" />

        <!-- 内容层：3行Grid - 返回按钮/Auto, 主体/Star, 进度+控件/Auto -->
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,*,Auto"
              Padding="24,16,24,20">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPageTapped" />
            </Grid.GestureRecognizers>

            <!-- Row 0: 顶部导航栏（左侧歌曲信息 + 右上角窗口控件 + 右上角收起按钮） -->
            <Grid x:Name="TopNavBar"
                  Grid.Row="0"
                  ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                  HeightRequest="40">
                <!-- 歌曲信息（左侧） -->
                <Grid Grid.Column="0" ColumnDefinitions="Auto" VerticalOptions="Center">
                    <Grid Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="0">
                        <Label Grid.Row="0"
                               Text="{Binding Title}"
                               FontSize="14"
                               FontFamily="OpenSansSemibold"
                               TextColor="White"
                               MaxLines="1"
                               LineBreakMode="TailTruncation"
                               HorizontalTextAlignment="Start" />
                        <Label Grid.Row="1"
                               Text="{Binding Artist}"
                               FontSize="11"
                               TextColor="{DynamicResource TextSecondaryColor}"
                               Opacity="0.9"
                               MaxLines="1"
                               LineBreakMode="TailTruncation"
                               HorizontalTextAlignment="Start" />
                    </Grid>
                </Grid>

                <!-- 右上角窗口控制按钮（仅 Windows 端显示） -->
                <!-- 最小化按钮 -->
                <Border Grid.Column="1"
                        IsVisible="{OnPlatform Default=false, WinUI=true}"
                        WidthRequest="46" HeightRequest="40"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        HorizontalOptions="End" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMinimizeTapped" />
                    </Border.GestureRecognizers>
                    <Path WidthRequest="20" HeightRequest="20"
                          Data="M 4,10 L 16,10"
                          Stroke="White"
                          StrokeThickness="1.5"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- 最大化/还原按钮 -->
                <Border Grid.Column="2"
                        IsVisible="{OnPlatform Default=false, WinUI=true}"
                        WidthRequest="46" HeightRequest="40"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        HorizontalOptions="End" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMaximizeTapped" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Path x:Name="MaximizeIcon"
                              WidthRequest="20" HeightRequest="20"
                              Data="M 3,3 L 17,3 L 17,17 L 3,17 Z"
                              Stroke="White"
                              StrokeThickness="1.5"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              IsVisible="true" />
                        <Path x:Name="RestoreIcon"
                              WidthRequest="20" HeightRequest="20"
                              Data="M 3,6 L 14,6 L 14,17 L 3,17 Z M 6,3 L 17,3 L 17,14 L 14,14 L 14,6 L 6,6 Z"
                              Stroke="White"
                              StrokeThickness="1.5"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              IsVisible="false" />
                    </Grid>
                </Border>

                <!-- 关闭按钮 -->
                <Border Grid.Column="3"
                        IsVisible="{OnPlatform Default=false, WinUI=true}"
                        WidthRequest="46" HeightRequest="40"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        HorizontalOptions="End" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseTapped" />
                    </Border.GestureRecognizers>
                    <Path WidthRequest="20" HeightRequest="20"
                          Data="M 4,4 L 16,16 M 4,16 L 16,4"
                          Stroke="White"
                          StrokeThickness="1.5"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- 右上角收起按钮（向下箭头，点击收起播放页；Windows端同时承担返回功能） -->
                <Border Grid.Column="4"
                        x:Name="CollapseButton"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        WidthRequest="44" HeightRequest="44"
                        HorizontalOptions="End" VerticalOptions="Center"
                        ZIndex="10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCollapseButtonTapped" />
                    </Border.GestureRecognizers>
                    <Image x:Name="CollapseIcon"
                           WidthRequest="22" HeightRequest="22"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Row 1: 主体内容 -->
            <!-- 2行3列 Grid：手机用上下布局(跨列)，桌面用左右布局(跨行) -->
            <Grid Grid.Row="1"
                  x:Name="MainContent"
                  RowDefinitions="Auto,*"
                  ColumnDefinitions="1*,Auto,1*"
                  Padding="0,8,0,4">

                <!-- 封面（位置由代码后台根据屏幕方向动态设置） -->
                <Grid Grid.Row="0"
                      Grid.Column="0"
                      Grid.RowSpan="1"
                      Grid.ColumnSpan="3"
                      x:Name="LeftHalf"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      Padding="0,0">
                    <!-- 封面容器：辉光投影层与封面本体层重叠，居中显示，整体下移 -->
                    <Grid HorizontalOptions="Center" VerticalOptions="Center"
                          TranslationY="16">
                        <!-- 封面辉光（模糊投影）- 底层 -->
                        <Border x:Name="CoverGlow"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 28"
                                BackgroundColor="Transparent"
                                WidthRequest="286"
                                HeightRequest="286"
                                Opacity="0.35"
                                Scale="1.08"
                                TranslationY="10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        <!-- 封面本体 - 上层 -->
                        <Border x:Name="CoverArea"
                                StrokeThickness="0.5"
                                Stroke="#30FFFFFF"
                                StrokeShape="RoundRectangle 28"
                                BackgroundColor="Transparent"
                                WidthRequest="286"
                                HeightRequest="286"
                                HorizontalOptions="Center">
                            <Image x:Name="ArtworkImage"
                                   Source="{Binding CoverImage}"
                                   Aspect="AspectFill"
                                   WidthRequest="286"
                                   HeightRequest="286" />
                        </Border>
                    </Grid>
                </Grid>


                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Grid.RowSpan="1"
                      Grid.ColumnSpan="3"
                      x:Name="RightHalf"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      Padding="16,0">
                    <Grid x:Name="LyricsContainer"
                          IsVisible="{Binding HasLyrics}"
                          IsClippedToBounds="True"
                          VerticalOptions="Fill"
                          HorizontalOptions="Fill">
                        <CollectionView x:Name="LyricCollectionView"
                                        ItemsSource="{Binding LyricPlaceholderItems}"
                                        SelectionMode="None"
                                        VerticalScrollBarVisibility="Never">
                            <CollectionView.Behaviors>
                                <controls:ScrollPerformanceBehavior />
                            </CollectionView.Behaviors>
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.Header>
                                <VerticalStackLayout x:Name="LyricStack"
                                                     Padding="0,10,0,10"
                                                     Spacing="8"
                                                     HorizontalOptions="Fill" />
                            </CollectionView.Header>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <BoxView HeightRequest="0" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                    <!-- 无歌词提示（当没有歌词时显示） -->
                    <Label x:Name="NoLyricsLabel"
                           Text="{Binding NoLyricsText}"
                           FontSize="13"
                           TextColor="{DynamicResource TextHintColor}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Opacity="0.6"
                           IsVisible="{Binding HasLyrics, Converter={StaticResource InvertedBoolConverter}}" />
                </Grid>
            </Grid>

            <!-- Row 2: 收藏按钮 + 进度条 + 播放控件 + 歌曲详情 -->
            <Grid x:Name="BottomControlsRoot"
                  Grid.Row="2"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  RowSpacing="6"
                  Margin="0,4,0,0">
                <!-- 收藏按钮（进度条右上方） -->
                <ImageButton Grid.Row="0"
                        WidthRequest="36" HeightRequest="36"
                        CornerRadius="18" Padding="6"
                        Aspect="AspectFit"
                        BackgroundColor="Transparent"
                        Source="{Binding LikeIconSourceWhite}"
                        Command="{Binding ToggleLikeCommand}"
                        HorizontalOptions="End" VerticalOptions="Center" />
                <!-- 进度条 -->
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="2">
                    <Slider x:Name="ProgressSlider"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            ThumbColor="White"
                            MinimumTrackColor="White"
                            MaximumTrackColor="#40FFFFFF"
                            HeightRequest="24"
                            DragStarted="OnSliderDragStarted"
                            DragCompleted="OnSliderDragCompleted" />
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                        <Label Text="{Binding CurrentTimeDisplay}"
                               FontSize="11"
                               TextColor="White"
                               Opacity="0.7" />
                        <Label Grid.Column="2"
                               Text="{Binding TotalTimeDisplay}"
                               FontSize="11"
                               TextColor="White"
                               Opacity="0.7" />
                    </Grid>
                </Grid>

                <!-- ═══ 竖屏播放控件：5个按钮等分居中 ═══ -->
                <Grid Grid.Row="2"
                      x:Name="PhoneControls"
                      IsVisible="True"
                      ColumnDefinitions="*,*,*,*,*"
                      HeightRequest="80"
                      VerticalOptions="End">
                    <!-- 播放模式 -->
                    <ImageButton Grid.Column="0" WidthRequest="40" HeightRequest="40"
                            CornerRadius="20" Padding="8"
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            Source="{Binding PlayModeIconSourceWhite}"
                            Command="{Binding CyclePlayModeCommand}"
                            HorizontalOptions="Center" VerticalOptions="Center" />
                    <!-- 上一首（增大30%） -->
                    <ImageButton Grid.Column="1" WidthRequest="52" HeightRequest="52"
                            CornerRadius="26" Padding="10"
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            Source="{Binding PlayPreviousIconSourceWhite}"
                            Command="{Binding PlayPreviousCommand}"
                            HorizontalOptions="Center" VerticalOptions="Center" />
                    <!-- 播放/暂停（增大30%） -->
                    <ImageButton Grid.Column="2" WidthRequest="73" HeightRequest="73"
                            CornerRadius="36" Padding="16"
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            Source="{Binding PlayPauseIconSourceWhite}"
                            Command="{Binding TogglePlayPauseCommand}"
                            HorizontalOptions="Center" VerticalOptions="Center" />
                    <!-- 下一首（增大30%） -->
                    <ImageButton Grid.Column="3" WidthRequest="52" HeightRequest="52"
                            CornerRadius="26" Padding="10"
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            Source="{Binding PlayNextIconSourceWhite}"
                            Command="{Binding PlayNextCommand}"
                            HorizontalOptions="Center" VerticalOptions="Center" />
                    <!-- 播放列表 -->
                    <ImageButton Grid.Column="4" WidthRequest="40" HeightRequest="40"
                            CornerRadius="20" Padding="8"
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            Source="{Binding PlaylistIconSource}"
                            Clicked="OnOpenPlaylistClicked"
                            HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>

                <!-- ═══ 横屏播放控件：左/中/右三栏 ═══ -->
                <Grid Grid.Row="2"
                      x:Name="DesktopControls"
                      IsVisible="False"
                      ColumnDefinitions="*,Auto,*"
                      HeightRequest="80"
                      VerticalOptions="End">

                    <!-- 左侧：歌曲信息 + 收藏 -->
                    <Grid Grid.Column="0" ColumnDefinitions="*,Auto" ColumnSpacing="8"
                          HorizontalOptions="Start" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                            <Label Text="{Binding Title}"
                                   FontSize="13" FontFamily="OpenSansSemibold"
                                   TextColor="White" MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Artist}"
                                   FontSize="11" TextColor="#CCFFFFFF" MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <ImageButton Grid.Column="1" WidthRequest="32" HeightRequest="32"
                                CornerRadius="16" Padding="6"
                                Aspect="AspectFit"
                                BackgroundColor="Transparent"
                                Source="{Binding LikeIconSourceWhite}"
                                Command="{Binding ToggleLikeCommand}"
                                HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>

                    <!-- 中间：播放控制按钮紧凑排列 -->
                    <Grid Grid.Column="1"
                          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="16"
                          HorizontalOptions="Center" VerticalOptions="Center">
                        <!-- 播放模式 -->
                        <ImageButton Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                CornerRadius="20" Padding="8"
                                Aspect="AspectFit"
                                BackgroundColor="Transparent"
                                Source="{Binding PlayModeIconSourceWhite}"
                                Command="{Binding CyclePlayModeCommand}"
                                HorizontalOptions="Center" VerticalOptions="Center" />
                        <!-- 上一首（增大30%） -->
                        <ImageButton Grid.Column="1" WidthRequest="52" HeightRequest="52"
                                CornerRadius="26" Padding="10"
                                Aspect="AspectFit"
                                BackgroundColor="Transparent"
                                Source="{Binding PlayPreviousIconSourceWhite}"
                                Command="{Binding PlayPreviousCommand}"
                                HorizontalOptions="Center" VerticalOptions="Center" />
                        <!-- 播放/暂停（增大30%） -->
                        <ImageButton Grid.Column="2" WidthRequest="73" HeightRequest="73"
                                CornerRadius="36" Padding="16"
                                Aspect="AspectFit"
                                BackgroundColor="Transparent"
                                Source="{Binding PlayPauseIconSourceWhite}"
                                Command="{Binding TogglePlayPauseCommand}"
                                HorizontalOptions="Center" VerticalOptions="Center" />
                        <!-- 下一首（增大30%） -->
                        <ImageButton Grid.Column="3" WidthRequest="52" HeightRequest="52"
                                CornerRadius="26" Padding="10"
                                Aspect="AspectFit"
                                BackgroundColor="Transparent"
                                Source="{Binding PlayNextIconSourceWhite}"
                                Command="{Binding PlayNextCommand}"
                                HorizontalOptions="Center" VerticalOptions="Center" />
                        <!-- 播放列表 -->
                        <ImageButton Grid.Column="4" WidthRequest="40" HeightRequest="40"
                                CornerRadius="20" Padding="8"
                                Aspect="AspectFit"
                                BackgroundColor="Transparent"
                                Source="{Binding PlaylistIconSource}"
                                Clicked="OnOpenPlaylistClicked"
                                HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>

                    <!-- 右侧：歌词 -->
                    <ImageButton Grid.Column="2" WidthRequest="40" HeightRequest="40"
                            CornerRadius="20" Padding="8"
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            Source="{Binding LyricsIconSource}"
                            Clicked="OnOpenLyricsClicked"
                            HorizontalOptions="End" VerticalOptions="Center" />
                </Grid>

                <!-- ═══ 底部操作栏：歌词 / 定时关闭 / 歌曲详情 / 音效 / 横屏 / 更多（占位图标，均布屏幕底部，暂未接功能） ═══ -->
                <Grid Grid.Row="3"
                      x:Name="BottomActionBar"
                      ColumnDefinitions="*,*,*,*,*,*"
                      Margin="8,6,8,2">
                    <!-- 进入歌词页面（使用通知栏媒体控件图标） -->
                    <ImageButton Grid.Column="0" WidthRequest="22" HeightRequest="22"
                                 CornerRadius="11" Padding="5"
                                 Aspect="AspectFit" BackgroundColor="Transparent"
                                 Source="ic_notif_lyric_on"
                                 Clicked="OnOpenLyricsClicked" />
                    <!-- 定时关闭 -->
                    <ImageButton Grid.Column="1" WidthRequest="22" HeightRequest="22"
                                 CornerRadius="11" Padding="5"
                                 Aspect="AspectFit" BackgroundColor="Transparent"
                                 Source="ic_timer"
                                 Clicked="OnSleepTimerClicked" />
                    <!-- 歌曲详情（白色图标） -->
                    <ImageButton Grid.Column="2" WidthRequest="22" HeightRequest="22"
                                 CornerRadius="11" Padding="5"
                                 Aspect="AspectFit" BackgroundColor="Transparent"
                                 Source="ic_info"
                                 Clicked="OnSongDetailTapped" />
                    <!-- 音效/均衡器 -->
                    <ImageButton Grid.Column="3" WidthRequest="22" HeightRequest="22"
                                 CornerRadius="11" Padding="5"
                                 Aspect="AspectFit" BackgroundColor="Transparent"
                                 Source="ic_equalizer"
                                 Clicked="OnEqualizerClicked" />
                    <!-- 切换横屏 -->
                    <ImageButton Grid.Column="4" WidthRequest="22" HeightRequest="22"
                                 CornerRadius="11" Padding="5"
                                 Aspect="AspectFit" BackgroundColor="Transparent"
                                 Source="ic_rotate"
                                 Clicked="OnRotateClicked" />
                    <!-- 更多 -->
                    <ImageButton Grid.Column="5" WidthRequest="22" HeightRequest="22"
                                 CornerRadius="11" Padding="5"
                                 Aspect="AspectFit" BackgroundColor="Transparent"
                                 Source="ic_more"
                                 Clicked="OnMoreClicked" />
                </Grid>
            </Grid>

            <!-- ═══ 横屏 / Windows 布局：顶行收起按钮 + 左封面 + 右信息/控制 ═══ -->
            <Grid x:Name="LandscapeRoot"
                  Grid.Row="1" Grid.RowSpan="2"
                  IsVisible="False"
                  RowDefinitions="Auto,*"
                  ColumnDefinitions="1*,1.15*"
                  ColumnSpacing="32"
                  Padding="48,8,48,20">

                <!-- 横屏右上角收起按钮：独占最上行，比标题更高 -->
                <Border Grid.Row="0" Grid.ColumnSpan="2"
                        x:Name="LandscapeCollapseButton"
                        StrokeThickness="0"
                        BackgroundColor="#40000000"
                        WidthRequest="44" HeightRequest="44"
                        HorizontalOptions="End" VerticalOptions="Start"
                        ZIndex="20"
                        Margin="0,0,0,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLandscapeCollapseTapped" />
                    </Border.GestureRecognizers>
                    <Image x:Name="LandscapeCollapseIcon"
                           WidthRequest="22" HeightRequest="22"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- 左：封面（跨两行，顶部贴状态栏下方，左边距=状态栏高度+5px，底部贴底部安全区上方，动态计算正方形边长） -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                      HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Border x:Name="LandscapeCover"
                            StrokeThickness="0.5"
                            Stroke="#30FFFFFF"
                            StrokeShape="RoundRectangle 28"
                            BackgroundColor="Transparent"
                            WidthRequest="460" HeightRequest="460"
                            HorizontalOptions="Start" VerticalOptions="Start">
                        <Image x:Name="LandscapeCoverImage"
                               Source="{Binding CoverImage}"
                               Aspect="AspectFill"
                               WidthRequest="460" HeightRequest="460" />
                    </Border>
                </Grid>

                <!-- 右：信息 + 控制 + 歌词（Grid 行布局，歌词面板占满剩余高度） -->
                <Grid Grid.Row="1" Grid.Column="1"
                      RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                      RowSpacing="10"
                      ColumnDefinitions="*"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill"
                      Padding="0,28,0,0">

                    <!-- 标题 + 艺人 + 音质徽章（顶部，仅次于悬浮的收起按钮） -->
                    <VerticalStackLayout x:Name="LandscapeTitleBlock" Grid.Row="0" Spacing="2">
                        <Label Text="{Binding Title}"
                               FontSize="28" FontFamily="OpenSansSemibold"
                               TextColor="White"
                               MaxLines="1" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="{Binding Artist}"
                                   FontSize="14" TextColor="{DynamicResource TextSecondaryColor}"
                                   MaxLines="1" LineBreakMode="TailTruncation" />
                            <Label Text="Hi-Res" FontSize="9" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryColor}"
                                   Padding="5,2" />
                            <Label Text="无损" FontSize="9" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryColor}"
                                   Padding="5,2" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- 工具图标：播放列表 / 睡眠定时 / 竖屏切换（放到歌名下方） -->
                    <HorizontalStackLayout x:Name="LandscapeToolsRow" Grid.Row="1" Spacing="12">
                        <ImageButton WidthRequest="30" HeightRequest="30" CornerRadius="15" Padding="6"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="{Binding PlaylistIconSource}"
                                     Clicked="OnOpenPlaylistClicked" />
                        <ImageButton WidthRequest="30" HeightRequest="30" CornerRadius="15" Padding="6"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="ic_timer"
                                     Clicked="OnSleepTimerClicked" />
                        <ImageButton WidthRequest="30" HeightRequest="30" CornerRadius="15" Padding="6"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="ic_rotate"
                                     Clicked="OnRotateClicked" />
                    </HorizontalStackLayout>

                    <!-- 当前歌词（点击进入歌词模式，横屏就地显示多行歌词） -->
                    <VerticalStackLayout x:Name="LandscapeCurrentLyric" Grid.Row="2" Spacing="4" Padding="0,0,0,4">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenLyricsClicked" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="{Binding LyricCurrent}"
                               FontSize="16" FontAttributes="Bold" TextColor="White"
                               MaxLines="1" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <!-- 多行歌词面板（歌词模式显示，占满右栏剩余高度；点击任意处返回横屏模式） -->
                    <ScrollView x:Name="LandscapeLyricsScroll" Grid.Row="3"
                                IsVisible="False"
                                VerticalScrollBarVisibility="Never"
                                HorizontalOptions="Center" VerticalOptions="Fill">
                        <ScrollView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenLyricsClicked" />
                        </ScrollView.GestureRecognizers>
                        <VerticalStackLayout x:Name="LandscapeLyricStack"
                                             Spacing="12"
                                             Padding="0,12,0,48"
                                             HorizontalOptions="Center" />
                    </ScrollView>

                    <!-- 进度条 -->
                    <Grid x:Name="LandscapeProgressRow" Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="1">
                        <Slider x:Name="LandscapeProgressSlider"
                                Minimum="0" Maximum="1" Value="0"
                                ThumbColor="White"
                                MinimumTrackColor="White"
                                MaximumTrackColor="#40FFFFFF"
                                HeightRequest="16"
                                DragStarted="OnSliderDragStarted"
                                DragCompleted="OnSliderDragCompleted" />
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                            <Label Text="{Binding CurrentTimeDisplay}" FontSize="10"
                                   TextColor="White" Opacity="0.7" />
                            <Label Grid.Column="2" Text="{Binding TotalTimeDisplay}" FontSize="10"
                                   TextColor="White" Opacity="0.7" />
                        </Grid>
                    </Grid>

                    <!-- 播放控制行 -->
                    <HorizontalStackLayout x:Name="LandscapeControlsRow" Grid.Row="5" Spacing="12" VerticalOptions="Center">
                        <ImageButton WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="9"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="{Binding LikeIconSourceWhite}"
                                     Command="{Binding ToggleLikeCommand}" />
                        <ImageButton WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="9"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="{Binding PlayPreviousIconSourceWhite}"
                                     Command="{Binding PlayPreviousCommand}" />
                        <ImageButton WidthRequest="64" HeightRequest="64" CornerRadius="32" Padding="13"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="{Binding PlayPauseIconSourceWhite}"
                                     Command="{Binding TogglePlayPauseCommand}" />
                        <ImageButton WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="9"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="{Binding PlayNextIconSourceWhite}"
                                     Command="{Binding PlayNextCommand}" />
                        <ImageButton WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="9"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="{Binding PlayModeIconSourceWhite}"
                                     Command="{Binding CyclePlayModeCommand}" />
                        <ImageButton WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="8"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="{Binding LyricsIconSource}"
                                     Clicked="OnOpenLyricsClicked" />
                    </HorizontalStackLayout>
                </Grid>
            </Grid>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- Windows 桌面播放布局（仅 Windows 端显示，基于 Aurora 原型）          -->
            <!-- Android 横屏仍使用上面的 LandscapeRoot，本布局不影响安卓端            -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <Grid x:Name="WindowsStage"
                  Grid.Row="1" Grid.RowSpan="2"
                  IsVisible="False"
                  RowDefinitions="Auto,*,Auto"
                  Padding="0"
                  ZIndex="5">

                <!-- ─── Row 0: 亚克力标题栏 ─── -->
                <Grid x:Name="WinTitleBar" Grid.Row="0" HeightRequest="48"
                      ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto"
                      ColumnSpacing="12"
                      BackgroundColor="#66121214"
                      Padding="18,0,6,0">
                    <!-- 品牌光点 -->
                    <Border Grid.Column="0" WidthRequest="11" HeightRequest="11"
                            StrokeThickness="0" BackgroundColor="Transparent"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                        <Grid>
                            <BoxView Color="{DynamicResource PrimaryColor}" />
                            <BoxView Color="{DynamicResource PrimaryColor}" Opacity="0.45" Scale="1.8" />
                        </Grid>
                    </Border>
                    <!-- EQ 频谱条 -->
                    <Grid x:Name="WinEq" Grid.Column="1" WidthRequest="28" HeightRequest="14"
                          ColumnDefinitions="*,*,*,*" ColumnSpacing="2"
                          HorizontalOptions="Start" VerticalOptions="Center">
                        <BoxView x:Name="WinEq1" Grid.Column="0" HeightRequest="4" CornerRadius="1.5"
                                 BackgroundColor="{DynamicResource PrimaryLightColor}" VerticalOptions="End" />
                        <BoxView x:Name="WinEq2" Grid.Column="1" HeightRequest="4" CornerRadius="1.5"
                                 BackgroundColor="{DynamicResource PrimaryLightColor}" VerticalOptions="End" />
                        <BoxView x:Name="WinEq3" Grid.Column="2" HeightRequest="4" CornerRadius="1.5"
                                 BackgroundColor="{DynamicResource PrimaryLightColor}" VerticalOptions="End" />
                        <BoxView x:Name="WinEq4" Grid.Column="3" HeightRequest="4" CornerRadius="1.5"
                                 BackgroundColor="{DynamicResource PrimaryLightColor}" VerticalOptions="End" />
                    </Grid>
                    <!-- 标题：正在播放 · 曲目 — 艺人 -->
                    <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                        <Label Text="正在播放" FontSize="13" FontFamily="OpenSansSemibold" TextColor="White" />
                        <Label Text="·" TextColor="#6E6E73" VerticalOptions="Center" />
                        <Label Text="{Binding Title}" FontSize="12.5" TextColor="#C2C6E4" MaxLines="1"
                               LineBreakMode="TailTruncation" />
                        <Label Text="—" TextColor="#6E6E73" VerticalOptions="Center" />
                        <Label Text="{Binding Artist}" FontSize="12.5" TextColor="#8D93B7" MaxLines="1"
                               LineBreakMode="TailTruncation" />
                    </HorizontalStackLayout>

                    <!-- 窗口控件 -->
                    <Border Grid.Column="4" WidthRequest="46" HeightRequest="32"
                            StrokeThickness="0" BackgroundColor="Transparent"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMinimizeTapped" />
                        </Border.GestureRecognizers>
                        <Path WidthRequest="11" HeightRequest="11" Data="M 2,6 L 9,6" Stroke="#8E8E93"
                              StrokeThickness="1.6" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border Grid.Column="5" WidthRequest="46" HeightRequest="32"
                            StrokeThickness="0" BackgroundColor="Transparent"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMaximizeTapped" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Path x:Name="WinMaximizeIcon" WidthRequest="11" HeightRequest="11"
                                  Data="M 2.5,2.5 L 8.5,2.5 L 8.5,8.5 L 2.5,8.5 Z" Stroke="#8E8E93"
                                  StrokeThickness="1.6" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Path x:Name="WinRestoreIcon" WidthRequest="11" HeightRequest="11"
                                  Data="M 2,4 L 7,4 L 7,9 L 2,9 Z M 4,2 L 9,2 L 9,7 L 7,7 L 7,4 L 4,4 Z" Stroke="#8E8E93"
                                  StrokeThickness="1.6" HorizontalOptions="Center" VerticalOptions="Center"
                                  IsVisible="false" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="6" WidthRequest="46" HeightRequest="32"
                            StrokeThickness="0" BackgroundColor="Transparent"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseTapped" />
                        </Border.GestureRecognizers>
                        <Path WidthRequest="11" HeightRequest="11" Data="M 3,3 L 9,9 M 3,9 L 9,3" Stroke="#8E8E93"
                              StrokeThickness="1.6" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- ─── Row 1: 主舞台（左封面+元信息 / 右歌词） ─── -->
                <Grid Grid.Row="1" ColumnDefinitions="0.42*,0.58*" ColumnSpacing="0">
                    <!-- 左：封面 + 曲目信息 -->
                    <Grid Grid.Column="0" RowDefinitions="*,Auto" Padding="40,24,24,24">
                        <!-- 封面：3D 倾斜 + 光泽 -->
                        <Border x:Name="WinCover" Grid.Row="0"
                                StrokeThickness="0" BackgroundColor="Transparent"
                                StrokeShape="RoundRectangle 16"
                                HorizontalOptions="Start" VerticalOptions="Center"
                                RotationY="-3" RotationX="1"
                                TranslationY="8">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,30" Radius="40" Opacity="0.55" />
                            </Border.Shadow>
                            <Grid>
                                <Image x:Name="WinCoverImage" Source="{Binding CoverImage}" Aspect="AspectFill" />
                                <BoxView InputTransparent="True">
                                    <BoxView.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#30FFFFFF" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="0.4" />
                                        </LinearGradientBrush>
                                    </BoxView.Background>
                                </BoxView>
                                <Border StrokeThickness="0.5" Stroke="#1AFFFFFF" BackgroundColor="Transparent" />
                            </Grid>
                        </Border>

                        <!-- 元信息 -->
                        <VerticalStackLayout Grid.Row="1" Spacing="6" Padding="0,18,0,0">
                            <Label Text="{Binding Album}" FontSize="11" FontAttributes="Bold"
                                   TextColor="#8D93B7" LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label Text="{Binding Title}" FontSize="30" FontFamily="OpenSansSemibold"
                                   TextColor="White" LineBreakMode="TailTruncation" MaxLines="2" />
                            <Label Text="{Binding Artist}" FontSize="15" TextColor="#C2C6E4"
                                   LineBreakMode="TailTruncation" MaxLines="1" />
                            <!-- 操作 chips -->
                            <HorizontalStackLayout Spacing="8" Margin="0,14,0,0">
                                <Border x:Name="WinLikeChip" StrokeThickness="1" Stroke="#1FFFFFFF"
                                        BackgroundColor="#10FFFFFF" Padding="15,0" HeightRequest="34"
                                        HorizontalOptions="Start" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnWinLikeTapped" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                        <Image x:Name="WinLikeIcon" WidthRequest="15" HeightRequest="15"
                                               Source="{Binding LikeIconSourceWhite}" Aspect="AspectFit" />
                                        <Label x:Name="WinLikeLabel" Text="收藏" FontSize="12.5" TextColor="White"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border StrokeThickness="1" Stroke="#1FFFFFFF" BackgroundColor="#10FFFFFF"
                                        Padding="15,0" HeightRequest="34"
                                        HorizontalOptions="Start" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnOpenLyricsClicked" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                        <Image WidthRequest="15" HeightRequest="15" Source="{Binding LyricsIconSource}"
                                               Aspect="AspectFit" />
                                        <Label Text="歌词" FontSize="12.5" TextColor="White" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border StrokeThickness="1" Stroke="#1FFFFFFF" BackgroundColor="#10FFFFFF"
                                        Padding="15,0" HeightRequest="34"
                                        HorizontalOptions="Start" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMoreClicked" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                        <Image WidthRequest="15" HeightRequest="15" Source="ic_more" Aspect="AspectFit" />
                                        <Label Text="更多" FontSize="12.5" TextColor="White" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 右：歌词列（WinLyricColumn：Windows 端由 Handler 挂 AcrylicBrush 毛玻璃背景） -->
                    <Grid x:Name="WinLyricColumn" Grid.Column="1" RowDefinitions="Auto,*" Padding="14,24,14,14">
                        <!-- 歌词头：LYRICS + 跟随开关 -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="0,0,26,12">
                            <Label Text="LYRICS · 同步歌词" FontSize="11" FontAttributes="Bold"
                                   TextColor="#8D93B7" VerticalOptions="Center" />
                            <Border Grid.Column="1" x:Name="WinFollowBtn" StrokeThickness="1"
                                    Stroke="#1FFFFFFF" BackgroundColor="#10FFFFFF" Padding="13,0" HeightRequest="28"
                                    HorizontalOptions="End" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWinFollowTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Image WidthRequest="13" HeightRequest="13" Source="{Binding LyricsIconSource}"
                                           Aspect="AspectFit" />
                                    <Label x:Name="WinFollowLabel" Text="跟随" FontSize="11.5" FontAttributes="Bold"
                                           TextColor="White" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                        <!-- 歌词滚动区 -->
                        <ScrollView x:Name="WinLyricsScroll" Grid.Row="1"
                                    VerticalScrollBarVisibility="Never"
                                    VerticalOptions="Fill" HorizontalOptions="Fill">
                            <VerticalStackLayout x:Name="WinLyricStack" Spacing="20" Padding="26,0" />
                        </ScrollView>
                        <!-- 顶部遮罩淡出 -->
                        <BoxView Grid.Row="1" InputTransparent="True" HeightRequest="70" VerticalOptions="Start">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#CC0A0A0C" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>
                        <!-- 底部遮罩淡出 -->
                        <BoxView Grid.Row="1" InputTransparent="True" HeightRequest="70" VerticalOptions="End">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="#CC0A0A0C" Offset="1" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>
                        <!-- 无歌词提示 -->
                        <Label x:Name="WinNoLyricsLabel" Grid.Row="1" Text="{Binding NoLyricsText}" FontSize="13"
                               TextColor="#8D93B7" Opacity="0.6" HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" />
                    </Grid>
                </Grid>

                <!-- ─── Row 2: 底部控制坞（亚克力） ─── -->
                <Grid x:Name="WinDock" Grid.Row="2" HeightRequest="92"
                      ColumnDefinitions="1*,1.6*,1*"
                      ColumnSpacing="24"
                      BackgroundColor="#66101012"
                      Padding="22,0">
                    <!-- 左：播放控制 -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center" HorizontalOptions="Start">
                        <ImageButton x:Name="WinShuffleBtn" WidthRequest="40" HeightRequest="40" CornerRadius="20"
                                     Padding="9" Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="{Binding PlayModeIconSourceWhite}" Command="{Binding CyclePlayModeCommand}" />
                        <ImageButton WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="9"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="{Binding PlayPreviousIconSourceWhite}" Command="{Binding PlayPreviousCommand}" />
                        <Border x:Name="WinPlayBtn" WidthRequest="50" HeightRequest="50" StrokeThickness="0"
                                BackgroundColor="#F7F8FF" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="25" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWinPlayTapped" />
                            </Border.GestureRecognizers>
                            <Border.Shadow>
                                <Shadow Brush="White" Offset="0,8" Radius="24" Opacity="0.4" />
                            </Border.Shadow>
                            <Image x:Name="WinPlayIcon" WidthRequest="22" HeightRequest="22" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <ImageButton WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="9"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="{Binding PlayNextIconSourceWhite}" Command="{Binding PlayNextCommand}" />
                        <ImageButton WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="9"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="{Binding PlaylistIconSource}" Clicked="OnOpenPlaylistClicked" />
                    </HorizontalStackLayout>

                    <!-- 中：进度条 -->
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13" VerticalOptions="Center">
                        <Label Text="{Binding CurrentTimeDisplay}" FontSize="11.5" FontFamily="OpenSansSemibold"
                               TextColor="#8D93B7" />
                        <Slider Grid.Column="1" x:Name="WinProgressSlider" Minimum="0" Maximum="1" Value="0"
                                ThumbColor="White" MinimumTrackColor="{DynamicResource PrimaryColor}"
                                MaximumTrackColor="#24FFFFFF" HeightRequest="24"
                                DragStarted="OnSliderDragStarted" DragCompleted="OnSliderDragCompleted" />
                        <Label Grid.Column="2" Text="{Binding TotalTimeDisplay}" FontSize="11.5"
                               FontFamily="OpenSansSemibold" TextColor="#8D93B7" />
                    </Grid>

                    <!-- 右：音量 + 队列 + 歌词 -->
                    <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center" HorizontalOptions="End">
                        <ImageButton x:Name="WinMuteBtn" WidthRequest="40" HeightRequest="40" CornerRadius="20"
                                     Padding="9" Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="ic_volume" Clicked="OnWinMuteTapped" />
                        <Slider x:Name="WinVolumeSlider" WidthRequest="92" Minimum="0" Maximum="1" Value="1"
                                ThumbColor="White" MinimumTrackColor="White" MaximumTrackColor="#24FFFFFF"
                                HeightRequest="24" ValueChanged="OnWinVolumeChanged" />
                        <ImageButton WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="9"
                                     Aspect="AspectFit" BackgroundColor="Transparent"
                                     Source="{Binding LyricsIconSource}" Clicked="OnOpenLyricsClicked" />
                    </HorizontalStackLayout>
                </Grid>
            </Grid>

        </Grid>

        <!-- 播放列表弹窗（预定义，默认隐藏） -->
        <controls:AppPopup x:Name="PlaylistPopup"
                           Title="播放列表"
                           CloseOnMaskTapped="True" />

        <!-- 定时停止音乐弹窗 -->
        <controls:AppPopup x:Name="SleepTimerPopup"
                           Title="定时停止音乐"
                           CloseOnMaskTapped="True" />

        <!-- 更多操作：复用 AppPopup（与睡眠定时同款，在 ViewPager2 内稳定显示） -->
        <controls:AppPopup x:Name="MorePopup"
                           Title="歌曲操作"
                           CloseOnMaskTapped="True" />
    </Grid>
</ContentPage>
