<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:helpers="clr-namespace:CatClawMusic.Maui.Helpers"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             x:Class="CatClawMusic.Maui.Pages.DesktopArtistsPage"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Artists]}"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <!-- 横屏左右布局：左侧控件面板（返回/标题/搜索/筛选/排序/视图切换） + 右侧艺术家网格 -->
    <Grid ColumnDefinitions="280,*"
          Background="{DynamicResource PageBackgroundBrush}">

        <!-- Frosted glass background -->
        <controls:FrostedBackground Grid.ColumnSpan="2"
            Source="{DynamicResource ThemeBackgroundImage}"
            IsActive="{DynamicResource ThemeBackgroundEnabled}"
            IsVisible="{DynamicResource ThemeBackgroundEnabled}"
            TintColor="{DynamicResource TabBarGlassTint}"
            TintOpacity="0.45"
            DimAmount="0.25"
            Opacity="0.8"
            Aspect="AspectFill"
            UseNativeBlur="True"
            InputTransparent="True" />

        <!-- ═══ 左侧控件面板 ═══ -->
        <Border Grid.Column="0"
                StrokeThickness="0"
                Stroke="{DynamicResource DividerColor}"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                Margin="0,0,1,0">
            <ScrollView Padding="16,12" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="14">

                    <!-- 返回按钮 + 标题 + 统计 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Grid.Column="0" WidthRequest="32" HeightRequest="32"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                                Stroke="{DynamicResource GlassStrokeColor}"
                                StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </Border.GestureRecognizers>
                            <Image Source="{helpers:ThemedIcon Light=ic_arrow_left_light, Dark=ic_arrow_left}"
                                   WidthRequest="16" HeightRequest="16"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" HorizontalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Artists]}"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label FontSize="11" TextColor="{DynamicResource TextHintColor}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="共 " />
                                        <Span Text="{Binding TotalArtists}" FontAttributes="Bold" TextColor="{DynamicResource AccentColor}" />
                                        <Span Text=" 位" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 搜索框 -->
                    <controls:PageSearchBox Placeholder="搜索艺术家…"
                                            FontSize="13"
                                            CornerRadius="10"
                                            SearchQuery="{Binding SearchQuery, Mode=TwoWay}" />

                    <!-- 视图切换（网格/列表） -->
                    <controls:ViewToggleButton IsGridView="{Binding IsGridView, Mode=TwoWay}"
                                               HorizontalOptions="Start" />

                    <!-- 筛选标签 -->
                    <Label Text="筛选" FontSize="11" FontAttributes="Bold"
                           TextColor="{DynamicResource TextHintColor}"
                           CharacterSpacing="2" Margin="0,4,0,0" />

                    <!-- 筛选 chips（垂直排列） -->
                    <controls:ChipList Orientation="Vertical"
                                       Spacing="6"
                                       ItemsSource="{Binding SourceFilters}"
                                       ChipTapped="OnFilterChipTapped"
                                       ChipPadding="11,8"
                                       ChipCornerRadius="10"
                                       ChipFontSize="12" />

                    <!-- 排序标签 -->
                    <Label Text="排序" FontSize="11" FontAttributes="Bold"
                           TextColor="{DynamicResource TextHintColor}"
                           CharacterSpacing="2" Margin="0,4,0,0" />

                    <!-- 排序按钮（垂直排列） -->
                    <controls:ChipList Orientation="Vertical"
                                       Spacing="6"
                                       ItemsSource="{Binding SortOptions}"
                                       ChipTapped="OnSortChipTapped"
                                       ChipPadding="11,8"
                                       ChipCornerRadius="10"
                                       ChipFontSize="12" />

                    <!-- 最常聆听卡片（左侧底部常驻） -->
                    <Border Padding="11,10"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{DynamicResource GlassStrokeColor}"
                            BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                            Margin="0,6,0,0"
                            IsVisible="{Binding HasMostPlayed}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding MostPlayedPlaceholderColor}">
                                <Grid>
                                    <Image Source="{Binding MostPlayedCover}"
                                           Aspect="AspectFill"
                                           IsVisible="{Binding MostPlayedHasCover}" />
                                    <Label Text="{Binding MostPlayedInitial}"
                                           FontSize="16"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="#DDFFFFFF"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           IsVisible="{Binding MostPlayedHasCover, Converter={StaticResource InvertedBoolConverter}}" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="最常聆听"
                                       FontSize="10.5"
                                       TextColor="{DynamicResource TextHintColor}" />
                                <Label Text="{Binding MostPlayedName}"
                                       FontSize="13"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2"
                                    StrokeShape="RoundRectangle 999"
                                    StrokeThickness="0"
                                    BackgroundColor="#22FFFFFF"
                                    Padding="9,5"
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMostPlayedTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="查看"
                                       FontSize="10.5"
                                       TextColor="{DynamicResource TextSecondaryColor}" />
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- ═══ 右侧艺术家网格/列表 + 字母 rail ═══ -->
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Padding="12,10,12,10" ColumnSpacing="8">

            <!-- 网格视图 -->
            <CollectionView Grid.Column="0"
                            x:Name="GridCollectionView"
                            ItemsSource="{Binding FilteredArtists}"
                            SelectionMode="None"
                            IsVisible="{Binding IsGridView}"
                            Margin="0,2,0,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="8" HorizontalItemSpacing="8" VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0"
                                BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArtistTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Border StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding Id, Converter={StaticResource PlaceholderColorConverter}}">
                                    <Grid>
                                        <Image Source="{Binding Cover}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding Cover, Converter={StaticResource CoverArtConverter}}" />
                                        <Label Text="{Binding Name, Converter={StaticResource InitialConverter}}"
                                               FontSize="26"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="#DDFFFFFF"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding Cover, Converter={StaticResource CoverArtConverter}, ConverterParameter=invert}" />
                                    </Grid>
                                </Border>
                                <Label Text="{Binding Name}"
                                       FontSize="11.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       HorizontalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SongCount, StringFormat='{0} 首'}"
                                       FontSize="10"
                                       TextColor="{DynamicResource TextHintColor}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 列表视图 -->
            <CollectionView Grid.Column="0"
                            x:Name="ListCollectionView"
                            ItemsSource="{Binding FilteredArtists}"
                            SelectionMode="None"
                            IsVisible="{Binding IsGridView, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,5"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                BackgroundColor="Transparent"
                                Margin="0,0,0,2">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArtistTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">
                                <Border Grid.Column="0"
                                        WidthRequest="42" HeightRequest="42"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding Id, Converter={StaticResource PlaceholderColorConverter}}">
                                    <Grid>
                                        <Image Source="{Binding Cover}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding Cover, Converter={StaticResource CoverArtConverter}}" />
                                        <Label Text="{Binding Name, Converter={StaticResource InitialConverter}}"
                                               FontSize="18"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="#DDFFFFFF"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding Cover, Converter={StaticResource CoverArtConverter}, ConverterParameter=invert}" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="1">
                                    <Label Text="{Binding Name}"
                                           FontSize="13"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{DynamicResource TextPrimaryColor}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding SongCount, StringFormat='{0} 首歌曲'}"
                                           FontSize="10.5"
                                           TextColor="{DynamicResource TextHintColor}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding Name, Converter={StaticResource NameToLetterConverter}}"
                                       FontSize="10.5"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{DynamicResource AccentColor}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 字母 rail -->
            <ScrollView Grid.Column="1" VerticalOptions="Start" Margin="0,2,0,0">
                <VerticalStackLayout Spacing="1" x:Name="LetterRail"
                                     BindableLayout.ItemsSource="{Binding LetterRailItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="18"
                                    HeightRequest="18"
                                    StrokeShape="RoundRectangle 5"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding BackgroundColor}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLetterTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}"
                                       FontSize="9"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{Binding TextColor}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- 加载指示器 -->
        <ActivityIndicator Grid.Column="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{DynamicResource PrimaryColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
