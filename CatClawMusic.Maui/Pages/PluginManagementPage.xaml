<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:converters="clr-namespace:CatClawMusic.Maui.Converters"
             xmlns:vm="clr-namespace:CatClawMusic.Maui.ViewModels"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             x:Class="CatClawMusic.Maui.Pages.PluginManagementPage"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Plugins]}"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <Grid RowDefinitions="Auto,*"
          Background="{DynamicResource PageBackgroundBrush}">

        <!-- Frosted glass background: blurred theme image, semi-transparent -->
        <controls:FrostedBackground Grid.RowSpan="2"
            Source="{DynamicResource ThemeBackgroundImage}"
            IsActive="{DynamicResource ThemeBackgroundEnabled}"
            IsVisible="{DynamicResource ThemeBackgroundEnabled}"
            TintColor="{DynamicResource TabBarGlassTint}"
            TintOpacity="0.45"
            DimAmount="0.25"
            Opacity="0.8"
            Aspect="AspectFill"
            UseNativeBlur="True"
            InputTransparent="True" />

        <controls:HeroCard Grid.Row="0">
            <controls:HeroCard.CardContent>
                <Grid Padding="44,0,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Plugins]}"
                               Style="{StaticResource PageTitleStyle}"
                               TextColor="White" />
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[PluginsSubtitle]}"
                               Style="{StaticResource PageSubtitleStyle}"
                               TextColor="#F3F5FF" />
                        <Label Text="{Binding Summary}"
                               FontSize="12"
                               TextColor="#B8C7FF" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            Style="{StaticResource GlassIconContainerStyle}"
                            BackgroundColor="#24FFFFFF"
                            Stroke="{DynamicResource GlassStrokeColor}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RefreshCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="🔄" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </controls:HeroCard.CardContent>
        </controls:HeroCard>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,22" Spacing="14">

                <!-- ═══ 插件商店（在线安装） ═══ -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="🛒 插件商店"
                               FontSize="15"
                               FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="{Binding StoreStatus}"
                               FontSize="11"
                               TextColor="{DynamicResource TextHintColor}"
                               VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding IsLoadingStore, StringFormat='正在加载插件商店...'}"
                           IsVisible="{Binding IsLoadingStore}"
                           FontSize="12" TextColor="{DynamicResource TextHintColor}" />
                    <VerticalStackLayout Spacing="8"
                                         BindableLayout.ItemsSource="{Binding StoreItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StoreItemView">
                                <Border Style="{StaticResource GlassCardStyle}">
                                    <Grid Padding="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding Icon}" FontSize="26" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding Name}"
                                                   FontSize="15" FontFamily="OpenSansSemibold"
                                                   TextColor="{DynamicResource TextPrimaryColor}" />
                                            <Label Text="{Binding Description}"
                                                   FontSize="11" TextColor="{DynamicResource TextHintColor}"
                                                   LineBreakMode="TailTruncation" MaxLines="2" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Version, StringFormat='v{0}'}"
                                                       FontSize="10" TextColor="{DynamicResource TextHintColor}" />
                                                <Label Text="{Binding Author, StringFormat='by {0}'}"
                                                       FontSize="10" TextColor="{DynamicResource TextHintColor}" />
                                                <Label Text="{Binding Category}"
                                                       FontSize="10" TextColor="#B8C7FF" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2"
                                                             Spacing="4"
                                                             VerticalOptions="Center"
                                                             MinimumWidthRequest="64">
                                            <Label Text="✓ 已安装"
                                                   FontSize="12"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="#4CAF50"
                                                   HorizontalOptions="Center"
                                                   IsVisible="{Binding IsInstalled}" />
                                            <Button Text="安装"
                                                    FontSize="12"
                                                    HeightRequest="32"
                                                    CornerRadius="16"
                                                    Padding="12,0"
                                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                                    TextColor="White"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.InstallFromStoreCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding IsInstalling, Converter={StaticResource InvertedBoolConverter}}"
                                                    IsEnabled="{Binding IsInstalled, Converter={StaticResource InvertedBoolConverter}}" />
                                            <VerticalStackLayout Spacing="2"
                                                                 IsVisible="{Binding IsInstalling}">
                                                <Label Text="{Binding ProgressText}"
                                                       FontSize="10"
                                                       TextColor="{DynamicResource TextHintColor}"
                                                       HorizontalOptions="Center" />
                                                <ProgressBar Progress="{Binding Progress}"
                                                               ProgressColor="{DynamicResource PrimaryColor}"
                                                               HeightRequest="4" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10"
                                     BindableLayout.ItemsSource="{Binding Plugins}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PluginItemView">
                            <Border Style="{StaticResource GlassCardStyle}">
                                <Grid Padding="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Text="{Binding IconEmoji}"
                                           FontSize="26"
                                           VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                                            <Label Text="{Binding DisplayName}"
                                                   FontSize="15"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="{DynamicResource TextPrimaryColor}" />
                                            <Border Grid.Column="1"
                                                    Padding="6,2"
                                                    Stroke="{DynamicResource GlassStrokeColor}"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="#1AFFFFFF"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding CategoryText}"
                                                       FontSize="9"
                                                       TextColor="#B8C7FF" />
                                            </Border>
                                            <Border Grid.Column="2"
                                                    Padding="6,2"
                                                    Stroke="{DynamicResource GlassStrokeColor}"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="#1AFFFFFF"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding SourceText}"
                                                       FontSize="9"
                                                       TextColor="#B8C7FF" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding Description}"
                                               FontSize="11"
                                               TextColor="{DynamicResource TextHintColor}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Version, StringFormat='v{0}'}"
                                                   FontSize="10"
                                                   TextColor="{DynamicResource TextHintColor}" />
                                            <Label Text="{Binding Author, StringFormat='by {0}'}"
                                                   FontSize="10"
                                                   TextColor="{DynamicResource TextHintColor}"
                                                   IsVisible="{Binding Author, Converter={StaticResource StringToBoolConverter}}" />
                                            <BoxView WidthRequest="6" HeightRequest="6"
                                                     CornerRadius="3"
                                                     Color="{Binding StatusColor}"
                                                     VerticalOptions="Center" />
                                            <Label Text="{Binding StatusText}"
                                                   FontSize="10"
                                                   TextColor="{Binding StatusColor}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="2"
                                            IsToggled="{Binding IsEnabled}"
                                            OnColor="{DynamicResource PrimaryColor}"
                                            ThumbColor="White"
                                            VerticalOptions="Center"
                                            IsEnabled="False" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleEnabledCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource GlassCardStyle}"
                        IsVisible="{Binding Plugins.Count, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="🧩"
                               FontSize="34"
                               HorizontalOptions="Center" />
                        <Label Text="当前没有可用插件"
                               Style="{StaticResource PageSubtitleStyle}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="插件系统已就绪，未来可通过安装包扩展功能"
                               FontSize="11"
                               TextColor="{DynamicResource TextHintColor}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="💡 关于插件"
                               FontSize="13"
                               FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Text="点击插件卡片可快速切换启用状态。插件按类型分为歌词、协议、封面、音效等。"
                               FontSize="11"
                               TextColor="{DynamicResource TextHintColor}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
</Grid>
</ContentPage>
