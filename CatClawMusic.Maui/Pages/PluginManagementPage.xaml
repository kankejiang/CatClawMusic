<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:converters="clr-namespace:CatClawMusic.Maui.Converters"
             xmlns:vm="clr-namespace:CatClawMusic.Maui.ViewModels"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             x:Class="CatClawMusic.Maui.Pages.PluginManagementPage"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Plugins]}"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <Grid RowDefinitions="Auto,*"
          Background="{DynamicResource PageBackgroundBrush}">

        <!-- Frosted glass background: blurred theme image, semi-transparent -->
        <controls:FrostedBackground Grid.RowSpan="2"
            Source="{DynamicResource ThemeBackgroundImage}"
            IsActive="{DynamicResource ThemeBackgroundEnabled}"
            IsVisible="{DynamicResource ThemeBackgroundEnabled}"
            TintColor="{DynamicResource TabBarGlassTint}"
            TintOpacity="0.45"
            DimAmount="0.25"
            Opacity="0.8"
            Aspect="AspectFill"
            UseNativeBlur="True"
            InputTransparent="True" />

        <controls:HeroCard Grid.Row="0">
            <controls:HeroCard.CardContent>
                <Grid Padding="44,0,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Plugins]}"
                               Style="{StaticResource PageTitleStyle}"
                               TextColor="White" />
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[PluginsSubtitle]}"
                               Style="{StaticResource PageSubtitleStyle}"
                               TextColor="#F3F5FF" />
                        <Label Text="{Binding Summary}"
                               FontSize="12"
                               TextColor="#B8C7FF" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            Style="{StaticResource GlassIconContainerStyle}"
                            BackgroundColor="#24FFFFFF"
                            Stroke="{DynamicResource GlassStrokeColor}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddPluginCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="＋" FontSize="18" HorizontalOptions="Center" />
                            <Label Text="添加" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </controls:HeroCard.CardContent>
        </controls:HeroCard>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,22" Spacing="14">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="🧩 已安装插件"
                           FontSize="15"
                           FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <Border Grid.Column="1"
                            Padding="10,5"
                            Stroke="{DynamicResource GlassStrokeColor}"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#1AFFFFFF"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RefreshCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="🔄" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                    </Border>
                </Grid>

                <Label Text="{Binding InstallStatusText}"
                       FontSize="12"
                       FontFamily="OpenSansSemibold"
                       TextColor="{DynamicResource PrimaryColor}"
                       HorizontalOptions="Center"
                       IsVisible="{Binding IsInstalling}" />

                <VerticalStackLayout Spacing="10"
                                     BindableLayout.ItemsSource="{Binding Plugins}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PluginItemView">
                            <Border Style="{StaticResource GlassCardStyle}">
                                <Grid Padding="14,12" RowDefinitions="Auto,Auto" RowSpacing="12">
                                    <!-- Row 0：图标 + 插件信息 -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="{Binding IconEmoji}"
                                               FontSize="26"
                                               VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                                                <Label Text="{Binding DisplayName}"
                                                       FontSize="15"
                                                       FontFamily="OpenSansSemibold"
                                                       TextColor="{DynamicResource TextPrimaryColor}" />
                                                <Border Grid.Column="1"
                                                        Padding="6,2"
                                                        Stroke="{DynamicResource GlassStrokeColor}"
                                                        StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="#1AFFFFFF"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding CategoryText}"
                                                           FontSize="9"
                                                           TextColor="#B8C7FF" />
                                                </Border>
                                                <Border Grid.Column="2"
                                                        Padding="6,2"
                                                        Stroke="{DynamicResource GlassStrokeColor}"
                                                        StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="#1AFFFFFF"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding SourceText}"
                                                           FontSize="9"
                                                           TextColor="#B8C7FF" />
                                                </Border>
                                            </Grid>
                                            <Label Text="{Binding Description}"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource TextHintColor}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Version, StringFormat='v{0}'}"
                                                       FontSize="10"
                                                       TextColor="{DynamicResource TextHintColor}" />
                                                <Label Text="{Binding UpdateVersion, StringFormat='↑ 有新版本 v{0}'}"
                                                       FontSize="10"
                                                       FontFamily="OpenSansSemibold"
                                                       TextColor="#4CAF50"
                                                       IsVisible="{Binding UpdateAvailable}" />
                                                <Label Text="{Binding Author, StringFormat='by {0}'}"
                                                       FontSize="10"
                                                       TextColor="{DynamicResource TextHintColor}"
                                                       IsVisible="{Binding Author, Converter={StaticResource StringToBoolConverter}}" />
                                                <BoxView WidthRequest="6" HeightRequest="6"
                                                         CornerRadius="3"
                                                         Color="{Binding StatusColor}"
                                                         VerticalOptions="Center" />
                                                <Label Text="{Binding StatusText}"
                                                       FontSize="10"
                                                       TextColor="{Binding StatusColor}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <!-- Row 1：操作栏（启用开关 / 删除 / 配置，放卡片底部） -->
                                    <HorizontalStackLayout Grid.Row="1" Spacing="14" VerticalOptions="Center">
                                        <Switch IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                                                OnColor="{DynamicResource PrimaryColor}"
                                                ThumbColor="White"
                                                VerticalOptions="Center"
                                                Toggled="OnPluginSwitchToggled" />
                                        <Border IsVisible="{Binding CanUninstall}"
                                                Padding="9,4"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="#22FF6B6B"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding UninstallCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="🗑 删除"
                                                   FontSize="11"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="#FF6B6B"
                                                   HorizontalOptions="Center" />
                                        </Border>
                                        <Button Text="🔄 更新"
                                                FontSize="11" HeightRequest="30" CornerRadius="15" Padding="14,0"
                                                BackgroundColor="{DynamicResource PrimaryColor}"
                                                TextColor="White"
                                                VerticalOptions="Center"
                                                Command="{Binding UpdateCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding UpdateAvailable}"
                                                IsEnabled="{Binding IsUpdating, Converter={StaticResource InvertedBoolConverter}}" />
                                        <Border IsVisible="{Binding CanConfigure}"
                                                Padding="9,4"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="#24FFFFFF"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ConfigureCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="⚙ 配置"
                                                   FontSize="11"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="{DynamicResource PrimaryColor}"
                                                   HorizontalOptions="Center" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource GlassCardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="💡 关于插件"
                               FontSize="13"
                               FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Text="点击插件卡片可快速切换启用状态。插件按类型分为歌词、协议、封面、音效等。"
                               FontSize="11"
                               TextColor="{DynamicResource TextHintColor}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
</Grid>
</ContentPage>
