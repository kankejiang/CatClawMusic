<?xml version="1.0" encoding="utf-8" ?>
<base:DiscoverPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:base="clr-namespace:CatClawMusic.Maui.Pages.Base"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:helpers="clr-namespace:CatClawMusic.Maui.Helpers"
             xmlns:models="clr-namespace:CatClawMusic.Maui.ViewModels"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             x:Class="CatClawMusic.Maui.Pages.DesktopDiscoverPage"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <Grid>
        <!-- 发现模式：内部 ScrollView 滚动发现内容（本页已加入 DesktopMainPage 白名单不再包外层
             ScrollView，避免聊天模式下滚动链把 header/输入框一起带滚） -->
        <ScrollView IsVisible="{Binding IsChatMode, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout x:Name="RootStack" Padding="26,4,26,26" Spacing="0">

            <!-- ═══ Page Head: 发现 + 问候 + AI 开关 + 主题按钮 ═══ -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,2">
                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label Text="发现" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" />
                    <Label Text="{Binding GreetingText}" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                </VerticalStackLayout>
                <HorizontalStackLayout x:Name="PluginEntriesBar" Grid.Column="1" VerticalOptions="Center" Spacing="8">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="智能推荐" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" VerticalOptions="Center" />
                    <Border BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}" StrokeThickness="0" StrokeShape="RoundRectangle 999" WidthRequest="20" HeightRequest="20">
                        <Label Text="AI" FontSize="8" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Switch IsToggled="{Binding IsAiRecommendationEnabled}" VerticalOptions="Center" OnColor="{DynamicResource PrimaryColor}" Scale="0.72" />
                </HorizontalStackLayout>
                    <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{DynamicResource GlassStrokeColor}"
                            BackgroundColor="{DynamicResource CardBackgroundColor}" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchToggleClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="{helpers:ThemedIcon Light=ic_search_light, Dark=ic_search}"
                               WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{DynamicResource GlassStrokeColor}"
                            BackgroundColor="{DynamicResource CardBackgroundColor}" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRefreshClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="{helpers:ThemedIcon Light=ic_refresh_light, Dark=ic_refresh}"
                               WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <!-- 在线音乐入口已移除：由 IViewContributorPlugin 插件提供入口 -->
                    <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{DynamicResource GlassStrokeColor}"
                            BackgroundColor="{DynamicResource CardBackgroundColor}" VerticalOptions="Center">
                        <Label x:Name="ThemeIcon" Text="&#x1f319;" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnThemeToggleClicked" />
                        </Border.GestureRecognizers>
                    </Border>
                    <!-- 设置入口：侧栏已移除，改放页面右上角 -->
                    <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{DynamicResource GlassStrokeColor}"
                            BackgroundColor="{DynamicResource CardBackgroundColor}" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsButtonClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="{helpers:ThemedIcon Light=ic_settings_light, Dark=ic_settings}"
                               WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- 搜索框 -->
            <Border x:Name="SearchBoxContainer" Margin="0,0,0,0" Style="{StaticResource GlassInputStyle}" IsVisible="{Binding IsSearchOpen}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Image Source="{helpers:ThemedIcon Light=ic_search_light, Dark=ic_search}" WidthRequest="18" HeightRequest="18" Opacity="0.9" VerticalOptions="Center" />
                    <Entry Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchQuery, Mode=TwoWay}" Placeholder="搜索歌曲、歌手、专辑..." ReturnType="Search" TextChanged="OnSearchTextChanged" Completed="OnSearchCompleted" />
                    <ImageButton Grid.Column="2" Source="{helpers:ThemedIcon Name=ic_close, Original=True}" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent" IsVisible="{Binding ShowSearchResults}" Clicked="OnClearSearchClicked" />
                </Grid>
            </Border>

            <!-- 搜索结果下拉 -->
            <Border Margin="0,4,0,10" Padding="0" StrokeShape="RoundRectangle 18" StrokeThickness="1" Stroke="{DynamicResource GlassStrokeColor}" BackgroundColor="{DynamicResource CardBackgroundStrongColor}" IsVisible="{Binding ShowSearchDropdown}">
                <ScrollView MaximumHeightRequest="380">
                    <VerticalStackLayout Spacing="0">
                        <VerticalStackLayout IsVisible="{Binding SearchArtistResults.Count, Converter={StaticResource CountToBoolConverter}}">
                            <Label Text="歌手" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextHintColor}" CharacterSpacing="2" Padding="16,12,16,4" />
                            <CollectionView ItemsSource="{Binding SearchArtistResults}" SelectionMode="Single" SelectionChanged="OnSearchArtistSelected" ItemsUpdatingScrollMode="KeepScrollOffset" HeightRequest="{Binding SearchArtistResults.Count, Converter={StaticResource SearchSectionHeightConverter}}">
                                <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="14,8" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                                <Image Source="{Binding CoverSource}" Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                <Label Text="{Binding Name}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                                <Label Text="{Binding Subtitle}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding SearchAlbumResults.Count, Converter={StaticResource CountToBoolConverter}}">
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="16,4" />
                            <Label Text="专辑" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextHintColor}" CharacterSpacing="2" Padding="16,8,16,4" />
                            <CollectionView ItemsSource="{Binding SearchAlbumResults}" SelectionMode="Single" SelectionChanged="OnSearchAlbumSelected" ItemsUpdatingScrollMode="KeepScrollOffset" HeightRequest="{Binding SearchAlbumResults.Count, Converter={StaticResource SearchSectionHeightConverter}}">
                                <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="14,8" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                                <Image Source="{Binding CoverSource}" Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                <Label Text="{Binding Title}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                                <Label Text="{Binding ArtistName}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding SearchResults.Count, Converter={StaticResource CountToBoolConverter}}">
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="16,4" />
                            <Label Text="歌曲" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextHintColor}" CharacterSpacing="2" Padding="16,8,16,4" />
                            <CollectionView ItemsSource="{Binding SearchResults}" SelectionMode="Single" SelectionChanged="OnSearchSongSelected" ItemsUpdatingScrollMode="KeepScrollOffset" HeightRequest="{Binding SearchResults.Count, Converter={StaticResource SearchSectionHeightConverter}}">
                                <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="14,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                                <Image Source="{Binding CoverArtPath, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                <Label Text="{Binding Title}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                                <Label Text="{Binding Artist}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" />
                                            </VerticalStackLayout>
                                            <ImageButton Source="{helpers:ThemedIcon Light=ic_play_light, Dark=ic_play}" WidthRequest="28" HeightRequest="28" BackgroundColor="Transparent" Clicked="OnSearchSongPlayTapped" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                        <!-- 在线音乐：音源插件聚合搜索（多平台合并展示） -->
                        <VerticalStackLayout IsVisible="{Binding HasOnlineSearchResults}">
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="16,4" />
                            <Label Text="在线音乐" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextHintColor}" CharacterSpacing="2" Padding="16,8,16,4" />
                            <CollectionView ItemsSource="{Binding OnlineSearchResults}" SelectionMode="Single" SelectionChanged="OnOnlineSearchResultSelected" ItemsUpdatingScrollMode="KeepScrollOffset" HeightRequest="{Binding OnlineSearchResults.Count, Converter={StaticResource SearchSectionHeightConverter}}">
                                <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="14,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                                <Image Source="{Binding CoverUrl, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                <Label Text="{Binding Title}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                                <Label Text="{Binding Artist}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding PlatformName}" FontSize="10" TextColor="{DynamicResource PrimaryColor}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                        <Label IsVisible="{Binding IsSearchingOnline}" Text="正在搜索在线音乐…" FontSize="12" TextColor="{DynamicResource TextHintColor}" Padding="16,8" />
                        <VerticalStackLayout IsVisible="{Binding HasNoSearchResults}">
                            <Label Text="没找到想要的？问问 Yuki 吧" FontSize="13" TextColor="{DynamicResource TextSecondaryColor}" Padding="16,16" HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAiEntryTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- ═══ Segmented Tabs ═══ -->
            <Grid x:Name="CategoryTabBar" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8" Margin="0,16,0,16">
                <Border Grid.Column="0" x:Name="TabRec" Style="{StaticResource GlassCardStyle}" Padding="12,10" Stroke="{DynamicResource GlassStrokeColor}">
                    <Label x:Name="TabRecLabel" Text="推荐" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="0" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="1" x:Name="TabRank" Style="{StaticResource GlassCardStyle}" Padding="12,10" Stroke="{DynamicResource GlassStrokeColor}">
                    <Label x:Name="TabRankLabel" Text="排行" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="1" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="2" x:Name="TabArtist" Style="{StaticResource GlassCardStyle}" Padding="12,10" Stroke="{DynamicResource GlassStrokeColor}">
                    <Label x:Name="TabArtistLabel" Text="歌手" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="2" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="3" x:Name="TabAlbum" Style="{StaticResource GlassCardStyle}" Padding="12,10" Stroke="{DynamicResource GlassStrokeColor}">
                    <Label x:Name="TabAlbumLabel" Text="专辑" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="3" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="4" x:Name="TabStats" Style="{StaticResource GlassCardStyle}" Padding="12,10" Stroke="{DynamicResource GlassStrokeColor}">
                    <Label x:Name="TabStatsLabel" Text="统计" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="4" /></Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- ═══ 推荐面板 ═══ -->
            <VerticalStackLayout x:Name="PanelRecommend" IsVisible="{Binding CurrentCategory, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}" Spacing="0">

                <!-- Hero 横向多卡轮播 -->
                <Grid x:Name="HeroWrap" Margin="0,0,0,6">
                    <ScrollView x:Name="HeroScroll" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Scrolled="OnHeroScrolled">
                        <!-- 英雄卡与 AI 卡由代码构建（RebuildHeroTrack）：
                            不能混用 BindableLayout（其 ItemsSource 变化会 Clear 掉手动子元素，AI 卡会被删除） -->
                        <HorizontalStackLayout x:Name="HeroTrack" Spacing="18" Padding="2,2,2,2">
                        </HorizontalStackLayout>
                    </ScrollView>
                    <ImageButton x:Name="HeroPrev" WidthRequest="30" HeightRequest="30"
                                 BackgroundColor="#1A000000" CornerRadius="15" Padding="6" Aspect="AspectFit"
                                 HorizontalOptions="Start" VerticalOptions="Center" Margin="6,0,0,0" Clicked="OnHeroPrevClicked" />
                    <ImageButton x:Name="HeroNext" WidthRequest="30" HeightRequest="30"
                                 BackgroundColor="#1A000000" CornerRadius="15" Padding="6" Aspect="AspectFit"
                                 HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,6,0" Clicked="OnHeroNextClicked" />
                </Grid>
                <IndicatorView x:Name="HeroDots" Margin="0,4,0,18"
                              IndicatorColor="{DynamicResource TextHintColor}" SelectedIndicatorColor="{DynamicResource PrimaryColor}"
                              IndicatorsShape="Circle" HorizontalOptions="Center" />

                <!-- AI 歌单（开启智能推荐且有数据/正在生成时显示；由 AI 每天生成一次） -->
                <VerticalStackLayout Spacing="0" IsVisible="{Binding IsAiPlaylistsSectionVisible}">
                    <Grid x:Name="AiSectionHeader" Margin="0,6,0,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border WidthRequest="4" HeightRequest="16" StrokeThickness="0" StrokeShape="RoundRectangle 2" VerticalOptions="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#667eea" Offset="0" />
                                    <GradientStop Color="#f093fb" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="AI 歌单" Style="{StaticResource SectionTitleStyle}" />
                            <Label Text="每天由 AI 根据你的口味定制" FontSize="10.5" TextColor="{DynamicResource TextHintColor}"
                                   IsVisible="{Binding IsAiPlaylistsLoading, Converter={StaticResource InvertedBoolConverter}}" />
                            <Label Text="AI 正在分析你的口味生成歌单…" FontSize="10.5" TextColor="{DynamicResource PrimaryColor}"
                                   IsVisible="{Binding IsAiPlaylistsLoading}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Padding="8,3" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                                BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}" VerticalOptions="Center">
                              <Border.GestureRecognizers>
                                  <TapGestureRecognizer Tapped="OnAiPlaylistRegenerateTapped" />
                              </Border.GestureRecognizers>
                            <Label Text="AI 生成" FontSize="9.5" FontAttributes="Bold" TextColor="White" />
                        </Border>
                    </Grid>

                    <!-- 生成中：加载指示 + 实时思考过程 -->
                    <Grid HeightRequest="150" IsVisible="{Binding IsAiPlaylistsLoading}">
                        <ActivityIndicator IsRunning="{Binding IsAiPlaylistsLoading}" IsVisible="{Binding IsAiPlaylistsLoading}"
                                           Color="{DynamicResource PrimaryColor}" WidthRequest="28" HeightRequest="28"
                                           HorizontalOptions="Center" VerticalOptions="Start" Margin="0,20,0,0" />
                        <Label Text="{Binding AiPlaylistsThinking}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}"
                               LineBreakMode="WordWrap" MaxLines="5" HorizontalOptions="Center" VerticalOptions="End"
                               Margin="24,0,24,12" />
                    </Grid>

                    <CollectionView ItemsUpdatingScrollMode="KeepScrollOffset" x:Name="AiPlaylistRow" Margin="0,0,40,16" HeightRequest="366"
                                    ItemsSource="{Binding AiPlaylists}" SelectionMode="None"
                                    IsVisible="{Binding IsAiPlaylistsLoading, Converter={StaticResource InvertedBoolConverter}}">
                        <CollectionView.Behaviors><controls:HideScrollBarBehavior /></CollectionView.Behaviors>
                        <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="14" /></CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <!-- 与推荐专辑卡片同尺寸：宽 280（4 列网格封面列宽），封面方形随宽自适应 -->
                                <Border WidthRequest="280" StrokeShape="RoundRectangle 16" StrokeThickness="1"
                                        Stroke="{DynamicResource GlassStrokeColor}" BackgroundColor="{DynamicResource CardBackgroundStrongColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAiPlaylistTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="0">
                                        <Border StrokeShape="RoundRectangle 16 16 0 0" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                            <Image Source="{Binding CoverPath, TargetNullValue='ic_music_note'}" Aspect="AspectFill">
                                                <Image.Behaviors>
                                                    <controls:SquareBehavior />
                                                </Image.Behaviors>
                                            </Image>
                                        </Border>
                                        <VerticalStackLayout Padding="12,10,12,12" Spacing="4">
                                            <Label Text="{Binding Name}" FontSize="14" FontFamily="OpenSansSemibold"
                                                   TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                            <Label Text="{Binding Reason}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="2" />
                                            <Label Text="{Binding Subtitle}" FontSize="10.5" TextColor="{DynamicResource PrimaryColor}" MaxLines="1" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- 推荐专辑网格（4×2 封面网格，点击进专辑） -->
                <Grid x:Name="AlbumSectionHeader" Margin="0,10,0,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border WidthRequest="4" HeightRequest="16" StrokeThickness="0" StrokeShape="RoundRectangle 2" VerticalOptions="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" />
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Label Grid.Column="1" Text="推荐专辑" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="更多 ›" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" VerticalOptions="Center" Padding="8,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="3" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <CollectionView x:Name="RecommendAlbumGrid" ItemsSource="{Binding RecommendAlbums}" SelectionMode="Single"
                                SelectionChanged="OnAlbumSelected" ItemsUpdatingScrollMode="KeepScrollOffset" Margin="0,0,40,16" HeightRequest="180">
                    <CollectionView.Behaviors>
                        <controls:ScrollPerformanceBehavior />
                        <controls:HideScrollBarBehavior />
                    </CollectionView.Behaviors>
                    <!-- 推荐专辑改为单行横滑（与每日推荐/推荐艺人一致），避免 6+2 断行网格 -->
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="14" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="136" StrokeShape="RoundRectangle 14" StrokeThickness="1"
                                    Stroke="{DynamicResource GlassStrokeColor}" BackgroundColor="{DynamicResource CardBackgroundStrongColor}">
                                <VerticalStackLayout Spacing="0">
                                    <Border WidthRequest="136" HeightRequest="136" StrokeShape="RoundRectangle 14 14 0 0" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                        <Image Source="{Binding CoverSource, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="136" HeightRequest="136" />
                                    </Border>
                                    <VerticalStackLayout Padding="8,6,8,8" Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="12.5" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                        <Label Text="{Binding ArtistName}" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- 每日推荐横滑（左右箭头导航） -->
                <Grid x:Name="DailySectionHeader" Margin="0,4,0,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border WidthRequest="4" HeightRequest="16" StrokeThickness="0" StrokeShape="RoundRectangle 2" VerticalOptions="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" />
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Label Grid.Column="1" Text="每日推荐" Style="{StaticResource SectionTitleStyle}" />
                    <Button Grid.Column="2" Text="换一批 ↻" FontSize="12" HeightRequest="34" CornerRadius="16"
                            BackgroundColor="Transparent" TextColor="{DynamicResource TextSecondaryColor}" Padding="8,0" Clicked="OnShuffleDailyClicked" />
                </Grid>
                <Grid x:Name="DailyWrap">
                    <CollectionView x:Name="DailyList" Margin="0,0,40,16" HeightRequest="206"
                                    ItemsSource="{Binding DailyRecommendSongs}" SelectionMode="Single"
                                    SelectionChanged="OnDailySongSelected" ItemsUpdatingScrollMode="KeepScrollOffset">
                        <CollectionView.Behaviors>
                        <controls:ScrollPerformanceBehavior />
                        <controls:HideScrollBarBehavior />
                    </CollectionView.Behaviors>
                        <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" /></CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border WidthRequest="150" StrokeShape="RoundRectangle 18" StrokeThickness="1" Stroke="{DynamicResource GlassStrokeColor}" BackgroundColor="{DynamicResource CardBackgroundStrongColor}">
                                    <VerticalStackLayout Spacing="0">
                                        <Border WidthRequest="150" HeightRequest="150" StrokeShape="RoundRectangle 18 18 0 0" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                            <Image Source="{Binding CoverArtPath, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="150" HeightRequest="150" />
                                        </Border>
                                        <VerticalStackLayout Padding="10,8,10,10" Spacing="3">
                                            <Label Text="{Binding Title}" FontSize="12.5" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" MaxLines="1" />
                                            <Label Text="{Binding Artist}" FontSize="10.5" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <ImageButton x:Name="DailyPrev" WidthRequest="30" HeightRequest="30"
                                 BackgroundColor="#1A000000" CornerRadius="15" Padding="6" Aspect="AspectFit"
                                 HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,4,0" Clicked="OnDailyPrevClicked" />
                    <ImageButton x:Name="DailyNext" WidthRequest="30" HeightRequest="30"
                                 BackgroundColor="#1A000000" CornerRadius="15" Padding="6" Aspect="AspectFit"
                                 HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,4,0" Clicked="OnDailyNextClicked" IsVisible="False" />
                </Grid>

                <!-- 推荐艺人横滑（左右箭头导航） -->
                <Grid x:Name="ArtistSectionHeader" Margin="0,4,0,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border WidthRequest="4" HeightRequest="16" StrokeThickness="0" StrokeShape="RoundRectangle 2" VerticalOptions="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" />
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Label Grid.Column="1" Text="推荐艺人" Style="{StaticResource SectionTitleStyle}" />
                    <Button Grid.Column="2" Text="查看全部 ›" FontSize="12" HeightRequest="34" CornerRadius="16"
                            BackgroundColor="Transparent" TextColor="{DynamicResource TextSecondaryColor}" Padding="8,0" Clicked="OnArtistsViewAllClicked" />
                </Grid>
                <Grid x:Name="ArtistsWrap">
                    <CollectionView x:Name="ArtistsRow" Margin="0,0,40,16" HeightRequest="142"
                                    ItemsSource="{Binding Artists}" SelectionMode="Single"
                                    SelectionChanged="OnArtistSelected" ItemsUpdatingScrollMode="KeepScrollOffset">
                        <CollectionView.Behaviors>
                        <controls:ScrollPerformanceBehavior />
                        <controls:HideScrollBarBehavior />
                    </CollectionView.Behaviors>
                        <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="14" /></CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout WidthRequest="92" Spacing="6">
                                    <Border WidthRequest="84" HeightRequest="84" StrokeShape="RoundRectangle 42" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}" HorizontalOptions="Center">
                                        <Image Source="{Binding CoverSource}" Aspect="AspectFill" WidthRequest="84" HeightRequest="84" />
                                    </Border>
                                    <Label Text="{Binding Name}" FontSize="13" FontFamily="OpenSansSemibold" HorizontalOptions="Center" MaxLines="1" />
                                    <Label Text="{Binding Subtitle}" FontSize="11" TextColor="{DynamicResource TextHintColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <ImageButton x:Name="ArtistPrev" WidthRequest="30" HeightRequest="30"
                                 BackgroundColor="#1A000000" CornerRadius="15" Padding="6" Aspect="AspectFit"
                                 HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,4,0" Clicked="OnArtistPrevClicked" />
                    <ImageButton x:Name="ArtistNext" WidthRequest="30" HeightRequest="30"
                                 BackgroundColor="#1A000000" CornerRadius="15" Padding="6" Aspect="AspectFit"
                                 HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,4,0" Clicked="OnArtistNextClicked" IsVisible="False" />
                </Grid>
            </VerticalStackLayout>

            <!-- ═══ 排行榜面板（双列） ═══ -->
            <Grid x:Name="PanelRank" IsVisible="{Binding CurrentCategory, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                  ColumnDefinitions="1*,1*" ColumnSpacing="22">
                <VerticalStackLayout Grid.Column="0" Spacing="0">
                    <Label Text="最多播放" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,10" />
                    <CollectionView x:Name="TopPlayedList" ItemsSource="{Binding TopPlayedSongs}" SelectionMode="Single"
                                    SelectionChanged="OnTopPlayedSongSelected" ItemsUpdatingScrollMode="KeepScrollOffset">
                        <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="14,9" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{DynamicResource InputBackgroundColor}">
                                        <Image Source="{Binding CoverArtPath, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="46" HeightRequest="46" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="14.5" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label FontSize="12" LineBreakMode="TailTruncation" MaxLines="1" TextColor="{DynamicResource TextHintColor}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="Artist" TargetNullValue="未知艺术家" />
                                                    <Binding Path="Album" TargetNullValue="未知专辑" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" FontSize="12" VerticalOptions="Center" TextColor="{DynamicResource TextHintColor}" Text="{Binding Duration, Converter={StaticResource DurationConverter}}" />
                                    <Label Grid.Column="3" Text="⋮" FontSize="18" VerticalOptions="Center" TextColor="{DynamicResource TextHintColor}" Padding="6,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMoreTapped" CommandParameter="{Binding}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="0">
                    <Label Text="我的最爱 ★" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,10" />
                    <CollectionView x:Name="FavoriteList" ItemsSource="{Binding FavoriteSongs}" SelectionMode="Single"
                                    SelectionChanged="OnFavoriteSongSelected" ItemsUpdatingScrollMode="KeepScrollOffset">
                        <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="14,9" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{DynamicResource InputBackgroundColor}">
                                        <Image Source="{Binding CoverArtPath, TargetNullValue='ic_music_note'}" Aspect="AspectFill" WidthRequest="46" HeightRequest="46" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="14.5" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label FontSize="12" LineBreakMode="TailTruncation" MaxLines="1" TextColor="{DynamicResource TextHintColor}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="Artist" TargetNullValue="未知艺术家" />
                                                    <Binding Path="Album" TargetNullValue="未知专辑" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" FontSize="12" VerticalOptions="Center" TextColor="{DynamicResource TextHintColor}" Text="{Binding Duration, Converter={StaticResource DurationConverter}}" />
                                    <Label Grid.Column="3" Text="⋮" FontSize="18" VerticalOptions="Center" TextColor="{DynamicResource TextHintColor}" Padding="6,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMoreTapped" CommandParameter="{Binding}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Grid>

            <!-- ═══ 歌手网格面板 ═══ -->
            <VerticalStackLayout x:Name="PanelArtist" IsVisible="{Binding CurrentCategory, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}" Spacing="0">
                <Grid Margin="0,4,0,8" ColumnDefinitions="*,Auto">
                    <Label Text="推荐歌手" Style="{StaticResource SectionTitleStyle}" />
                    <Button Grid.Column="1" Text="查看全部 ›" FontSize="12" HeightRequest="34" CornerRadius="16"
                            BackgroundColor="Transparent" TextColor="{DynamicResource TextSecondaryColor}" Padding="8,0" Clicked="OnArtistsViewAllClicked" />
                </Grid>
                <CollectionView x:Name="ArtistGrid" ItemsSource="{Binding Artists}" SelectionMode="Single"
                                SelectionChanged="OnArtistSelected" ItemsUpdatingScrollMode="KeepScrollOffset">
                    <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                    <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="8" VerticalItemSpacing="14" HorizontalItemSpacing="12" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Border WidthRequest="84" HeightRequest="84" StrokeShape="RoundRectangle 42" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}" HorizontalOptions="Center">
                                    <Image Source="{Binding CoverSource}" Aspect="AspectFill" WidthRequest="84" HeightRequest="84" />
                                </Border>
                                <Label Text="{Binding Name}" FontSize="13" FontFamily="OpenSansSemibold" HorizontalOptions="Center" MaxLines="1" />
                                <Label Text="{Binding Subtitle}" FontSize="11" TextColor="{DynamicResource TextHintColor}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- ═══ 推荐专辑网格面板 ═══ -->
            <VerticalStackLayout x:Name="PanelAlbum" IsVisible="{Binding CurrentCategory, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3}" Spacing="0">
                <Grid Margin="0,4,0,4">
                    <Label Text="推荐专辑" Style="{StaticResource SectionTitleStyle}" />
                </Grid>
                <Label Text="从你的曲库里随机挑出的专辑 · 帮你重新发现" FontSize="11.5" TextColor="{DynamicResource TextHintColor}" Margin="0,0,0,10" />
                <CollectionView x:Name="AlbumGrid" ItemsSource="{Binding Albums}" SelectionMode="Single"
                                SelectionChanged="OnAlbumSelected" ItemsUpdatingScrollMode="KeepScrollOffset">
                    <CollectionView.Behaviors><controls:ScrollPerformanceBehavior /></CollectionView.Behaviors>
                    <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="6" VerticalItemSpacing="14" HorizontalItemSpacing="12" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="6">
                                <Border StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceColor}">
                                    <!-- 正方形封面：宽=高，随列宽自适应 -->
                                    <Image Source="{Binding CoverSource, TargetNullValue='ic_music_note'}" Aspect="AspectFill">
                                        <Image.Behaviors>
                                            <controls:SquareBehavior />
                                        </Image.Behaviors>
                                    </Image>
                                </Border>
                                <Label Text="{Binding Title}" FontSize="13.5" FontFamily="OpenSansSemibold" MaxLines="1" />
                                <Label Text="{Binding ArtistName}" FontSize="11.5" TextColor="{DynamicResource TextSecondaryColor}" MaxLines="1" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- ═══ 统计面板（听歌统计）═══ -->
            <VerticalStackLayout x:Name="PanelStats" IsVisible="{Binding CurrentCategory, Converter={StaticResource IntToBoolConverter}, ConverterParameter=4}" Spacing="0">
            </VerticalStackLayout>

            <ActivityIndicator Margin="0,10" IsVisible="{Binding IsLoading}" IsRunning="{Binding IsLoading}" Color="{DynamicResource PrimaryColor}" HorizontalOptions="Center" />
        </VerticalStackLayout>
        </ScrollView>

        <!-- Chat Overlay: 不透明背景覆盖发现页；顶栏(返回/头像)/消息/输入框各自独立一行，
             互不重叠。IsClippedToBounds 裁剪旋转列表的越界绘制/命中，防其干扰相邻行控件。 -->
        <Grid x:Name="ChatOverlay"
              IsVisible="{Binding IsChatMode}"
              BackgroundColor="{DynamicResource WindowBackgroundColor}"
              RowDefinitions="Auto,*,Auto"
              IsClippedToBounds="True">

            <!-- Chat Header（独立顶栏行 Row 0）：返回按钮 / Yuki 头像 / 标题，与聊天记录不在同一行 -->
            <Grid x:Name="ChatHeader"
                  Grid.Row="0"
                  Margin="0,10,0,6"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10">
                <controls:BackButton x:Name="ChatBackButton"
                                     VerticalOptions="Center"
                                     Clicked="OnChatBackClicked" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding AgentName}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}" />
                    <Label Text="你的 AI 音乐助手" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                </VerticalStackLayout>
                <Border Grid.Column="2" Padding="4" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                        BackgroundColor="{DynamicResource CardBackgroundStrongColor}" VerticalOptions="Center">
                    <Image Source="avatar_yuki.png" WidthRequest="34" HeightRequest="34" />
                </Border>
            </Grid>

            <CollectionView x:Name="ChatMessagesList" Grid.Row="1" Margin="0,0,0,0"
                        ItemsSource="{Binding ChatMessages}"
                        SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepScrollOffset"
                            Scrolled="OnChatMessagesScrolled"
                            Rotation="180">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="2,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                              Rotation="180">
                            <!-- Yuki 头像（左）：assistant 消息显示 -->
                            <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                    IsVisible="{Binding Role, Converter={StaticResource IsAssistantConverter}}"
                                    VerticalOptions="Start" Margin="0,2,0,0">
                                <Image Source="avatar_yuki.png" Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                            </Border>

                            <!-- 占位（对方消息时空，自己消息时让气泡靠右） -->
                            <BoxView Grid.Column="0" WidthRequest="36" IsVisible="{Binding Role, Converter={StaticResource IsUserConverter}}" Color="Transparent" />

                            <!-- 消息气泡（含思考过程）：位于中间列，根据角色左/右对齐 -->
                            <Border Grid.Column="1" Padding="14,10" StrokeThickness="0" MaximumWidthRequest="300" StrokeShape="RoundRectangle 18"
                                    BackgroundColor="{Binding Role, Converter={StaticResource ChatBubbleColorConverter}}"
                                    HorizontalOptions="{Binding Role, Converter={StaticResource ChatBubbleAlignmentConverter}}"
                                    VerticalOptions="Start">
                                <VerticalStackLayout Spacing="6">
                                    <!-- 思考/工具调用过程区块（仅助手消息且有思考内容时可见，点击折叠/展开） -->
                                    <Border IsVisible="{Binding HasThinking}"
                                            Padding="10,8" StrokeThickness="1" Stroke="{DynamicResource GlassStrokeColor}"
                                            StrokeShape="RoundRectangle 10" BackgroundColor="{DynamicResource ButtonOverlayColor}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleThinkingCommand}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsThinking}" IsVisible="{Binding IsThinking}"
                                                                   Color="{DynamicResource PrimaryColor}" WidthRequest="12" HeightRequest="12" />
                                                <Label Grid.Column="0" Text="✓" FontSize="11" TextColor="{DynamicResource TextPrimaryColor}"
                                                       IsVisible="{Binding IsThinking, Converter={StaticResource InvertedBoolConverter}}"
                                                       VerticalOptions="Center" WidthRequest="12" HorizontalTextAlignment="Center" />
                                                <Label Grid.Column="1" Text="{Binding ThinkingSummary}" FontSize="11" TextColor="{DynamicResource TextPrimaryColor}"
                                                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="2" Text="▲" FontSize="9" TextColor="{DynamicResource TextSecondaryColor}" VerticalOptions="Center"
                                                       IsVisible="{Binding IsThinkingExpanded}" />
                                                <Label Grid.Column="2" Text="▼" FontSize="9" TextColor="{DynamicResource TextSecondaryColor}" VerticalOptions="Center"
                                                       IsVisible="{Binding IsThinkingExpanded, Converter={StaticResource InvertedBoolConverter}}" />
                                            </Grid>
                                            <!-- 流式思考过程文本（推理模型 reasoning_content，展开时实时显示） -->
                                            <Label Text="{Binding ReasoningContent}" FontSize="10"
                                                   TextColor="{DynamicResource TextSecondaryColor}"
                                                   LineBreakMode="WordWrap"
                                                   IsVisible="{Binding IsThinkingExpanded}" />
                                            <CollectionView ItemsUpdatingScrollMode="KeepScrollOffset" IsVisible="{Binding IsThinkingExpanded}" ItemsSource="{Binding ThinkingSteps}"
                                                            MaximumHeightRequest="160" Margin="0,2,0,0">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Label Text="{Binding}" FontSize="10" TextColor="{DynamicResource TextSecondaryColor}" Padding="2,2" />
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Label Text="{Binding Content}" FontSize="14" TextColor="{Binding Role, Converter={StaticResource ChatBubbleTextColorConverter}}" LineBreakMode="WordWrap"
                                           IsVisible="{Binding Content, Converter={StaticResource StringToBoolConverter}}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- 占位（自己消息时空，对方消息时让气泡靠左） -->
                            <BoxView Grid.Column="2" WidthRequest="36" IsVisible="{Binding Role, Converter={StaticResource IsAssistantConverter}}" Color="Transparent" />

                            <!-- 用户头像（右）：user 消息显示 -->
                            <Border Grid.Column="2" WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                    BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}"
                                    IsVisible="{Binding Role, Converter={StaticResource IsUserConverter}}"
                                    VerticalOptions="Start" Margin="0,2,0,0">
                                <Label Text="👤" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Grid.Row="2" Margin="0,10,0,14" Style="{StaticResource GlassInputStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <!-- 推理力度：点击弹出上拉菜单（底部面板选择） -->
                    <Border x:Name="EffortButton" Padding="10,4" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                            BackgroundColor="{DynamicResource ChipInactiveColor}" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReasoningEffortButtonTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="EffortButtonLabel" Text="推理：自动" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Border>
                    <Entry Grid.Column="1" x:Name="ChatInputBox" Text="{Binding ChatInput, Mode=TwoWay}"
                           Placeholder="输入消息..." ReturnType="Send" Completed="OnChatInputCompleted" />
                    <Border Grid.Column="2" Style="{StaticResource GlassIconContainerStyle}" BackgroundColor="{DynamicResource ChipActiveColor}">
                        <Grid>
                            <ImageButton Source="{helpers:ThemedIcon Name=ic_send, Original=True}" IsVisible="{Binding IsSendVisible}" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" Padding="9" Clicked="OnSendClicked" />
                            <ImageButton Source="{helpers:ThemedIcon Name=ic_close, Original=True}" IsVisible="{Binding IsStopVisible}" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" Padding="9" Clicked="OnStopClicked" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Agent 浏览器预览：AI 调用浏览器时在顶部弹出小窗口（不离开聊天页） -->
        <controls:AgentBrowserPreview x:Name="AgentBrowserPreview"
                                      VerticalOptions="Start"
                                      Margin="12,8,12,0"
                                      ZIndex="50" />

        <!-- 推理力度上拉菜单（悬浮在输入框上方，点击遮罩关闭） -->
        <Grid x:Name="EffortSheetOverlay"
              IsVisible="False"
              ZIndex="120">
            <BoxView Color="Black" Opacity="0.25">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEffortSheetBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <!-- 推理力度菜单：悬浮在输入框上方（底部留出输入框高度的 Margin），点击遮罩关闭 -->
            <Border x:Name="EffortSheet" VerticalOptions="End" Margin="16,0,16,72"
                    BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                    Stroke="{DynamicResource GlassStrokeStrongColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    WidthRequest="260"
                    HorizontalOptions="Start">
                <VerticalStackLayout Spacing="0" Padding="0,10,0,6">
                    <Label Text="推理力度" FontSize="14" FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}" HorizontalOptions="Center" Margin="0,0,0,8" />

                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="12,0" />

                    <Grid x:Name="EffortOptDisabled" Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Grid.GestureRecognizers><TapGestureRecognizer CommandParameter="disabled" Tapped="OnReasoningEffortOptionTapped" /></Grid.GestureRecognizers>
                        <Label x:Name="EffortOptDisabledLabel" Text="关闭" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" x:Name="EffortOptDisabledCheck" Text="✓" FontSize="13" TextColor="{DynamicResource PrimaryColor}" IsVisible="False" />
                    </Grid>
                    <Grid x:Name="EffortOptLow" Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Grid.GestureRecognizers><TapGestureRecognizer CommandParameter="low" Tapped="OnReasoningEffortOptionTapped" /></Grid.GestureRecognizers>
                        <Label x:Name="EffortOptLowLabel" Text="低" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" x:Name="EffortOptLowCheck" Text="✓" FontSize="13" TextColor="{DynamicResource PrimaryColor}" IsVisible="False" />
                    </Grid>
                    <Grid x:Name="EffortOptHigh" Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Grid.GestureRecognizers><TapGestureRecognizer CommandParameter="high" Tapped="OnReasoningEffortOptionTapped" /></Grid.GestureRecognizers>
                        <Label x:Name="EffortOptHighLabel" Text="高" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" x:Name="EffortOptHighCheck" Text="✓" FontSize="13" TextColor="{DynamicResource PrimaryColor}" IsVisible="False" />
                    </Grid>
                    <Grid x:Name="EffortOptMax" Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Grid.GestureRecognizers><TapGestureRecognizer CommandParameter="max" Tapped="OnReasoningEffortOptionTapped" /></Grid.GestureRecognizers>
                        <Label x:Name="EffortOptMaxLabel" Text="最强" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" x:Name="EffortOptMaxCheck" Text="✓" FontSize="13" TextColor="{DynamicResource PrimaryColor}" IsVisible="False" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</base:DiscoverPageBase>
