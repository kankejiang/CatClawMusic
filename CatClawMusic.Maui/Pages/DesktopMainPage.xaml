<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:helpers="clr-namespace:CatClawMusic.Maui.Helpers"
             xmlns:vitrum="clr-namespace:Vitrum"
             x:Class="CatClawMusic.Maui.Pages.DesktopMainPage"
             Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[AppName]}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <!-- Desktop layout: Sidebar | Content, with Player at bottom. Drag bar overlays on top.
         沉浸式标题栏：内容背景延伸至窗口顶部，侧边栏从标题栏下方开始。 -->
    <Grid x:Name="RootGrid" ColumnDefinitions="220,*" RowDefinitions="0,*,100">

        <!-- ═══ Left Sidebar (floating rounded card, 方案A晨雾框架) ═══ -->
        <!-- 顶部标题栏由 MAUI 官方 TitleBar 控件提供（仅系统 caption 按钮，透明背景），
            侧边栏上移贯穿顶部（Row0+RowSpan3）覆盖标题栏左侧，标题栏仅剩右上 caption 按钮。
            方案A：侧栏改为四周留边（上12/下12/左12）的圆角浮层卡，圆角16；
            毛玻璃底由 BlurConsumerView 实时模糊下层 BlurHostView 内容（透内容，非封面） -->
        <Border x:Name="SidebarBorder" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                Margin="12,12,0,12"
                StrokeThickness="1"
                Stroke="#1AFFFFFF"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="Transparent">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="0,0,0,0">
                <!-- Windows 无 Vitrum handler 时的兜底底色（浅色半透明毛玻璃色调，Android 被下方模糊层完全覆盖） -->
                <BoxView Grid.RowSpan="5" Color="{DynamicResource CardBackgroundStrongColor}" InputTransparent="True" />
                <!-- 真毛玻璃背景：BlurConsumerView 实时模糊 BlurHostView 内容，并按 16dp 圆角裁剪贴合浮层卡。
                     AlignToHostOrigin：侧栏在宿主左侧，对齐宿主原点以显示内容区内容从左侧延伸进侧栏 -->
                <vitrum:BlurConsumerView Grid.RowSpan="5" AlignToHostOrigin="True" ClipCornerRadius="16">
                    <vitrum:BlurConsumerView.TintColor>
                        <AppThemeBinding Light="#99FFFFFF" Dark="#8C1C1C25" />
                    </vitrum:BlurConsumerView.TintColor>
                </vitrum:BlurConsumerView>

                <!-- App Logo（Windows 桌面端显示；移动端横屏复用时隐藏以节省空间） -->
                <Grid x:Name="SidebarLogo" Grid.Row="0" Padding="20,2,20,12"
                      ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border WidthRequest="36" HeightRequest="36"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            Background="{DynamicResource HeroBrush}"
                            VerticalOptions="Center">
                        <Label Text="&#x1f43e;" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout x:Name="LogoText" Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[AppName]}"
                               FontSize="16" FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Text="CatClaw Music"
                               FontSize="10"
                               TextColor="{DynamicResource TextHintColor}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Navigation -->
                <VerticalStackLayout Grid.Row="1" Spacing="2" Padding="8,0">
                    <Label x:Name="NavHeader" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Navigation]}" FontSize="10"
                           TextColor="{DynamicResource TextHintColor}"
                           CharacterSpacing="2" Padding="12,4,12,2" />

                    <Border x:Name="NavDiscover" StrokeThickness="0"
                            StrokeShape="RoundRectangle 11"
                            Padding="12,7" BackgroundColor="Transparent">
                        <Border.Behaviors>
                            <controls:PressFeedbackBehavior />
                        </Border.Behaviors>
<Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavDiscoverTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image x:Name="NavDiscoverIcon" Source="{helpers:ThemedIcon Light=ic_home_light, Dark=ic_home}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label x:Name="NavDiscoverLabel" Grid.Column="1" Text="发现" FontSize="14"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border x:Name="NavPlaylists" StrokeThickness="0"
                            StrokeShape="RoundRectangle 11"
                            Padding="12,7" BackgroundColor="Transparent">
                        <Border.Behaviors>
                            <controls:PressFeedbackBehavior />
                        </Border.Behaviors>
<Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavPlaylistsTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image x:Name="NavPlaylistsIcon" Source="{helpers:ThemedIcon Light=ic_playlist_light, Dark=ic_playlist}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label x:Name="NavPlaylistsLabel" Grid.Column="1" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabPlaylists]}" FontSize="14"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border x:Name="NavLibrary" StrokeThickness="0"
                            StrokeShape="RoundRectangle 11"
                            Padding="12,7" BackgroundColor="Transparent">
                        <Border.Behaviors>
                            <controls:PressFeedbackBehavior />
                        </Border.Behaviors>
<Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavLibraryTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image x:Name="NavLibraryIcon" Source="{helpers:ThemedIcon Light=ic_library_light, Dark=ic_library}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label x:Name="NavLibraryLabel" Grid.Column="1" Text="音乐库" FontSize="14"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- User Playlists (scrollable) -->
                <VerticalStackLayout Grid.Row="2" Spacing="2" Padding="8,4,8,0">
                    <Grid ColumnDefinitions="*,Auto" Padding="12,2,8,2">
                        <Label x:Name="PlaylistHeader" Grid.Column="0" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[MyPlaylists]}" FontSize="10"
                               TextColor="{DynamicResource TextHintColor}"
                               CharacterSpacing="2" VerticalOptions="Center" />
                        <Label x:Name="AddPlaylistButton" Grid.Column="1" Text="＋"
                               FontSize="18" TextColor="{DynamicResource TextSecondaryColor}"
                               HorizontalOptions="End" VerticalOptions="Center"
                               WidthRequest="24" HeightRequest="28">
                            <Label.Behaviors>
                                <controls:PressFeedbackBehavior />
                            </Label.Behaviors>
<Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddPlaylistTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <ScrollView x:Name="PlaylistScroll">
                        <VerticalStackLayout x:Name="PlaylistHost" Spacing="2" />
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Settings at bottom -->
                <VerticalStackLayout Grid.Row="3" Spacing="2" Padding="8,0,8,12">
                    <Border x:Name="NavSettings" StrokeThickness="0" StrokeShape="RoundRectangle 11"
                            Padding="12,7" BackgroundColor="Transparent">
                        <Border.Behaviors>
                            <controls:PressFeedbackBehavior />
                        </Border.Behaviors>
<Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavSettingsTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image x:Name="NavSettingsIcon" Source="{helpers:ThemedIcon Light=ic_settings_light, Dark=ic_settings}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label x:Name="SettingsLabel" Grid.Column="1" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings]}" FontSize="14"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ═══ Top Command Bar ═══ -->
        <Grid x:Name="TopBar" Grid.Row="0" Grid.Column="1"
              ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,0,16,0"
              BackgroundColor="Transparent">
            <Entry x:Name="SearchEntry"
                   Placeholder="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[DesktopSearchPlaceholder]}"
                   VerticalOptions="Center"
                   HeightRequest="34"
                   FontSize="13"
                   ReturnType="Search"
                   Completed="OnSearchSubmitted" />
            <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Grid.Behaviors>
                        <controls:PressFeedbackBehavior />
                    </Grid.Behaviors>
<Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLyricsButtonClicked" />
                    </Grid.GestureRecognizers>
                    <Image Source="{helpers:ThemedIcon Name=ic_lyrics, Original=True}"
                           WidthRequest="22" HeightRequest="22"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </HorizontalStackLayout>
        </Grid>

        <!-- ═══ Main Content Area (below title bar) ═══ -->
        <!-- BlurHostView 包裹内容区并延伸到屏幕底部（RowSpan=3），使滚动内容可滚到播放栏背后，
             供播放栏的 BlurConsumerView 真毛玻璃透出其下层内容。
             BlurConsumerView 必须是其 Grid 兄弟（不能在其内容子树内）。 -->
        <vitrum:BlurHostView Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                             BlurRadius="60">
            <Grid x:Name="ContentArea"
                  Background="{DynamicResource PageBackgroundBrush}"
                  IsClippedToBounds="True" />
        </vitrum:BlurHostView>

        <!-- ═══ Bottom Floating Player Bar (方案A晨雾框架：左右18/下16 留边的圆角悬浮卡) ═══ -->
        <Grid x:Name="PlayerBarBorder" Grid.Row="2" Grid.Column="1"
              Margin="18,0,18,16">
            <!-- 圆角浮层：1px 半透明描边 + 16dp 圆角裁剪；BlurConsumerView 模糊底按 16dp 圆角贴合 -->
            <Border StrokeThickness="1" Stroke="#1CFFFFFF"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="Transparent">
                <Grid RowDefinitions="1,*">
                    <!-- 顶部细高光（替代原贴边分隔线，模拟方案A顶部 -1px 内高光） -->
                    <BoxView Grid.Row="0" HeightRequest="1"
                             Color="#21FFFFFF" VerticalOptions="Start" />
                    <!-- Windows 无 Vitrum handler 时的兜底底色（Android 被下方模糊层完全覆盖） -->
                    <BoxView Grid.Row="1" Color="{DynamicResource CardBackgroundStrongColor}" InputTransparent="True" />
                    <!-- 真毛玻璃背景：BlurConsumerView 实时模糊下层 BlurHostView 内容（透列表内容，非封面），并按 16dp 圆角裁剪 -->
                    <vitrum:BlurConsumerView Grid.Row="1" ClipCornerRadius="16">
                <vitrum:BlurConsumerView.TintColor>
                    <AppThemeBinding Light="#99FFFFFF" Dark="#8C1C1C25" />
                </vitrum:BlurConsumerView.TintColor>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Padding="24,0" ColumnSpacing="24">

                <!-- Song Info (left) -->
                <!-- Windows 上嵌套布局的 TapGestureRecognizer 不可靠，
                     这里用一个透明 Border 覆盖整个歌曲信息区来接收点击。 -->
                <Grid x:Name="PlayerInfoGrid" Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="12"
                      VerticalOptions="Center" WidthRequest="240" MinimumWidthRequest="160">
                    <Border x:Name="PlayerCoverBorder" WidthRequest="48" HeightRequest="48"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0"
                            BackgroundColor="{DynamicResource SurfaceColor}">
                        <Image x:Name="PlayerCover"
                               Source="{Binding CoverImage}"
                               Aspect="AspectFill"
                               WidthRequest="48" HeightRequest="48" />
                    </Border>
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalOptions="Center">
                        <Label Grid.Row="0" Text="{Binding Title}"
                               FontSize="14" FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource PlayerTitleColor}"
                               MaxLines="1" />
                        <Label Grid.Row="1" Text="{Binding Artist}"
                               FontSize="12"
                               TextColor="{DynamicResource PlayerSubColor}"
                               MaxLines="1" />
                    </Grid>
                    <!-- 透明按钮覆盖整个歌曲信息区，负责捕获点击 -->
                    <Button Grid.ColumnSpan="2"
                            BackgroundColor="Transparent"
                            Text=""
                            BorderWidth="0"
                            CornerRadius="0"
                            Padding="0"
                            Clicked="OnPlayerSongInfoTapped"
                            HorizontalOptions="Fill" VerticalOptions="Fill" />
                </Grid>

                <!-- Controls + Progress (center) -->
                <Grid x:Name="PlayerControlsGrid" Grid.Column="1" RowDefinitions="Auto,Auto"
                      VerticalOptions="Center" RowSpacing="6" Padding="0">
                    <!-- Control buttons（Image 而非 ImageButton：ImageButton 无 TintColor 属性，
                         明暗主题着色用 Image.TintColor + DynamicResource） -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="14" HorizontalOptions="Center">
                        <Image Grid.Column="0" WidthRequest="32" HeightRequest="32"
                                Aspect="AspectFit"
                                Source="{Binding PlayModeIconSource}"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Behaviors>
                                <controls:PressFeedbackBehavior />
                            </Image.Behaviors>
<Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CyclePlayModeCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image Grid.Column="1" WidthRequest="32" HeightRequest="32"
                                Aspect="AspectFit"
                                Source="{Binding PlayPreviousIconSource}"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Behaviors>
                                <controls:PressFeedbackBehavior />
                            </Image.Behaviors>
<Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlayPreviousCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <!-- 主播放键：透明背景，仅保留图标与 46×46 点击热区。
                             用普通版（非 White）跟随 PlayerCtrl 逻辑，浅色=主题色/深色=白色 -->
                        <Grid Grid.Column="2" WidthRequest="46" HeightRequest="46"
                              HorizontalOptions="Center" VerticalOptions="Center">
                            <Grid.Behaviors>
                                <controls:PressFeedbackBehavior />
                            </Grid.Behaviors>
<Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePlayPauseCommand}" />
                            </Grid.GestureRecognizers>
                            <Image WidthRequest="24" HeightRequest="24"
                                   Aspect="AspectFit"
                                   Source="{Binding PlayPauseIconSource}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <Image Grid.Column="3" WidthRequest="32" HeightRequest="32"
                                Aspect="AspectFit"
                                Source="{Binding PlayNextIconSource}"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Behaviors>
                                <controls:PressFeedbackBehavior />
                            </Image.Behaviors>
<Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlayNextCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image Grid.Column="4" WidthRequest="32" HeightRequest="32"
                                Aspect="AspectFit"
                                Source="{Binding LikeIconSource}"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Behaviors>
                                <controls:PressFeedbackBehavior />
                            </Image.Behaviors>
<Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleLikeCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <!-- Progress bar -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding CurrentTimeDisplay}"
                               FontSize="11"
                               TextColor="{DynamicResource PlayerSubColor}"
                               WidthRequest="36" HorizontalTextAlignment="End" />
                        <Slider Grid.Column="1" x:Name="DesktopProgressSlider"
                                Minimum="0"
                                Maximum="{Binding Duration, Mode=OneWay}"
                                Value="{Binding Progress, Mode=TwoWay}"
                                ThumbColor="{DynamicResource PlayerSliderThumb}"
                                MinimumTrackColor="{DynamicResource PlayerSliderProgress}"
                                MaximumTrackColor="{DynamicResource PlayerSliderTrack}"
                                HorizontalOptions="Fill" MinimumWidthRequest="240"
                                DragStarted="OnDesktopSliderDragStarted"
                                DragCompleted="OnDesktopSliderDragCompleted" />
                        <Label Grid.Column="2" Text="{Binding TotalTimeDisplay}"
                               FontSize="11"
                               TextColor="{DynamicResource PlayerSubColor}"
                               WidthRequest="36" />
                    </Grid>
                </Grid>

                <!-- Volume (right) -->
                <Grid x:Name="VolumeGrid" Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                      VerticalOptions="Center" WidthRequest="220" MinimumWidthRequest="110">
                    <Image Source="{helpers:ThemedIcon Name=ic_music_note, Original=True}" WidthRequest="18" HeightRequest="18"
                           Opacity="0.7" VerticalOptions="Center" />
                    <Slider Grid.Column="1" x:Name="VolumeSlider"
                            Minimum="0" Maximum="1"
                            ThumbColor="{DynamicResource PlayerSliderThumb}"
                            MinimumTrackColor="{DynamicResource PlayerSliderProgress}"
                            MaximumTrackColor="{DynamicResource PlayerSliderTrack}"
                            HorizontalOptions="Fill" MinimumWidthRequest="120"
                            VerticalOptions="Center" />
                </Grid>
                </Grid>
                </vitrum:BlurConsumerView>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
