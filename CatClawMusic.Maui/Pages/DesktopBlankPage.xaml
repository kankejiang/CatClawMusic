<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawMusic.Maui.Pages.DesktopBlankPage"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <!-- ════════════════════════════════════════════════════════════════
         全新空白画布（桌面端重建设计第 2 步：三分区框架）
         左侧导航栏区（30%）| 垂直分割线 | 右侧主页区（70%）
         ════════════════════════════════════════════════════════════════ -->
    <Grid x:Name="BlankRoot" ColumnDefinitions="3*,1,7*">

        <!-- 左侧导航栏区域（30%，待填充） -->
        <Grid x:Name="NavZone" Grid.Column="0" />

        <!-- 垂直分割线 -->
        <BoxView Grid.Column="1"
                 Color="{DynamicResource DividerColor}"
                 VerticalOptions="Fill" />

        <!-- 右侧主页区域（70%，待填充） -->
        <Grid x:Name="ContentZone" Grid.Column="2" />

    </Grid>

</ContentPage>
