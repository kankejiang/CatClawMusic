<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatClawMusic.Maui.Controls"
             xmlns:services="clr-namespace:CatClawMusic.Maui.Services"
             xmlns:helpers="clr-namespace:CatClawMusic.Maui.Helpers"
             xmlns:vitrum="clr-namespace:Vitrum"
             x:Class="CatClawMusic.Maui.Pages.DesktopBlankPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <!-- ════════════════════════════════════════════════════════════════
         Windows 桌面主壳 · 方案A「晨雾框架」（landscape_sidebar_redesign.html）：
         ┌──────────┬──────────────────────────────┐
         │ 侧栏浮层卡 │ 顶栏：搜索 · 拖动区 · 歌词/设置/头像 │
         │ (圆角16)  ├──────────────────────────────┤
         │           │ 主页内容区（嵌入 tab/子页面）       │
         │           ├──────────────────────────────┤
         │           │ 播放条浮层卡（圆角16，仅右列宽）     │
         └──────────┴──────────────────────────────┘
         侧栏与播放条均为四周留边的圆角浮层卡；毛玻璃底由 BlurConsumerView
         实时模糊 BlurHostView 内容（Windows 无 handler 时回退半透明底色）。
         拖动区 = 顶栏中段空白（TitleBarHost），不覆盖搜索框/按钮。
         ════════════════════════════════════════════════════════════════ -->
    <Grid x:Name="BlankRoot" ColumnDefinitions="244,*">

        <!-- ═══ 底层：主内容区（跨两列铺满，作为所有毛玻璃浮层的"画布"）═══ -->
        <!-- Padding 为侧栏/顶栏/播放条浮层留出空间，子页面内容不会被遮住；
             但 MainArea 的背景色会延伸到浮层下方 → 毛玻璃下能看到统一色调 + 内容层次。 -->
        <Grid x:Name="MainArea" Grid.ColumnSpan="2" IsClippedToBounds="True"
              BackgroundColor="{DynamicResource WindowBackgroundColor}"
              Padding="256,68,24,100" />

        <!-- ═══ 左：侧栏浮层卡（Logo + 三大导航 + 我的歌单）═══ -->
        <Border x:Name="NavArea" Grid.Column="0"
                Margin="12,12,0,12"
                StrokeThickness="1"
                Stroke="{DynamicResource GlassCardStrokeColor}"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="Transparent">
            <Grid RowDefinitions="Auto,Auto,*">

                <!-- 兜底底色（Windows 真毛玻璃下透明；非 Windows 平台回退实色） -->
                <BoxView Grid.RowSpan="3"
                         Color="{OnPlatform WinUI=Transparent, Default={DynamicResource CardBackgroundStrongColor}}"
                         InputTransparent="True" />
                <!-- 真毛玻璃背景：捕获 MainArea 主内容区 → 模糊 → 叠着色。
                     侧栏玻璃下能看到主内容区左侧的模糊延伸，色调统一、有层次。 -->
                <vitrum:BlurConsumerView x:Name="_SidebarBlur" Grid.RowSpan="3" AlignToHostOrigin="True" ClipCornerRadius="16"
                                         TintColor="{DynamicResource GlassCardTintColor}" />

                <!-- App Logo -->
                <Grid x:Name="SidebarLogo" Grid.Row="0" Padding="18,14,18,12"
                      ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border WidthRequest="36" HeightRequest="36"
                            StrokeShape="RoundRectangle 11"
                            StrokeThickness="0"
                            Background="{DynamicResource HeroBrush}"
                            VerticalOptions="Center">
                        <Label Text="&#x1f43e;" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout x:Name="LogoText" Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[AppName]}"
                               FontSize="15.5" FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Text="CATCLAW MUSIC"
                               FontSize="9"
                               CharacterSpacing="2"
                               TextColor="{DynamicResource TextHintColor}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Navigation -->
                <VerticalStackLayout Grid.Row="1" Spacing="3" Padding="10,0">
                    <Label x:Name="NavHeader" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Navigation]}" FontSize="10"
                           TextColor="{DynamicResource TextHintColor}"
                           CharacterSpacing="2" Padding="10,6,10,4" />

                    <Border x:Name="NavDiscover" StrokeThickness="0"
                            StrokeShape="RoundRectangle 11"
                            Padding="12,9" BackgroundColor="Transparent">
                        <Border.Behaviors>
                            <controls:PressFeedbackBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavDiscoverTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                            <Image x:Name="NavDiscoverIcon" Source="{helpers:ThemedIcon Light=ic_home_light, Dark=ic_home}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label x:Name="NavDiscoverLabel" Grid.Column="1" Text="发现" FontSize="14"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border x:Name="NavPlaylists" StrokeThickness="0"
                            StrokeShape="RoundRectangle 11"
                            Padding="12,9" BackgroundColor="Transparent">
                        <Border.Behaviors>
                            <controls:PressFeedbackBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavPlaylistsTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                            <Image x:Name="NavPlaylistsIcon" Source="{helpers:ThemedIcon Light=ic_playlist_light, Dark=ic_playlist}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label x:Name="NavPlaylistsLabel" Grid.Column="1" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TabPlaylists]}" FontSize="14"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border x:Name="NavLibrary" StrokeThickness="0"
                            StrokeShape="RoundRectangle 11"
                            Padding="12,9" BackgroundColor="Transparent">
                        <Border.Behaviors>
                            <controls:PressFeedbackBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavLibraryTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                            <Image x:Name="NavLibraryIcon" Source="{helpers:ThemedIcon Light=ic_library_light, Dark=ic_library}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label x:Name="NavLibraryLabel" Grid.Column="1" Text="音乐库" FontSize="14"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- 我的歌单（可滚动） -->
                <VerticalStackLayout Grid.Row="2" Spacing="2" Padding="10,16,10,8">
                    <Grid ColumnDefinitions="*,Auto" Padding="10,2,8,6">
                        <Label x:Name="PlaylistHeader" Grid.Column="0" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[MyPlaylists]}" FontSize="10"
                               TextColor="{DynamicResource TextHintColor}"
                               CharacterSpacing="2" VerticalOptions="Center" />
                        <Border x:Name="AddPlaylistButton" Grid.Column="1"
                                WidthRequest="22" HeightRequest="22"
                                StrokeShape="RoundRectangle 6"
                                StrokeThickness="0"
                                BackgroundColor="{DynamicResource GlassCardButtonBgColor}">
                            <Label Text="＋" FontSize="15"
                                   TextColor="{DynamicResource TextSecondaryColor}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddPlaylistTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                    <ScrollView x:Name="PlaylistScroll">
                        <VerticalStackLayout x:Name="PlaylistHost" Spacing="2" />
                    </ScrollView>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ═══ 右列：顶栏 / 内容区 / 播放条浮层卡 ═══ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

            <!-- ═══ 顶栏：整行作原生拖动区（SetDragRectangles） ═══ -->
            <Grid x:Name="TopBar" Grid.Row="0" Padding="18,14,18,6">
                <Grid x:Name="TitleBarHost" HeightRequest="40" />
            </Grid>

            <!-- ═══ 主内容区占位（真实 MainArea 已移到根 Grid 最底层跨两列铺满）═══ -->
            <Grid Grid.Row="1" />

            <!-- ═══ 底部播放条浮层卡（仅右列宽，方案A晨雾框架）═══ -->
            <Border x:Name="PlayerArea" Grid.Row="2"
                    Margin="18,12,18,16"
                    StrokeThickness="1"
                    Stroke="{DynamicResource GlassCardStrokeColor}"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="Transparent">
                <Grid RowDefinitions="1,*">
                    <!-- 顶部细高光（模拟浮层卡 -1px 内高光） -->
                    <BoxView Grid.Row="0" HeightRequest="1"
                             Color="{DynamicResource GlassCardHighlightColor}" VerticalOptions="Start" />
                    <!-- Windows 无 Vitrum handler 时的兜底底色 -->
                    <BoxView Grid.Row="1"
                             Color="{OnPlatform WinUI=Transparent, Default={DynamicResource CardBackgroundStrongColor}}"
                             InputTransparent="True" />
                    <!-- 真毛玻璃背景：捕获 MainArea 主内容区 → 模糊 → 叠着色。
                         播放条玻璃下能看到下层主内容的模糊，色调与侧栏统一。 -->
                    <vitrum:BlurConsumerView x:Name="_PlayerBlur" Grid.Row="1" ClipCornerRadius="16"
                                             TintColor="{DynamicResource GlassCardTintColor}">
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="20,10,20,10" ColumnSpacing="18">

                            <!-- ① 左：封面 + 歌名/艺术家（空白点击 → 播放页覆盖层） -->
                            <Grid x:Name="PlayerInfoGrid" Grid.Column="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="12"
                                  VerticalOptions="Center" WidthRequest="220" MinimumWidthRequest="150">
                                <Border WidthRequest="52" HeightRequest="52"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        BackgroundColor="{DynamicResource SurfaceColor}">
                                    <Image x:Name="PlayerCover"
                                           Source="{Binding CoverImage}"
                                           Aspect="AspectFill"
                                           WidthRequest="52" HeightRequest="52" />
                                </Border>
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="3" VerticalOptions="Center">
                                    <Label Grid.Row="0" Text="{Binding Title}"
                                           FontSize="14.5" FontFamily="OpenSansSemibold"
                                           TextColor="{DynamicResource PlayerTitleColor}"
                                           MaxLines="1" LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="1" Text="{Binding Artist}"
                                           FontSize="11.5"
                                           TextColor="{DynamicResource PlayerSubColor}"
                                           MaxLines="1" LineBreakMode="TailTruncation" />
                                </Grid>
                                <!-- 透明按钮覆盖整个歌曲信息区，负责捕获点击 -->
                                <Button Grid.ColumnSpan="2"
                                        BackgroundColor="Transparent"
                                        Text=""
                                        BorderWidth="0"
                                        CornerRadius="0"
                                        Padding="0"
                                        Clicked="OnPlayerSongInfoTapped"
                                        HorizontalOptions="Fill" VerticalOptions="Fill" />
                            </Grid>

                            <!-- ② 中：控制组 + 其下进度行 -->
                            <Grid x:Name="PlayerControlsGrid" Grid.Column="1"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="4" VerticalOptions="Center"
                                  HorizontalOptions="Center" MinimumWidthRequest="320">
                                <!-- 控制组（模式 / 上一首 / 播放46热区 / 下一首 / 喜欢） -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="14" HorizontalOptions="Center">
                                    <Image Grid.Column="0" WidthRequest="20" HeightRequest="20"
                                           Aspect="AspectFit"
                                           Source="{Binding PlayModeIconSource}"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image.Behaviors>
                                            <controls:PressFeedbackBehavior />
                                        </Image.Behaviors>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CyclePlayModeCommand}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <Image Grid.Column="1" WidthRequest="22" HeightRequest="22"
                                           Aspect="AspectFit"
                                           Source="{Binding PlayPreviousIconSource}"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image.Behaviors>
                                            <controls:PressFeedbackBehavior />
                                        </Image.Behaviors>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding PlayPreviousCommand}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <!-- 主播放键：46×46 点击热区 + 24 图标 -->
                                    <Grid Grid.Column="2" WidthRequest="46" HeightRequest="46"
                                          HorizontalOptions="Center" VerticalOptions="Center">
                                        <Grid.Behaviors>
                                            <controls:PressFeedbackBehavior />
                                        </Grid.Behaviors>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding TogglePlayPauseCommand}" />
                                        </Grid.GestureRecognizers>
                                        <Image WidthRequest="26" HeightRequest="26"
                                               Aspect="AspectFit"
                                               Source="{Binding PlayPauseIconSource}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                    <Image Grid.Column="3" WidthRequest="22" HeightRequest="22"
                                           Aspect="AspectFit"
                                           Source="{Binding PlayNextIconSource}"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image.Behaviors>
                                            <controls:PressFeedbackBehavior />
                                        </Image.Behaviors>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding PlayNextCommand}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <Image Grid.Column="4" WidthRequest="20" HeightRequest="20"
                                           Aspect="AspectFit"
                                           Source="{Binding LikeIconSource}"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image.Behaviors>
                                            <controls:PressFeedbackBehavior />
                                        </Image.Behaviors>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleLikeCommand}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </Grid>
                                <!-- 进度行（时间 | 滑条 | 总时长） -->
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                                      WidthRequest="340" HorizontalOptions="Center">
                                    <Label Grid.Column="0" Text="{Binding CurrentTimeDisplay}"
                                           FontSize="10.5"
                                           TextColor="{DynamicResource PlayerSubColor}"
                                           WidthRequest="34" HorizontalTextAlignment="Center" />
                                    <Slider Grid.Column="1" x:Name="DesktopProgressSlider"
                                            Minimum="0"
                                            Maximum="{Binding Duration, Mode=OneWay}"
                                            Value="{Binding Progress, Mode=TwoWay}"
                                            ThumbColor="{DynamicResource PlayerSliderThumb}"
                                            MinimumTrackColor="{DynamicResource PlayerSliderProgress}"
                                            MaximumTrackColor="{DynamicResource PlayerSliderTrack}"
                                            HorizontalOptions="Fill" VerticalOptions="Center"
                                            HeightRequest="24"
                                            DragStarted="OnDesktopSliderDragStarted"
                                            DragCompleted="OnDesktopSliderDragCompleted" />
                                    <Label Grid.Column="2" Text="{Binding TotalTimeDisplay}"
                                           FontSize="10.5"
                                           TextColor="{DynamicResource PlayerSubColor}"
                                           WidthRequest="34" HorizontalTextAlignment="Center" />
                                </Grid>
                            </Grid>

                            <!-- ③ 右：音量图标 + 横向音量滑条 -->
                            <Grid x:Name="VolumeGrid" Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                  VerticalOptions="Center" WidthRequest="150" MinimumWidthRequest="110">
                                <Image Source="{helpers:ThemedIcon Name=ic_music_note, Original=True}" WidthRequest="18" HeightRequest="18"
                                       Opacity="0.7" VerticalOptions="Center" />
                                <Slider Grid.Column="1" x:Name="VolumeSlider"
                                        Minimum="0" Maximum="1"
                                        ThumbColor="{DynamicResource PlayerSliderThumb}"
                                        MinimumTrackColor="{DynamicResource PlayerSliderProgress}"
                                        MaximumTrackColor="{DynamicResource PlayerSliderTrack}"
                                        HorizontalOptions="Fill" MinimumWidthRequest="90"
                                        HeightRequest="24"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </vitrum:BlurConsumerView>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ 播放页覆盖层（全窗覆盖含侧栏/播放条——播放页不显示底部播放条）═══ -->
        <Grid x:Name="PlayerOverlay" Grid.ColumnSpan="2"
              IsVisible="False" BackgroundColor="Black">
            <!-- 内容由 code-behind 动态填充（NowPlayingPage 的 Content）；
                 关闭用播放页自带的收起按钮（WinCollapseBtn/CollapseButton，已 hook 到覆盖层关闭） -->
        </Grid>

    </Grid>
</ContentPage>
