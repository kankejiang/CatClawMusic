<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>CatClawMusic.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<ApplicationTitle>猫爪音乐</ApplicationTitle>
		<ApplicationId>com.catclaw.music</ApplicationId>
		<ApplicationDisplayVersion>1.8.8</ApplicationDisplayVersion>
			<ApplicationVersion>65</ApplicationVersion>

		<!-- Android 打包：禁用快速部署（Fast Deployment），Debug APK 也完整打包 .NET 程序集。
		     否则 VS 调试（F5）能启动（程序集靠 adb push 到设备 .override 目录），
		     但不挂调试器直接运行（桌面点图标 / Ctrl+F5 / APK 重装后启动）时
		     monodroid 报 "No assemblies found in .../.override ... Assuming this is part of Fast Deployment. Exiting"
		     然后 SIGABRT 闪退（见 dotnet/android#10708）。 -->
		<AndroidUseFastDeployment>false</AndroidUseFastDeployment>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<AndroidPackageFormats>apk</AndroidPackageFormats>
		<!-- 禁用热重载：Hot Reload 通过 FastDev 通道推送增量程序集，与 APK 构建时生成的 ACW
		     类型注册表不一致，导致 JNIEnv::RegisterNatives() returned -1（ShellItemRenderer 等）。
		     完整打包 + 禁热重载后 VS 调试部署的也是自洽的完整包。 -->
		<HotReloadEnabled>false</HotReloadEnabled>

		<!-- Windows-specific settings -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<!-- 手写 App.generated.cs（替代 XamlCompiler 生成的 App.g.i.cs 中的 Program/App，
		     绕 .NET 10 + WindowsAppSDK 1.7 的 XamlCompiler 退出码问题）。定义 DISABLE_XAML_GENERATED_MAIN
		     后 XamlCompiler 生成的 Program 部分被 #if 跳过，由手写版本提供，避免重复定义。
		     注意：宏必须仅 Release 定义——Debug 下 XamlCompiler 正常生成 App.g.i.cs（含 Main），
		     且 csproj 下方 Compile Remove 排除了手写文件；若宏在 Debug 也定义，两个入口点
		     都被裁剪，报 CS5001（程序不包含适合入口点的 Main）。 -->
		<DefineConstants Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<!-- XAML 编译器包装：Windows App SDK 1.7 的 XamlCompiler.exe 在 .NET 10 上
		     编译成功但退出码为 1（关闭时崩溃），用包装脚本检查 output.json 是否生成
		     来判断成功与否，绕过错误的退出码。 -->
		<XamlCompilerExePath Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(MSBuildProjectDirectory)\XamlCompilerWrapper.bat</XamlCompilerExePath>
		<!-- MakePri 包装：Windows App SDK 1.7 的 MakePri.exe 在 .NET 10 上生成 PRI 后崩溃
		     (E_UNEXPECTED)，用包装脚本检查输出文件是否生成来绕过错误退出码。 -->
		<MakePriExeFullPath Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(MSBuildProjectDirectory)\MakePriWrapper.bat</MakePriExeFullPath>

		<!-- Platform min versions -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">31.0</SupportedOSPlatformVersion>
		<TargetAndroidApi Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36</TargetAndroidApi>
		<!-- Release 拆分两个单 ABI 包：真机用 arm64，模拟器（x64）用 x86_64。
		     构建脚本各自传 -r android-arm64 / -r android-x64，AndroidSupportedAbis 由所选
		     RuntimeIdentifier 自动派生为单一 ABI，避免 FFmpeg 原生库在双 ABI 包里重复近 20MB。
		     Debug 的 AutoAndroidRid Target 仍会在遇到 x64 模拟器时把 RuntimeIdentifiers 覆盖为
		     android-x64，这里保留两个 RID 作为其候选集。 -->
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-x64</RuntimeIdentifiers>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- 运行时说明：.NET 11 Android 仅支持 CoreCLR（NETSDK1242 禁止 Mono）。CoreCLR Release 下
		     FixAbstractMethodsStep 修补 R2R 预编译 binding 程序集时会报 XALNS7015（dotnet/android#11025）。
		     CoreCLR targets 默认在 Release 打开 PublishReadyToRun（R2R 预编译），SDK 尚未修复该 bug，
		     故此处显式关闭 R2R，回退为纯 IL + 运行时 JIT，规避 XALNS7015。 -->
		<!-- Android release build settings -->
		<RunAOTCompilation Condition="'$(Configuration)' == 'Release'">false</RunAOTCompilation>
		<PublishReadyToRun Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</PublishReadyToRun>
		<!-- 插件系统依赖运行时动态加载（Assembly.Load 独立 .ccp 程序集）。
		     裁剪（trimmer）无法分析插件代码，会重写/移除插件引用的宿主类型，
		     导致安装插件时报"未找到有效的IPlugin实现"（typeref 解析失败）。
		     故关闭 Android Release 裁剪，保证所有类型完整保留。 -->
		<PublishTrimmed Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</PublishTrimmed>
		<TrimMode Condition="'$(Configuration)' == 'Release'">partial</TrimMode>

		<!-- Windows Release：不输出 .pdb/.xml 调试符号，减少发布目录文件数（不影响功能与多语言资源） -->
		<DebugType Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</DebugType>
		<DebugSymbols Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</DebugSymbols>
		<GenerateDocumentationFile Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- Debug 版本使用独立 ApplicationId，支持与 Release 共存 -->
	<PropertyGroup>
		<ApplicationId Condition="'$(Configuration)' == 'Debug'">com.catclaw.music.debug</ApplicationId>
		<ApplicationTitle Condition="'$(Configuration)' == 'Debug'">猫爪音乐(Debug)</ApplicationTitle>
	</PropertyGroup>

	<!-- AndroidX 传递依赖版本漂移（KTX 2.9.2.1 把 core 约束在 [2.9.2.1, 2.9.3)，
	     但 MAUI/ExoPlayer 的传递依赖要求 >= 2.10，二者无交集；NuGet 按最近优先解析到 2.10.0.2
	     触发良性 NU1608。解析版本更高、二进制向后兼容，无运行时风险，故抑制。
	     注意：勿加 TFM 条件——NuGet restore 阶段 $(TargetFramework) 尚未定义，条件会判定为 false 导致不生效。 -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);NU1608</NoWarn>
	</PropertyGroup>

	<!-- Shared project references -->
	<ItemGroup>
		<ProjectReference Include="..\CatClawMusic.Core\CatClawMusic.Core.csproj" />
		<ProjectReference Include="..\CatClawMusic.Data\CatClawMusic.Data.csproj" />
	</ItemGroup>

	<!-- Android-specific native lib (FFmpeg) -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidNativeLibrary Include="Assets\ffmpeg\arm64-v8a\libffmpeg.so" Abi="arm64-v8a" />
	</ItemGroup>

	<!-- MAUI resources -->
	<ItemGroup>
		<MauiIcon Include="Platforms\Android\Resources\mipmap-xxxhdpi\ic_launcher.png" />
		<MauiSplashScreen Include="Resources\Images\splash_transparent.svg" Color="#0B0D20" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- NuGet packages -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-preview.7.26381.103" />
		<PackageReference Include="MonoTorrent" Version="3.0.2" />
		<!-- Android 16（16KB 内存页）：sqlite-net-pcl 1.9.172 传递引入的 SQLitePCLRaw 2.1.2 中
		     libe_sqlite3.so 为 4KB 对齐，在三星 One UI 8.5/Android 16 等 16KB 页设备上 dlopen 失败
		     导致启动后（DB 初始化时）闪退。顶层锁定 2.1.11（16KB 对齐且数据库可正常打开，
		     注意 2.1.10 仅消除警告但 DB 仍打不开，见 ericsink/SQLitePCL.raw#621）。 -->
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
		<!-- Windows 歌词行高斯模糊（Win2D 提供 GaussianBlurEffect + Composition） -->
		<PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
	</ItemGroup>

	<!-- Android-specific: Media3 ExoPlayer -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.10.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Media3.Datasource" Version="1.10.1.1" />
		<!-- 原生 ViewPager2：Android 端用其承载 5 个 MAUI 页，水平分页位移由 GPU 合成，
		     根治 net10 下 TranslationX 手动画面导致的左右滑动抽搐 -->
		<PackageReference Include="Xamarin.AndroidX.ViewPager2" Version="1.1.0.11" />
		<!-- 显式引入 Browser 包：MAUI WebAuthenticator 内部生成 CustomTabsServiceConnectionImpl.java
		     等桩代码，依赖 androidx.browser.customtabs.*，但 SDK 不会自动传递该依赖 -->
		<PackageReference Include="Xamarin.AndroidX.Browser" Version="1.10.0.1" />
	</ItemGroup>

	<!-- Android release signing：必须显式 AndroidKeyStore=true，且用 PropertyGroup 属性（非 ItemGroup）。
	     密码兜底内置（与 build-release.ps1 / SIGNING.md 一致 catclaw123），
	     命令行 -p:CatClawKeyPass=xxx 可覆盖。 -->
	<PropertyGroup>
		<CatClawKeyPass Condition="'$(CatClawKeyPass)' == ''">catclaw123</CatClawKeyPass>
		<CatClawStorePass Condition="'$(CatClawStorePass)' == ''">catclaw123</CatClawStorePass>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>..\catclaw.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>catclaw</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>$(CatClawKeyPass)</AndroidSigningKeyPass>
		<AndroidSigningStorePass>$(CatClawStorePass)</AndroidSigningStorePass>
		<!-- 启动闪退修复：.NET 9/10 Android 的 JNI Marshal Methods（AndroidEnableMarshalMethods，
		     默认开启）在 Release 增量构建/多 ABI 场景下偶发 ACW 原生方法未注册，
		     表现为 java.lang.UnsatisfiedLinkError: No implementation found for
		     crc6488302ad6e9e4df1a.MauiApplication.n_onCreate()。显式关闭回退到传统
		     RegisterNatives 运行时注册路径。 -->
		<AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
	</PropertyGroup>

	<!-- 开发调试（Debug）：关闭 Fast Assembly Deployment，避免物理机部署时
	     FastDeploy 状态冲突导致的 ADB0010 NO_CERTIFICATES / "不支持运行以前的版本"。
	     改为完整签名 APK 正常安装，部署更稳。如需恢复快速增量部署，删除本段即可。
	     签名与 Release 使用同一 catclaw.keystore：Debug/Release 交替安装时
	     签名一致，避免 JNIEnv::RegisterNatives 冲突（否则需清缓存/卸载重装）。 -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidUseFastDeploy>false</AndroidUseFastDeploy>
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>..\catclaw.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>catclaw</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>$(CatClawKeyPass)</AndroidSigningKeyPass>
		<AndroidSigningStorePass>$(CatClawStorePass)</AndroidSigningStorePass>
	</PropertyGroup>

	<!-- Windows XAML 编译修复：XamlCompiler.exe 在 .NET 10 Release 模式下
	     output.json 的 GeneratedCodeFiles 为空（但 App.g.cs/App.g.i.cs 实际仍生成并
	     参与编译）。手写 App.generated.cs 只提供 Program 入口点兜底（DISABLE_XAML_GENERATED_MAIN），
	     App 的 InitializeComponent 由生成的 App.g.i.cs 提供。
	     - App.generated.cs 在 Debug 模式下排除（XAML编译器正常工作，避免重复入口点）；
	     - App.InitializeComponent.fallback.cs 默认排除，仅当 XamlCompiler 极端情况下
	       未产出 App.g.i.cs 时，由 EnsureAppInitializeComponent target 动态启用，
	       避免 CS0103（InitializeComponent 缺失）。 -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<Compile Remove="Platforms\Windows\App.generated.cs" Condition="'$(Configuration)' == 'Debug'" />
		<Compile Remove="Platforms\Windows\App.InitializeComponent.fallback.cs" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
	  <!-- WinUIEx：仅 Windows TFM（桌面歌词半透明 TransparentTintBackdrop；2.7.0 对齐 WinAppSDK 1.7，
	       2.8+ 需 WinUI 1.8 与 MAUI 10 冲突） -->
	  <PackageReference Include="WinUIEx" Version="2.9.3" />
	</ItemGroup>

	<Target Name="EnsureAppInitializeComponent" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ItemGroup>
			<Compile Include="Platforms\Windows\App.InitializeComponent.fallback.cs" Condition="!Exists('$(XamlGeneratedOutputPath)Platforms\Windows\App.g.i.cs') And !Exists('$(XamlGeneratedOutputPath)Platforms\Windows\App.g.cs')" />
		</ItemGroup>
	</Target>

	<!-- 自动识别调试目标设备 ABI（Debug + Android 专用）：
	     探测唯一在线设备，若为 x86_64 且开启 ARM 翻译层（ro.enable.native.bridge.exec=1，
	     如 MuMu 模拟器——其包管理器对双 ABI APK 强制把 primaryCpuAbi 定为 arm64-v8a 走
	     libnb/houdini 翻译执行，mono 调试器连不上宿主 vsdbg 会超时卡死并崩溃），
	     则本构建只打 android-x64，模拟器只能原生执行，F5 调试恢复；其余情况（真机 / 多设备 /
	     无设备 / adb 不可用）保持双 ABI（android-arm64;android-x64），ARM64 真机可正常调试。
	     探测由 AutoAndroidRid.ps1 完成，决策与上次不同时自动删除旧 APK 强制重新打包。
	     如需关闭自动识别：构建传 /p:DisableAutoAndroidRid=true 或删除本 Target。 -->
	<Target Name="AutoAndroidRid" BeforeTargets="_ResolveAndroidTooling" Condition="'$(Configuration)' == 'Debug' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(DesignTimeBuild)' != 'true' And '$(_ComputeFilesToPublishForRuntimeIdentifiers)' != 'true' And '$(DisableAutoAndroidRid)' != 'true'">
		<PropertyGroup>
			<_AutoAdbPath>$([MSBuild]::EnsureTrailingSlash('$(AndroidSdkDirectory)'))platform-tools\adb.exe</_AutoAdbPath>
		</PropertyGroup>
		<Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\AutoAndroidRid.ps1&quot; -AdbPath &quot;$(_AutoAdbPath)&quot; -DecisionFile &quot;$(IntermediateOutputPath)auto-rid.txt&quot; -ObjApkDir &quot;$(IntermediateOutputPath)android\bin&quot; -BinApkDir &quot;$(OutputPath)&quot;" ConsoleToMSBuild="true" />
		<ReadLinesFromFile File="$(IntermediateOutputPath)auto-rid.txt" Condition="Exists('$(IntermediateOutputPath)auto-rid.txt')">
			<Output TaskParameter="Lines" PropertyName="_AutoAndroidRidDecision" />
		</ReadLinesFromFile>
		<PropertyGroup Condition="'$(_AutoAndroidRidDecision)' == 'x64-only'">
			<RuntimeIdentifiers>android-x64</RuntimeIdentifiers>
		</PropertyGroup>
	</Target>

	<!-- Release 单 ABI 选择：build-release.ps1 传 -p:ReleaseAbi=arm64，build-x64.ps1 传
	     -p:ReleaseAbi=x64。与 AutoAndroidRid 同理，在项目局部把 RuntimeIdentifiers 覆盖为单个
	      RID，让 AndroidSupportedAbis 自动派生为单一 ABI（避免双 ABI 重复打包 FFmpeg 约 20MB），
	      且不级联到引用的 Core/Data 项目（命令行 -p:RuntimeIdentifiers 会级联导致 MSB3030）。
	     不传 ReleaseAbi 时维持默认双 RID。 -->
	<Target Name="SelectReleaseAbi" BeforeTargets="_ResolveAndroidTooling" Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(DesignTimeBuild)' != 'true' And '$(ReleaseAbi)' != ''">
		<PropertyGroup Condition="'$(ReleaseAbi)' == 'arm64'">
			<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
		</PropertyGroup>
		<PropertyGroup Condition="'$(ReleaseAbi)' == 'x64'">
			<RuntimeIdentifiers>android-x64</RuntimeIdentifiers>
		</PropertyGroup>
	</Target>

	<!-- 桌面歌词覆盖层（DesktopLyricOverlay）是 Windows 专属实现（Win32/Composition 半透明悬浮窗），
	     仅 Windows 目标编译；Android 桌面歌词走 WindowManager 悬浮窗（Platforms/Android/DesktopLyricService.cs）。
	     cs 端已 #if WINDOWS，这里把 XAML 一并排除，避免 Android 下 XamlC 找不到事件处理器报错。 -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
		<MauiXaml Remove="Pages\DesktopLyricOverlay.xaml" />
		<Compile Remove="Pages\DesktopLyricOverlay.xaml.cs" />
	</ItemGroup>

</Project>
