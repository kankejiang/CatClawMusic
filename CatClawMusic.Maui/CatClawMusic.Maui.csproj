<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>CatClawMusic.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>13.0</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<ApplicationTitle>猫爪音乐</ApplicationTitle>
		<ApplicationId>com.catclaw.music</ApplicationId>
		<ApplicationDisplayVersion>1.7.7</ApplicationDisplayVersion>
		<ApplicationVersion>53</ApplicationVersion>

		<!-- Windows-specific settings -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<EnableMsixTooling>true</EnableMsixTooling>
		<!-- XAML 编译器包装：Windows App SDK 1.7 的 XamlCompiler.exe 在 .NET 10 上
		     编译成功但退出码为 1（关闭时崩溃），用包装脚本检查 output.json 是否生成
		     来判断成功与否，绕过错误的退出码。 -->
		<XamlCompilerExePath Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(MSBuildProjectDirectory)\XamlCompilerWrapper.bat</XamlCompilerExePath>
		<!-- MakePri 包装：Windows App SDK 1.7 的 MakePri.exe 在 .NET 10 上生成 PRI 后崩溃
		     (E_UNEXPECTED)，用包装脚本检查输出文件是否生成来绕过错误退出码。 -->
		<MakePriExeFullPath Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(MSBuildProjectDirectory)\MakePriWrapper.bat</MakePriExeFullPath>

		<!-- Platform min versions -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">31.0</SupportedOSPlatformVersion>
		<TargetAndroidApi Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36</TargetAndroidApi>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-x64</RuntimeIdentifiers>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- 使用 Mono 运行时（.NET 10 Android 默认，CoreCLR 实验性且调试器有问题） -->
		<!-- Android release build settings -->
		<RunAOTCompilation Condition="'$(Configuration)' == 'Release'">false</RunAOTCompilation>
		<PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
		<TrimMode Condition="'$(Configuration)' == 'Release'">partial</TrimMode>

		<!-- Debug 版本使用独立 ApplicationId，支持与 Release 共存 -->
		<ApplicationId Condition="'$(Configuration)' == 'Debug'">com.catclaw.music.debug</ApplicationId>
		<ApplicationTitle Condition="'$(Configuration)' == 'Debug'">猫爪音乐(Debug)</ApplicationTitle>
	</PropertyGroup>

	<!-- AndroidX 传递依赖版本漂移（KTX 2.9.2.1 把 core 约束在 [2.9.2.1, 2.9.3)，
	     但 MAUI/ExoPlayer 的传递依赖要求 >= 2.10，二者无交集；NuGet 按最近优先解析到 2.10.0.2
	     触发良性 NU1608。解析版本更高、二进制向后兼容，无运行时风险，故抑制。
	     注意：勿加 TFM 条件——NuGet restore 阶段 $(TargetFramework) 尚未定义，条件会判定为 false 导致不生效。 -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);NU1608</NoWarn>
	</PropertyGroup>

	<!-- Shared project references -->
	<ItemGroup>
		<ProjectReference Include="..\CatClawMusic.Core\CatClawMusic.Core.csproj" />
		<ProjectReference Include="..\CatClawMusic.Data\CatClawMusic.Data.csproj" />
	</ItemGroup>

	<!-- Android-specific native lib (FFmpeg) -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidNativeLibrary Include="Assets\ffmpeg\arm64-v8a\libffmpeg.so" Abi="arm64-v8a" />
	</ItemGroup>

	<!-- MAUI resources -->
	<ItemGroup>
		<MauiIcon Include="Platforms\Android\Resources\mipmap-xxxhdpi\ic_launcher.png" />
		<MauiSplashScreen Include="Resources\Images\splash_transparent.svg" Color="#0B0D20" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Include="Resources\Images\Backgrounds\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- NuGet packages -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
		<!-- Android 16（16KB 内存页）：sqlite-net-pcl 1.9.172 传递引入的 SQLitePCLRaw 2.1.2 中
		     libe_sqlite3.so 为 4KB 对齐，在三星 One UI 8.5/Android 16 等 16KB 页设备上 dlopen 失败
		     导致启动后（DB 初始化时）闪退。顶层锁定 2.1.11（16KB 对齐且数据库可正常打开，
		     注意 2.1.10 仅消除警告但 DB 仍打不开，见 ericsink/SQLitePCL.raw#621）。 -->
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.11" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
	</ItemGroup>

	<!-- Android-specific: Media3 ExoPlayer -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.10.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Media3.Datasource" Version="1.10.1.1" />
		<!-- 原生 ViewPager2：Android 端用其承载 5 个 MAUI 页，水平分页位移由 GPU 合成，
		     根治 net10 下 TranslationX 手动画面导致的左右滑动抽搐 -->
		<PackageReference Include="Xamarin.AndroidX.ViewPager2" Version="1.1.0.10" />
		<!-- 显式引入 Browser 包：MAUI WebAuthenticator 内部生成 CustomTabsServiceConnectionImpl.java
		     等桩代码，依赖 androidx.browser.customtabs.*，但 SDK 不会自动传递该依赖 -->
		<PackageReference Include="Xamarin.AndroidX.Browser" Version="1.8.0.11" />
	</ItemGroup>

	<!-- Android release signing：必须显式 AndroidKeyStore=true，且用 PropertyGroup 属性（非 ItemGroup） -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>..\catclaw.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>catclaw</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>$(CatClawKeyPass)</AndroidSigningKeyPass>
		<AndroidSigningStorePass>$(CatClawStorePass)</AndroidSigningStorePass>
	</PropertyGroup>

	<!-- 开发调试（Debug）：关闭 Fast Assembly Deployment，避免物理机部署时
	     FastDeploy 状态冲突导致的 ADB0010 NO_CERTIFICATES / "不支持运行以前的版本"。
	     改为完整签名 APK 正常安装，部署更稳。如需恢复快速增量部署，删除本段即可。 -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidUseFastDeploy>false</AndroidUseFastDeploy>
	</PropertyGroup>

	<!-- Windows XAML 编译修复：XamlCompiler.exe 在 .NET 10 上编译成功但退出码为 1
	     （关闭崩溃），且 output.json 中 GeneratedCodeFiles 为空。
	     1. 用包装脚本绕过退出码问题
	     2. 用 AfterBuildFixXamlOutput target 修复 output.json 中缺失的 GeneratedCodeFiles -->
	<Target Name="FixXamlCompilerOutput" AfterTargets="MarkupCompilePass1"
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<!-- 扫描 obj 目录中的 .g.cs 和 .g.i.cs 文件并添加到 Compile -->
		<!-- .g.cs = 空的 partial 类声明；.g.i.cs = 含 InitializeComponent 和 Main 的实现 -->
		<ItemGroup>
			<GeneratedXamlCodeFiles Include="$(XamlGeneratedOutputPath)**\*.g.cs" />
			<GeneratedXamlCodeFiles Include="$(XamlGeneratedOutputPath)**\*.g.i.cs" />
			<Compile Include="@(GeneratedXamlCodeFiles)" />
		</ItemGroup>
	</Target>

</Project>
