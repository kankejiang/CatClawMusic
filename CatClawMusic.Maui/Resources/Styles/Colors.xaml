<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:CatClawMusic.Maui.Converters">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- CatClaw 动态主题资源键                          -->
    <!-- ThemeService 在运行时覆盖这些默认值               -->
    <!-- 页面通过 {DynamicResource Key} 引用               -->
    <!-- 默认值 = 樱粉奶油主题（萌系），ThemeService 启动即覆盖 -->
    <!-- ═══════════════════════════════════════════════ -->

    <!-- 主题色（默认樱粉 + 薄荷强调） -->
    <Color x:Key="PrimaryColor">#FF8FB8</Color>
    <Color x:Key="PrimaryLightColor">#FFD9E7</Color>
    <Color x:Key="PrimaryDarkColor">#F56FA0</Color>
    <Color x:Key="AccentColor">#7ED8C3</Color>
    <!-- 主操作按钮毛玻璃底（ThemeService 运行时按主题色覆盖为 55% 透明） -->
    <Color x:Key="PrimaryButtonBackgroundColor">#8CFF8FB8</Color>
    <!-- 玻璃按钮底（顶部卡片次级按钮，ThemeService 运行时覆盖） -->
    <Color x:Key="GlassButtonColor">#33FFFFFF</Color>
    <Color x:Key="LikeColor">#FF7AAE</Color>

    <!-- 页面背景与层次 — 墨蓝夜冷色基底 + 半透明毛玻璃卡片层次（默认深色；ThemeService 覆盖） -->
    <Color x:Key="WindowBackgroundColor">#12151F</Color>
    <Color x:Key="WindowBackgroundAltColor">#0FFFFFFF</Color>
    <Color x:Key="SurfaceColor">#14FFFFFF</Color>
    <Color x:Key="CardBackgroundColor">#1AFFFFFF</Color>
    <Color x:Key="CardBackgroundStrongColor">#2DFFFFFF</Color>
    <Color x:Key="InputBackgroundColor">#15FFFFFF</Color>
    <Color x:Key="InputBorderColor">#2BFFFFFF</Color>
    <!-- 歌曲列表行按压高亮叠加色（ThemeService 深浅模式下分别覆盖） -->
    <Color x:Key="RowPressOverlayColor">#22FFFFFF</Color>
    <Color x:Key="DividerColor">#1FFFFFFF</Color>
    <Color x:Key="GlassStrokeColor">#28FFFFFF</Color>
    <Color x:Key="GlassStrokeStrongColor">#4AFFFFFF</Color>
    <!-- 桌面浮层卡（侧栏/播放条）毛玻璃配色（ThemeService 深浅模式下分别覆盖） -->
    <Color x:Key="GlassCardTintColor">#B812151F</Color>
    <Color x:Key="GlassCardStrokeColor">#1AFFFFFF</Color>
    <Color x:Key="GlassCardHighlightColor">#21FFFFFF</Color>
    <Color x:Key="GlassCardButtonBgColor">#14FFFFFF</Color>
    <Color x:Key="ChipInactiveColor">#15FFFFFF</Color>
    <Color x:Key="ChipActiveColor">#55D6FF</Color>
    <Color x:Key="ChipInactiveTextColor">#C2C8E0</Color>
    <Color x:Key="ChipActiveTextColor">#FFFFFF</Color>
    <Color x:Key="BadgeBackgroundColor">#14FFFFFF</Color>
    <Color x:Key="BadgeStrokeColor">#28FFFFFF</Color>
    <Color x:Key="CardOverlayColor">#0AFFFFFF</Color>
    <Color x:Key="ButtonOverlayColor">#12FFFFFF</Color>
    <Color x:Key="ProgressTrackColor">#20FFFFFF</Color>

    <!-- 文本（深色冷调） -->
    <Color x:Key="TextPrimaryColor">#F5F7FF</Color>
    <Color x:Key="TextSecondaryColor">#C2C8E0</Color>
    <Color x:Key="TextHintColor">#8D93B7</Color>

    <!-- Shell / 控件 -->
    <Color x:Key="TabActiveColor">#F8EFF5</Color>
    <Color x:Key="TabInactiveColor">#9AA0B4</Color>
    <!-- 底部导航栏毛玻璃底：半透明白色叠加（ThemeService 运行时按深浅模式覆盖） -->
    <Color x:Key="TabBarBackgroundColor">#40FFFFFF</Color>
    <!-- 底部播放器条背景：浅色=纯白 / 深色=页面同底（ThemeService 运行时覆盖） -->
    <Color x:Key="PlayerBarBackgroundColor">#12151F</Color>
    <!-- 导航栏毛玻璃色调：深色压暗/浅色提亮（ThemeService 运行时覆盖）。
         必须在 XAML 中先定义，深浅色切换时 DynamicResource 才能实时刷新 -->
    <Color x:Key="TabBarGlassTint">#1C2230</Color>
    <x:Double x:Key="BottomBarTintOpacity">0.15</x:Double>
    <x:Double x:Key="BottomBarDimAmount">0</x:Double>
    <Color x:Key="BottomBarStrokeColor">#40FFFFFF</Color>

    <!-- 功能色（糖果系，保持） -->
    <Color x:Key="SuccessColor">#63D39E</Color>
    <Color x:Key="WarningColor">#FFBF67</Color>
    <Color x:Key="ErrorColor">#FF6E87</Color>

    <!-- 页面/装饰笔刷 -->
    <!-- 墨蓝夜冷色渐变（深色默认；ThemeService 在运行时根据主题色覆盖） -->
    <LinearGradientBrush x:Key="PageBackgroundBrush"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="#232838" Offset="0" />
        <GradientStop Color="#1C2230" Offset="0.3" />
        <GradientStop Color="#171B27" Offset="0.7" />
        <GradientStop Color="#252B3D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#7A55D6FF" Offset="0" />
        <GradientStop Color="#4D7ED8C3" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="PrimaryGlowBrush"
                         Center="0.5,0.5"
                         Radius="0.9">
        <GradientStop Color="#5555D6FF" Offset="0" />
        <GradientStop Color="#0055D6FF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="AccentGlowBrush"
                         Center="0.5,0.5"
                         Radius="0.9">
        <GradientStop Color="#3D7ED8C3" Offset="0" />
        <GradientStop Color="#007ED8C3" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="GlassHighlightBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#30FFFFFF" Offset="0" />
        <GradientStop Color="#05FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- 导航选中项主题色渐变高亮（方案A晨雾框架）：明色→暗色渐变胶囊，配深色文字/图标。
         GradientStop 用 DynamicResource 使 ThemeService 切换主题时每个色标实时刷新 -->
    <LinearGradientBrush x:Key="NavHighlightBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="{DynamicResource PrimaryLightColor}" Offset="0" />
        <GradientStop Color="{DynamicResource PrimaryDarkColor}" Offset="1" />
    </LinearGradientBrush>
    <!-- 导航选中项上的深色文字/图标（渐变高亮底较浅，深字对比清晰） -->
    <Color x:Key="NavHighlightTextColor">#0F0F14</Color>

    <!-- 自定义背景图片 -->
    <x:Boolean x:Key="CustomBackgroundEnabled">False</x:Boolean>
    <x:Double x:Key="CustomBackgroundOpacity">0.5</x:Double>
    <Color x:Key="CustomBackgroundMaskColor">#80000000</Color>

    <!-- 主题内置静态背景图（ThemeService 运行时覆盖；v1.7.8 起改为代码绘制的渐变/星空位图 ImageSource） -->
    <x:Boolean x:Key="ThemeBackgroundEnabled">False</x:Boolean>
    <!-- 背景图资源（ThemeService 运行时按主题/深浅色覆盖为代码绘制的 ImageSource，自定义背景时为自定义图）。
         必须在 XAML 中先定义，切换主题/深浅色时各页面的 DynamicResource 才能实时刷新背景 -->
    <x:Null x:Key="ThemeBackgroundImage" />

    <!-- 雾面动态背景开关（ThemeService 运行时覆盖）。
         必须在 XAML 中先定义，DynamicResource 才能订阅到运行时变更并实时刷新；
         若只在代码里 Add，播放页等已创建页面的绑定不会实时生效（需重启）。 -->
    <x:Boolean x:Key="FrostedBackgroundEnabled">True</x:Boolean>

    <!-- Converters -->
    <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    <converters:InvertedStringToBoolConverter x:Key="InvertedStringToBoolConverter" />
    <converters:TabTextColorConverter x:Key="TabTextColorConverter" />
    <converters:TabIndexToColorConverter x:Key="TabIndexToColorConverter" />
    <converters:TabIndexToTextColorConverter x:Key="TabIndexToTextColorConverter" />
    <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
    <converters:RoleToColorConverter x:Key="RoleToColorConverter" />
    <converters:IndexConverter x:Key="IndexConverter" />
    <converters:DurationConverter x:Key="DurationConverter" />
    <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
    <converters:SearchSectionHeightConverter x:Key="SearchSectionHeightConverter" />
    <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
    <converters:PlaylistIconConverter x:Key="PlaylistIconConverter" />
    <converters:DownloadStatusConverter x:Key="DownloadStatusConverter" />
    <converters:IsAssistantConverter x:Key="IsAssistantConverter" />
    <converters:IsUserConverter x:Key="IsUserConverter" />
    <converters:ChatBubbleColorConverter x:Key="ChatBubbleColorConverter" />
    <converters:ChatBubbleAlignmentConverter x:Key="ChatBubbleAlignmentConverter" />
    <converters:ChatBubbleTextColorConverter x:Key="ChatBubbleTextColorConverter" />
    <converters:LogLevelBackgroundConverter x:Key="LogLevelBackgroundConverter" />
    <converters:LogLevelForegroundConverter x:Key="LogLevelForegroundConverter" />
    <!-- 列表/网格项模板公共 Converter（全局注册，供 ContentView 组件和页面共用） -->
    <converters:InitialConverter x:Key="InitialConverter" />
    <converters:CoverArtConverter x:Key="CoverArtConverter" />
    <converters:PlaceholderColorConverter x:Key="PlaceholderColorConverter" />
    <converters:NameToLetterConverter x:Key="NameToLetterConverter" />
    <converters:PlaybackCountConverter x:Key="PlaybackCountConverter" />
</ResourceDictionary>


